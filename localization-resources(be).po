msgstr "Ваўчыны позірк"

#. [UA] "Збільшене вміння «Луки», «Списи» та підвищена проколювальна шкода."
#. [PL] "Zwiększona umiejętność łuku i włóczni oraz zwiększone obrażenia
#. kłute."
#. [RU] "Увеличивает навык стрельбы из лука и боя с копьем, а также
#. увеличивает колющий урон."
msgctxt "se_trinketsilverdamage_description"
msgid "Increased bow skill, spear skill, and increased pierce damage."
msgstr "Павялічвае ўменне стральбы з лука і бою з дзідай, і таксама колючае пашкоджанне."

#. [UA] "Кришталеве серце"
#. [PL] "Kryształowe Serce"
#. [RU] "Кристальное сердце"
msgctxt "se_trinketsilverresist"
msgid "Crystal Heart"
msgstr "Крыштальнае сэрца"

#. [UA] "Збільшений опір тупій, різальній і проколювальній шкоді."
#. [PL] "Zwiększona odporność przeciwko obuchowym, ciętym i kłutym
#. obrażeniom."
#. [RU] "Увеличивает сопротивление к дробящему, рассекающему и колющему
#. урону."
msgctxt "se_trinketsilverresist_description"
msgid "Increased resistance against blunt, slash and pierce damage."
msgstr "Павялічвае ўстойлівасць да драбільнага, сечанага і колючага пашкоджання."

#. [UA] "Під прикриттям"
#. [PL] "Ukrycie"
#. [RU] "Скрытный"
msgctxt "se_trollseteffect_name"
