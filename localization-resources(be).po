msgid "Cast: Echo Spike"
msgstr "Загатоўка: Рэхавы шып"

#. [UA] "Чарівний предмет потрібно загартувати морозом."
#. [PL] "Ten magiczny przedmiot należy zahartować mrozem."
#. [RU] "Этот магический предмет нужно закалить морозом."
#, fuzzy
msgctxt "item_staff_orbofahri_uncooked_description"
msgid "This magical item needs to be hardened with frost."
msgstr "Гэты магічны прадмет трэба загартаваць марозам."

#. [UA] "Духозов"
#. [PL] "Przywoływacz duchów"
#. [RU] "Призыватель духов"
