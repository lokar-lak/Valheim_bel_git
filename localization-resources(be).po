msgid "Makes you more sneaky."
msgstr "Робіць вас больш непрыкметнымі."

#. [UA] "Тривалість ефекту"
#. [PL] "Czas trwania efektu"
#. [RU] "Длительность эффекта"
msgctxt "se_ttl"
msgid "Effect duration"
msgstr "Працягласць эфекту"

#. [UA] "Тепло"
#. [PL] "Ciepło"
#. [RU] "Тепло"
