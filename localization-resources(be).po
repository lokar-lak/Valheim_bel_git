#. [PL] "Wpisz wiadomość"
#. [RU] "Введите сообщение"
msgctxt "keyboard_ChatInput"
msgid "Enter message"
msgstr "Напішыце паведамленне"

#. [UA] "Вкажіть фільтр"
#. [PL] "Wpisz filtr"
#. [RU] "Используйте фильтр"
