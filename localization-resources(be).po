#| msgctxt "piece_incinerator_conversion"
#| msgid "Thor bestows a gift upon you!"
msgctxt "fallen_viking_randomend_12"
msgid "The ancestors smile upon you."
msgstr ""

#. [UA] "Валькірія зробила правильний вибір."
#. [PL] "Walkirie dobrze wybrały."
#. [RU] "Валькирии сделали правильный выбор."
msgctxt "fallen_viking_randomend_13"
msgid "The Valkyries chose well."
msgstr ""

#. [UA] "Нарешті."
#. [PL] "W końcu."
#. [RU] "Наконец-то."
msgctxt "fallen_viking_randomend_14"
msgid "At long last."
msgstr ""

#. [UA] "Тепер я спочину."
#. [PL] "Teraz mogę spocząć."
#. [RU] "Теперь я могу отдохнуть."
msgctxt "fallen_viking_randomend_15"
msgid "Now I can rest."
msgstr ""

#. [UA] "Битва була гарною."
#. [PL] "Dobrze stoczona bitwa."
#. [RU] "Достойная битва."
msgctxt "fallen_viking_randomend_16"
msgid "A battle well fought."
msgstr ""

#. [UA] "Іди тепер. Благословляємо."
#. [PL] "Ruszaj z naszym błogosławieństwem."
#. [RU] "Теперь ступайте. Да прибудет с вами наше благословение."
msgctxt "fallen_viking_randomend_17"
msgid "Go now, with our blessing."
msgstr ""

#. [UA] "Відтепер ти б’єшся за нас усіх."
#. [PL] "Teraz walczysz za nas wszystkich."
#. [RU] "Теперь вы сражаетесь за всех нас."
msgctxt "fallen_viking_randomend_18"
msgid "You fight for all of us now."
msgstr ""

#. [UA] "Ми з цікавістю спостерігатимемо за твоїм поступом."
#. [PL] "Z zainteresowaniem będziemy śledzić twoje postępy."
#. [RU] "Мы будем с интересом наблюдать за вашими успехами."
msgctxt "fallen_viking_randomend_19"
msgid "We shall watch your progress with interest."
msgstr ""

#. [UA] "Тобі вдалося проявити себе."
#. [PL] "Udało ci się udowodnić swoją wartość."
#. [RU] "Вы доказали, что достойны."
#| msgctxt "npc_dvergr_ashlands_random_private_area_alarm3"
#| msgid "Keep your hands to yourself."
msgctxt "fallen_viking_randomend_2"
msgid "You have proven yourself."
msgstr ""

#. [UA] "У тебе хороші здібності."
#. [PL] "Zaiste, radzisz sobie."
#. [RU] "Вы и правда могучий воин."
#| msgctxt "tutorial_randomevent_topic"
#| msgid "You have been invaded"
msgctxt "fallen_viking_randomend_20"
msgid "You are capable indeed."
msgstr ""

#. [UA] "Дуже добрий бій."
#. [PL] "To było porządne starcie, wojowniku."
#. [RU] "Отличный поединок, воин."
#| msgctxt "tutorial_hildirdungeon_topic"
#| msgid "Watch your step, warrior."
msgctxt "fallen_viking_randomend_3"
msgid "Well fought, warrior."
msgstr ""

#. [UA] "І справді з чемпіонів."
#. [PL] "Prawdziwy czempion."
#. [RU] "Истинный чемпион."
msgctxt "fallen_viking_randomend_4"
msgid "A true champion."
msgstr ""

#. [UA] "Перемога тобі судилася."
#. [PL] "Przeznaczone jest ci zwycięstwo."
#. [RU] "Вы рождены быть победителем."
msgctxt "fallen_viking_randomend_5"
msgid "You are destined for victory."
msgstr ""

#. [UA] "Насправді гідний бій."
#. [PL] "To zaiste zacna bitwa."
#. [RU] "Воистину достойная битва."
msgctxt "fallen_viking_randomend_6"
msgid "A worthy battle indeed."
msgstr ""

#. [UA] "Це була честь для мене."
#. [PL] "To był zaszczyt."
#. [RU] "Для меня это честь."
#| msgctxt "item_trophy_seekerqueen_lore"
#| msgid "She has seen enough."
msgctxt "fallen_viking_randomend_7"
msgid "It has been an honour."
msgstr ""

#. [UA] "Добре билися."
#. [PL] "Dobrze walczysz."
#. [RU] "Вы хорошо сражались."
#| msgctxt "npc_haldor_random_buy5"
#| msgid "Use it well."
msgctxt "fallen_viking_randomend_8"
msgid "You fight well."
msgstr ""

#. [UA] "У тобі багато могуті."
#. [PL] "Potężny z ciebie wojownik."
#. [RU] "Вы могучий воин."
#| msgctxt "se_cold_stop"
#| msgid "You are getting warmer"
msgctxt "fallen_viking_randomend_9"
msgid "You are a mighty warrior."
msgstr ""

#. [UA] "Погляньмо, що ти можеш!"
#. [PL] "Zobaczmy, na co cię stać!"
#. [RU] "Посмотрим, на что вы способны!"
msgctxt "fallen_viking_randomstart_1"
msgid "Let us see what you are capable of!"
msgstr ""

#. [UA] "Хочеш позмагатися зі мною?"
#. [PL] "Chcesz rzucić mi wyzwanie?"
#. [RU] "Вы осмелились бросить мне вызов?"
msgctxt "fallen_viking_randomstart_10"
msgid "You seek to challenge me?"
msgstr ""

#. [UA] "О, саме цього ми всі й чекали!"
#. [PL] "Moje oczekiwanie nareszcie dobiegło końca!"
#. [RU] "Наконец-то пришел этот час!"
msgctxt "fallen_viking_randomstart_11"
msgid "Now this I have been waiting for!"
msgstr ""

#. [UA] "Бийся зі мною!"
#. [PL] "Stawaj do walki!"
#. [RU] "Тогда сражайтесь со мной!"
msgctxt "fallen_viking_randomstart_12"
msgid "Fight me then!"
msgstr ""

#. [UA] "Доведи свою міць!"
#. [PL] "Udowodnij swoją potęgę!"
#. [RU] "Докажите свою мощь!"
msgctxt "fallen_viking_randomstart_13"
msgid "Prove your might!"
msgstr ""

#. [UA] "Ти крові хочеш чи як?"
#. [PL] "Czy to krwi łakniesz?"
#. [RU] "Вы жаждете крови?"
#| msgctxt "npc_dvergrrogue_random_aggravated8"
#| msgid "So it's a fight you're after, then?"
msgctxt "fallen_viking_randomstart_14"
msgid "Is it blood that you are after?"
msgstr ""

#. [UA] "За перемогу!"
#. [PL] "Za zwycięstwo!"
#. [RU] "За победу!"
msgctxt "fallen_viking_randomstart_15"
msgid "For victory!"
msgstr ""

#. [UA] "Давай!"
#. [PL] "Ruszaj!"
#. [RU] "Ну же, вперед!"
#| msgctxt "hud_emotes_comehere"
#| msgid "Come here"
msgctxt "fallen_viking_randomstart_16"
msgid "Come on then!"
msgstr ""

#. [UA] "Битися хочеш?"
#. [PL] "Czy to walki łakniesz?"
#. [RU] "Не терпится сразиться?"
#| msgctxt "npc_dvergrrogue_random_aggravated8"
#| msgid "So it's a fight you're after, then?"
msgctxt "fallen_viking_randomstart_17"
msgid "Is it a fight you crave?"
msgstr ""

#. [UA] "Нарешті!"
#. [PL] "Nareszcie!"
#. [RU] "Наконец-то!"
msgctxt "fallen_viking_randomstart_18"
msgid "At last!"
msgstr ""

#. [UA] "Це дуель?"
#. [PL] "Stoczymy pojedynek?"
#. [RU] "Сразимся в поединке?"
msgctxt "fallen_viking_randomstart_19"
msgid "Shall we duel?"
msgstr ""

#. [UA] "Показуй усе, що можеш!"
#. [PL] "Pokaż, co potrafisz!"
#. [RU] "Покажите, на что вы способны!"
#| msgctxt "npc_haldor_sell04"
#| msgid "Show me what you have."
msgctxt "fallen_viking_randomstart_2"
msgid "Show me what you can do!"
msgstr ""

#. [UA] "Не соромся, бийся зі мною!"
#. [PL] "Nie wstydź się, walcz ze mną!"
#. [RU] "Хватит медлить, сражайтесь со мной!"
msgctxt "fallen_viking_randomstart_20"
msgid "Do not be shy, fight me!"
msgstr ""

#. [UA] "Доведи свою гідність!"
#. [PL] "Wykaż się!"
#. [RU] "Докажите свою силу!"
#| msgctxt "chat_kill"
#| msgid "Kill yourself"
msgctxt "fallen_viking_randomstart_3"
msgid "Prove yourself!"
msgstr ""

#. [UA] "У тебе є гідність?"
#. [PL] "Czy masz w sobie godność?"
#. [RU] "Вы считаете, что вы достойны?"
msgctxt "fallen_viking_randomstart_4"
msgid "Are you worthy?"
msgstr ""

#. [UA] "Покажи нам усім свою гідність!"
#. [PL] "Sprawdźmy, czy masz w sobie godność!"
#. [RU] "Посмотрим, достойны ли вы!"
msgctxt "fallen_viking_randomstart_5"
msgid "Let us see if you are worthy!"
msgstr ""

#. [UA] "Гадаєш, удасться впоратися зі мною?"
#. [PL] "Myślisz, że możesz mnie pokonać?"
#. [RU] "Думаете, сможете одолеть меня?"
msgctxt "fallen_viking_randomstart_6"
msgid "Do you think you can defeat me?"
msgstr ""

#. [UA] "Нехай тріумфують ліпші з ліпших!"
#. [PL] "Niech zwycięży najlepszy wojownik!"
#. [RU] "Пусть победит сильнейший воин!"
msgctxt "fallen_viking_randomstart_7"
msgid "May the best warrior triumph!"
msgstr ""

#. [UA] "Подивімося, хто з нас сильніше?"
#. [PL] "Sprawdzimy, kto jest najsilniejszy?"
#. [RU] "Выясним, кто из нас сильнее?"
msgctxt "fallen_viking_randomstart_8"
msgid "Shall we see who is the strongest?"
msgstr ""

#. [UA] "Нарешті мені кинули виклик!"
#. [PL] "Nareszcie godny konkurent!"
#. [RU] "Наконец-то достойный соперник!"
msgctxt "fallen_viking_randomstart_9"
msgid "Finally a challenger!"
msgstr ""

#. [UA] "Оце і є твій найліпший удар?"
#. [PL] "Tylko na tyle cię stać?"
#. [RU] "Это все, на что вы способны?"
msgctxt "fallen_viking_randomtaunt_1"
msgid "Is that the best you can do?"
msgstr ""

#. [UA] "Це якийсь жарт?"
#. [PL] "Czy to żart?"
#. [RU] "Это шутка?"
msgctxt "fallen_viking_randomtaunt_10"
msgid "Is this a jest?"
msgstr ""

#. [UA] "Оце й усе, що в тобі є?"
#. [PL] "Tylko tyle potrafisz?"
#. [RU] "И это все?"
#| msgctxt "npc_dvergrmage_random_greet4"
#| msgid "Is that a human?"
msgctxt "fallen_viking_randomtaunt_11"
msgid "Is that all you have?"
msgstr ""

#. [UA] "Що ще ти можеш?"
#. [PL] "Co jeszcze umiesz?"
#. [RU] "Что еще вы умеете?"
msgctxt "fallen_viking_randomtaunt_12"
msgid "What else can you do?"
msgstr ""

#. [UA] "Оце я називаю бій!"
#. [PL] "To jest dopiero walka!"
#. [RU] "Теперь это можно назвать поединком!"
msgctxt "fallen_viking_randomtaunt_13"
msgid "Now this is a fight!"
msgstr ""

#. [UA] "Нехай кров заливає землю!"
#. [PL] "Niech krew splami ziemię!"
#. [RU] "Пусть кровью окропится земля!"
msgctxt "fallen_viking_randomtaunt_14"
msgid "Let the blood stain the ground!"
msgstr ""

#. [UA] "Прояви ж себе! Ну ж бо!"
#. [PL] "Wykaż się! No, do dzieła!"
#. [RU] "Тогда докажите, на что способны! Ну же!"
msgctxt "fallen_viking_randomtaunt_15"
msgid "Prove yourself then! Do it!"
msgstr ""

#. [UA] "Бий зо всіх сил!"
#. [PL] "Uderz z cała swoją mocą!"
#. [RU] "Бейте изо всех сил!"
msgctxt "fallen_viking_randomtaunt_16"
msgid "Strike with all your might!"
msgstr ""

#. [UA] "Мені довелося бачити й лютіших за тебе!"
#. [PL] "Nawet myszy są zacieklejsze od ciebie!"
#. [RU] "Мне встречались даже мыши свирепее вас!"
msgctxt "fallen_viking_randomtaunt_17"
msgid "I have seen mice more ferocious than you!"
msgstr ""

#. [UA] "Стара ложка б’є болісніше за тебе!"
#. [PL] "Stara łyżka potrafiłaby przywalić mocniej niż ty!"
#. [RU] "Даже тупая ложка ранит сильнее, чем вы!"
msgctxt "fallen_viking_randomtaunt_18"
msgid "An old spoon could hit harder than you!"
msgstr ""

#. [UA] "Яке кумедне виправдання для чемпіонів!"
#. [PL] "Cóż za mierny przykład czempiona!"
#. [RU] "Какое жалкое оправдание для чемпиона!"
msgctxt "fallen_viking_randomtaunt_19"
msgid "What a puny excuse for a champion!"
msgstr ""

#. [UA] "Ну ж бо! Бийся зі мною!"
#. [PL] "No, dalej! Walcz ze mną!"
#. [RU] "Ну же! Сразитесь со мной!"
msgctxt "fallen_viking_randomtaunt_2"
msgid "Come on! Fight me then!"
msgstr ""

#. [UA] "Ти — це все, на що вони здатні?"
#. [PL] "Zdołali wysłać tylko ciebie?"
#. [RU] "Это все, на что они оказались способны?"
msgctxt "fallen_viking_randomtaunt_20"
msgid "Are you all they could muster?"
msgstr ""

#. [UA] "Вони нині дозволяють будь-кому брати зброю в руки!"
#. [PL] "W tych czasach każdemu pozwalają chwycić za broń!"
#. [RU] "Похоже, сейчас оружие выдают всем подряд!"
msgctxt "fallen_viking_randomtaunt_21"
msgid "They truly let anyone pick up a weapon these days!"
msgstr ""

#. [UA] "Не ганьби своїх пращурів!"
#. [PL] "Nie upokarzaj swoich przodków!"
#. [RU] "Не позорьте своих предков!"
msgctxt "fallen_viking_randomtaunt_22"
msgid "Do not humiliate your ancestors!"
msgstr ""

#. [UA] "Та дитя б’ється ліпше за тебе!"
#. [PL] "Nawet dziecko potrafi lepiej walczyć!"
#. [RU] "Даже ребенок сражался бы лучше!"
msgctxt "fallen_viking_randomtaunt_23"
msgid "A child could fight better!"
msgstr ""

#. [UA] "Ти взагалі хоч вікінгського роду?"
#. [PL] "Ty naprawdę jesteś wikingiem?"
#. [RU] "Вы вообще викинг?"
msgctxt "fallen_viking_randomtaunt_24"
msgid "Are you truly even a viking?"
msgstr ""

#. [UA] "Ну ж бо, там точно має бути ще щось!"
#. [PL] "No dalej, to chyba nie wszystko, na co cię stać!"
#. [RU] "Ну же! Неужели это все?"
msgctxt "fallen_viking_randomtaunt_25"
msgid "Come now, surely that is not all?"
msgstr ""

#. [UA] "Як жалюгідно! Ще раз!"
#. [PL] "Żałosne! Jeszcze raz!"
#. [RU] "Какая жалость! Опять!"
msgctxt "fallen_viking_randomtaunt_26"
msgid "Pathetic! Again!"
msgstr ""

#. [UA] "І це ти називаєш боєм?"
#. [PL] "Nazywasz to walką?"
#. [RU] "Вы называете это боем?"
msgctxt "fallen_viking_randomtaunt_27"
msgid "You call this fighting?"
msgstr ""

#. [UA] "І ти ще себе до чемпіонів зараховуєш?"
#. [PL] "I ty nazywasz siebie czempionem?"
#. [RU] "И вы называете себя чемпионом?"
msgctxt "fallen_viking_randomtaunt_28"
msgid "And you call yourself a champion?"
msgstr ""

#. [UA] "Невже тебе ніхто не вчив, як працювати ногами?"
#. [PL] "Nikt nigdy cię nie nauczył odpowiedniej pracy nóg?"
#. [RU] "Вас никто не учил, как правильно работать ногами?"
msgctxt "fallen_viking_randomtaunt_29"
msgid "Did no one ever teach you proper footwork?"
msgstr ""

#. [UA] "Та ти можеш ліпше!"
#. [PL] "Stać cię na więcej!"
#. [RU] "Вы способны на большее!"
#| msgctxt "npc_giveitem_no7"
#| msgid "You can do better than that."
msgctxt "fallen_viking_randomtaunt_3"
msgid "You can do better than that!"
msgstr ""

#. [UA] "Це точно та зброя, яку тобі хотілося взяти в бій?"
#. [PL] "Czy naprawdę chcesz użyć tej broni podczas tej walki?"
#. [RU] "Вы и правда пришли на бой с этим оружием?"
msgctxt "fallen_viking_randomtaunt_30"
msgid "Is that truly the weapon you will bring to this fight?"
msgstr ""

#. [UA] "Та сіролюдики набагато жвавіші за тебе!"
#. [PL] "Nawet szarzełki mają więcej finezji!"
#. [RU] "Даже у грейлинга больше ловкости, чем у вас!"
msgctxt "fallen_viking_randomtaunt_31"
msgid "A greyling has more finesse than you!"
msgstr ""

#. [UA] "А чи не помилилася валькірія, коли принесла тебе?"
#. [PL] "Czy walkirie myliły się co do ciebie?"
#. [RU] "Неужели валькирии ошиблись, выбрав вас?"
msgctxt "fallen_viking_randomtaunt_32"
msgid "Did the Valkyries make a mistake with you?"
msgstr ""

#. [UA] "Не варто стримуватися!"
#. [PL] "Nie powstrzymuj się!"
#. [RU] "Не сдерживайтесь!"
msgctxt "fallen_viking_randomtaunt_33"
msgid "Do not hold back!"
msgstr ""

#. [UA] "Чемпіони мають бити на смерть!"
#. [PL] "Czempion musi zawsze uderzać w cel!"
#. [RU] "Чемпион должен бить метко!"
msgctxt "fallen_viking_randomtaunt_34"
msgid "A champion must strike true!"
msgstr ""

#. [UA] "Тут нема місця слабкості!"
#. [PL] "Tu nie ma miejsca na słabość!"
#. [RU] "Здесь нет места слабости!"
msgctxt "fallen_viking_randomtaunt_35"
msgid "This is no place for weakness!"
msgstr ""

#. [UA] "Як довго довелося на це чекати!"
#. [PL] "Moje oczekiwanie trwało wieki!"
#. [RU] "Как же долго длилось мое ожидание!"
msgctxt "fallen_viking_randomtaunt_36"
msgid "Long have I waited for this!"
msgstr ""

#. [UA] "Хочеш, я тебе прикінчу?"
#. [PL] "Chcesz zginąć z mojej ręki?"
#. [RU] "Жаждете смерти от моей руки?"
msgctxt "fallen_viking_randomtaunt_37"
msgid "Do you wish for me to slay you?"
msgstr ""

#. [UA] "Я знаю, що ти можеш ліпше!"
#. [PL] "Wiem, że stać cię na więcej!"
#. [RU] "Я знаю, вы способны на большее!"
msgctxt "fallen_viking_randomtaunt_38"
msgid "I know you must be better than this!"
msgstr ""

#. [UA] "Твій шлях сюди не може бути марним!"
#. [PL] "Twoja podróż nie poszła na marne!"
#. [RU] "Вы прошли этот путь не зря!"
msgctxt "fallen_viking_randomtaunt_39"
msgid "You have not come all this way for nothing!"
msgstr ""

#. [UA] "Це ж ти зараз не на всю силу, так?"
#. [PL] "To chyba nie jest pełnia twoich sił?"
#. [RU] "Неужели это ваш предел?"
msgctxt "fallen_viking_randomtaunt_4"
msgid "Surely this is not your full power?"
msgstr ""

#. [UA] "Маєш стати єдиним цілим зі своєю зброєю!"
#. [PL] "Musisz stać się jednością ze swoją bronią!"
#. [RU] "Вы и ваше оружие должны быть единым организмом!"
msgctxt "fallen_viking_randomtaunt_40"
msgid "You must be one with your weapon!"
msgstr ""

#. [UA] "Оце й усе?"
#. [PL] "To wszystko?"
#. [RU] "И все?"
#| msgctxt "npc_dvergrmage_random_greet4"
#| msgid "Is that a human?"
msgctxt "fallen_viking_randomtaunt_5"
msgid "Is that all?"
msgstr ""

#. [UA] "Та в тобі має бути більше сили, аніж оце!"
#. [PL] "Z pewnością skrywasz większą siłę!"
#. [RU] "Вы должны быть сильнее!"
#| msgctxt "npc_giveitem_no7"
#| msgid "You can do better than that."
msgctxt "fallen_viking_randomtaunt_6"
msgid "You must be stronger than this!"
msgstr ""

#. [UA] "Хіба ти не маєш проявити гідність?"
#. [PL] "Tak ma wyglądać twoja wartość?"
#. [RU] "Вы считаете себя достойным воином?"
msgctxt "fallen_viking_randomtaunt_7"
msgid "Are you supposed to be worthy?"
msgstr ""

#. [UA] "Не ганьби нас!"
#. [PL] "Nie sprowadzaj na nas wstydu!"
#. [RU] "Не позорьте нас!"
msgctxt "fallen_viking_randomtaunt_8"
msgid "Do not shame us!"
msgstr ""

#. [UA] "Ти забуваєш про своє місце!"
#. [PL] "Zapominasz, gdzie twoje miejsce!"
#. [RU] "Вы забыли, где ваше место!"
#| msgctxt "tutorial_weight_topic"
#| msgid "You need to lighten your load!"
msgctxt "fallen_viking_randomtaunt_9"
msgid "You forget your place!"
msgstr ""

#. [UA] "{name} Вовчиця"
#. [PL] "{name} Wilczyca"
#. [RU] "{name} Волчица"
msgctxt "fallenwarrior_title100_f"
msgid "{name} the Wolf"
msgstr "{name} Ваўчыца"

#. [UA] "{name} Вовк"
#. [PL] "{name} Wilk"
#. [RU] "{name} Волк"
msgctxt "fallenwarrior_title100_m"
