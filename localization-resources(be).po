msgstr "Нутраны кут гонтавай страхі 26°"

#. [UA] "Ґонтовий дах із внутрішнім кутом під 45°"
#. [PL] "Dach z gontów ścięty do wewnątrz 45°"
#. [RU] "Внутренний угол шиферной крыши 45°"
msgctxt "piece_darkwoodrooficorner45"
msgid "Shingle Roof Inner Corner 45°"
msgstr "Нутраны кут гонтавага даху 45°"

#. [UA] "Ґонтовий дах із внутрішнім кутом під 67°"
#. [PL] "Dach z gontów ścięty do wewnątrz 67°"
#. [RU] "Внутренний угол шиферной крыши 67°"
#| msgctxt "piece_darkwoodrooficorner"
#| msgid "Shingle Roof Inner Corner 26°"
msgctxt "piece_darkwoodrooficorner67"
msgid "Shingle Roof Inner Corner 67°"
msgstr ""

