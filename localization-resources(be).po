#. [UA] "Іти"
#. [PL] "Idź"
#. [RU] "Идти"
msgctxt "msg_walk"
msgid "Walk"
msgstr "Ісці"

#. [UA] "Так не вийде"
#. [PL] "To nie zadziała"
#. [RU] "Так не получится"
msgctxt "msg_wontwork"
msgid "That won't work"
msgstr "Так не выйдзе"

#. [UA] "На сервері недостатньо місця на диску, щоби зберегти гру."
#. [PL] "Serwer nie ma wystarczająco miejsca na dysku, by zapisać grę."
#. [RU] "На сервере недостаточно места на диске, чтобы сохранить игру."
msgctxt "msg_worldsaveblockedonserver"
msgid "The server does not have enough space left on disk to save your game."
msgstr "На серверы бракуе месца на дыску, каб захаваць гульню."

#. [UA] "Збережено"
#. [PL] "Świat zapisany"
#. [RU] "Мир сохранен"
msgctxt "msg_worldsaved"
msgid "World saved"
msgstr "Сусвет захаваны"

#. [UA] "Хмарне сховище заповнене! Світ переміщено до місцевого сховища й
#. збережено"
#. [PL] "Chmura pełna! Świat został przeniesiony do pliku lokalnego i
#. zapisany"
#. [RU] "Облачное хранилище заполнено! Мир был сохранен и перемещен в
#. локальное хранилище"
msgctxt "msg_worldsavedcloudstoragefull"
msgid "Cloud storage full! World was moved to local storage and saved."
msgstr "Воблачнае сховішча запоўнена! Сусвет захаваны і перамешчаны ў лакальнае сховішча."

#. [UA] "Світ збережеться за"
#. [PL] "Zapis świata za"
#. [RU] "Сохранение мира через"
msgctxt "msg_worldsavewarning"
msgid "World save in"
msgstr "Захаванне сусвету праз"

#. [UA] "На сервері закінчується місце на диску. Подумайте над звільненням
#. місця, щоби мати можливість зберігати гру в майбутньому."
#. [PL] "Na serwerze zaczyna brakować miejsca na dysku. Rozważ zwolnienie
#. miejsca, by móc zapisywać w przyszłości."
#. [RU] "На сервере заканчивается место на диске. Рассмотрите возможность
#. очистки места, чтобы иметь возможность сэкономить в будущем."
msgctxt "msg_worldsavewarningonserver"
msgid "The server is running out of disk space, consider clearing up space to be able to save in the future."
msgstr "На серверы заканчваецца месца на дыску. Падумайце над вызваленнем месца, каб мець магчымасць захаваць гульню ў будучыні."

#. [UA] "Неможливо розмістити тут"
#. [PL] "Nie można umieścić w tym regionie"
#. [RU] "Невозможно расположить здесь, из-за неподходящей окружающей среды"
msgctxt "msg_wrongbiome"
msgid "Can't be placed in this environment"
msgstr "Нельга размясціць у гэтым асяроддзі"

#. [UA] "Хибний предмет"
#. [PL] "Niewłaściwy przedmiot"
#. [RU] "Неподходящий предмет"
msgctxt "msg_wrongitem"
msgid "Wrong item"
msgstr "Няправільны прадмет"

#. [UA] "Хибне знаряддя"
#. [PL] "Złe narzędzie"
#. [RU] "Неподходящий инструмент"
