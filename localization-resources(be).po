msgctxt "item_movement_modifier"
msgid "Movement speed"
msgstr "Хуткасць руху"

#. [UA] "Мухомор"
#. [PL] "Muchomor"
#. [RU] "Поганка"
msgctxt "item_mushroom_bzerker"
msgid "Toadstool"
msgstr "Мухамор"

#. [UA] "Дехто каже, що будь-що знайдене в лісі можна їсти. Але лише один раз,
#. якщо це цей гриб."
#. [PL] "Niektórzy twierdzą, że można jeść wszystko, co znajdzie się w lesie.
#. Nie dotyczy to jednak tego grzyba."
#. [RU] "Некоторые говорят, что все в лесу съедобное. К этому грибу это точно
#. не относится."
msgctxt "item_mushroom_bzerker_description"
msgid "Some say you can eat everything you find in the forest. That is not the case with this mushroom."
msgstr "Некаторыя кажуць, што ўсе лясныя дары ядомыя. Гэты грыб, аднак, пакаштаваць можна толькі раз у жыцці."

#. [UA] "Блакитний гриб"
#. [PL] "Borowik niebieski"
#. [RU] "Голубой гриб"
msgctxt "item_mushroomblue"
msgid "Blue Mushroom"
msgstr "Блакітны грыб"

#. [UA] "Випромінює м’яке блакитне світло."
#. [PL] "Świeci delikatną niebieską poświatą."
#. [RU] "Сияет нежно-голубым светом."
msgctxt "item_mushroomblue_description"
msgid "Glows with a soft blue hue."
msgstr "Свеціцца пяшчотна-блакітным святлом."

#. [UA] "Гриб"
#. [PL] "Podgrzybek"
#. [RU] "Гриб"
msgctxt "item_mushroomcommon"
msgid "Mushroom"
msgstr "Грыб"

#. [UA] "Лісовий скарб."
#. [PL] "Smaczny grzyb, dar lasu."
#. [RU] "Дар леса."
msgctxt "item_mushroomcommon_description"
msgid "Bounty of the forest."
msgstr "Дар лесу."

#. [UA] "Омлет із грибами"
#. [PL] "Omlet grzybowy"
#. [RU] "Омлет с грибами"
msgctxt "item_mushroomomelette"
msgid "Mushroom Omelette"
msgstr "Грыбны амлет"

#. [UA] "Смачний омлет із земляним післясмаком."
#. [PL] "Wyśmienity omlet z ziemistym posmakiem."
#. [RU] "Вкусный омлет с землистым послевкусием."
msgctxt "item_mushroomomelette_description"
msgid "A delicious omelette with an earthy aftertaste."
msgstr "Смачны амлет з земляным прысмакам."

#. [UA] "Жовтий гриб"
#. [PL] "Maślak żółty"
#. [RU] "Желтый гриб"
msgctxt "item_mushroomyellow"
msgid "Yellow Mushroom"
msgstr "Жоўты грыб"

#. [UA] "Цей гриб немов переповнений енергією."
#. [PL] "Silnie świecący grzyb."
#. [RU] "Ярко светящийся гриб."
msgctxt "item_mushroomyellow_description"
msgid "An energetic glowing mushroom."
msgstr "Яскравы і святлісты грыб."

#. [UA] "Хвіст водяника"
#. [PL] "Ogon niksy"
#. [RU] "Хвост никса"
msgctxt "item_necktail"
msgid "Neck Tail"
msgstr "Хвост нёка"

#. [UA] "Сирим неможливо прожувати, а от засмажений хвіст — чудова закуска."
#. [PL] "Surowy nie nadaje się do spożycia. Pieczony stanowi smakowitą
#. przekąskę."
#. [RU] "Несъедобен в сыром виде, но, если приготовить, будет довольно
#. неплохой закуской."
msgctxt "item_necktail_description"
msgid "Inedible when raw, but proves to be quite a tasty snack if cooked."
msgstr "Неядомы сырым, але пасля запякання аказваецца досыць смачнай перакускай."

#. [UA] "Засмажений хвіст водяника"
#. [PL] "pieczony ogon z niksy"
#. [RU] "Жареный хвост никса"
msgctxt "item_necktailgrilled"
msgid "Grilled Neck Tail"
msgstr "Печаны хвост нёка"

#. [UA] "Пікантне, смажене на вугіллі м’ясо віддає легким ароматом водоростей
#. і трави."
#. [PL] "To pikantne mięso upieczone na węglu drzewnym ma lekki aromat
#. wodorostów i trawy."
#. [RU] "Это пикантное мясо, приготовленное на углях, имеет аромат водорослей
#. и травы."
msgctxt "item_necktailgrilled_description"
msgid "This savoury, charcoal-grilled meat has a slight aroma of seaweed and grass."
msgstr "Гэта пікантнае, прыгатаванае на вуглях мяса мае лёгкі водар марскіх водарасцяў і травы."

#. [UA] "Жало"
#. [PL] "Igła"
#. [RU] "Игла"
msgctxt "item_needle"
msgid "Needle"
msgstr "Іголка"

#. [UA] "Гостре жало комара-смертевика."
#. [PL] "Ostra kłujka śmierciowada."
#. [RU] "Острое жало Смертожала."
msgctxt "item_needle_description"
msgid "The pointy end of a Deathsquito."
msgstr "Вострае жала смертапіўца."

#. [UA] "Нитка норни"
#. [PL] "Nić Norna"
#. [RU] "Нить Норн"
msgctxt "item_nornthread"
msgid "Nornathread"
msgstr "Ніць Норнаў"

#. [UA] "Нехай витонченість виробу не вводить в оману. Ці нитки сплетені з
#. могутності Світового Дерева."
#. [PL] "Niech cię nie zwiodą te delikatne włókna. Te nici zostały uprzędzone
#. z mocy samego drzewa świata."
#. [RU] "Не позволяйте этим хрупким нитям ввести вас в заблуждение. Они
#. сотканы из самой силы Мирового древа."
msgctxt "item_nornthread_description"
msgid "Don't let the delicate strands fool you. These threads are spun from the power of the world tree itself."
msgstr "Няхай далікатнасць не ўводзяць вас у зман. Яны спрадзены з самой сілы сусветнага дрэва."

#. [UA] "Прохід не відкриється, якщо тримаєте при собі"
#. [PL] "Nie można teleportować"
#. [RU] "Невозможно телепортировать"
msgctxt "item_noteleport"
msgid "Can't be teleported"
msgstr "Немагчыма тэлепартаваць"

#. [UA] "Жолуді"
#. [PL] "Żołędzie"
#. [RU] "Желуди"
msgctxt "item_oakseeds"
msgid "Acorns"
msgstr "Жалуды"

#. [UA] "Посадіть, щоби виростити дуб."
#. [PL] "Zasadź je, aby wyrósł z nich dąb."
#. [RU] "Посадите в землю, чтобы вырастить дуб."
msgctxt "item_oakseeds_description"
msgid "Plant them to grow an oak tree."
msgstr "Пасадзіце, каб з іх вырас дуб."

#. [UA] "Овес"
#. [PL] "Owies"
#. [RU] "Овсяная крупа"
msgctxt "item_oat"
msgid "Oats"
msgstr "Авёс"

#. [UA] "Смачне зерно, яке можна споживати як є або змолоти на борошно."
#. [PL] "Pyszne ziarna, które można wykorzystać w obecnej postaci lub zmielić
#. na mąkę."
#. [RU] "Вкусный злак, который можно использовать как есть или перемолоть в
#. муку."
msgctxt "item_oat_description"
msgid "Tasty grains, to be used as they are or to be ground into flour."
msgstr "Смачная збажына, які можна хоць так з’есці, хоць у муку змалоць."

#. [UA] "Вівсяне борошно"
#. [PL] "Mąka owsiana"
#. [RU] "Овсяная мука"
msgctxt "item_oatflour"
msgid "Oat Flour"
msgstr "Аўсяная мука"

#. [UA] "Дбайливо переселений овес має чималий потенціал застосування."
#. [PL] "Drobno zmielony owies posiadający mnóstwo potencjału."
#. [RU] "Мелко перемолотый овес, который можно использовать множеством
#. способов."
msgctxt "item_oatflour_description"
msgid "Finely ground oats, with plenty of potential."
msgstr "Дробна змолены авёс з вялікім патэнцыялам."

#. [UA] "Вівсянка"
#. [PL] "Owsianka"
#. [RU] "Овсянка"
msgctxt "item_oatmeallingonberryjam"
msgid "Oatmeal"
msgstr "Аўсянка"

#. [UA] "Смакує, якщо додати чималу порцію брусничного повидла."
#. [PL] "Serwowana z hojną porcją dżemu z czerwonych borówek."
#. [RU] "Подается с большой порцией брусничного варенья."
msgctxt "item_oatmeallingonberryjam_description"
msgid "Served with a generous helping of lingonberry jam."
msgstr "Падаецца са шчодрай порцыяй бруснічнага сочыва."

#. [UA] "Вівсяне молоко"
#. [PL] "Mleko owsiane"
#. [RU] "Овсяное молоко"
msgctxt "item_oatmilk"
msgid "Oat Milk"
msgstr "Аўсянае малако"

#. [UA] "Смак напоїв третьої хвилі."
#. [PL] "Smakuje jak innowacja."
#. [RU] "Вкус инноваций."
msgctxt "item_oatmilk_description"
msgid "Tastes like innovation."
msgstr "На смак — як вынаходніцтва."

#. [UA] "Насіння вівса"
#. [PL] "Nasiona owsa"
#. [RU] "Семена овса"
msgctxt "item_oatseeds"
msgid "Oat Seeds"
msgstr "Насенне аўса"

#. [UA] "Змеліть на борошно в млині або посадіть, щоб зібрати більший врожай."
#. [PL] "Zmiel je na płatki w młynie lub zasadź, aby wyhodować więcej nasion."
#. [RU] "Измельчите на мельнице, чтобы получить овсяную крупу, или посадите,
#. чтобы получить больше семян."
msgctxt "item_oatseeds_description"
msgid "Grind them to oats in the mill, or plant to grow more seeds."
msgstr "Змяліце іх на млыне або пасадзіце, каб вырасціць болей."

#. [UA] "Обсидіан"
#. [PL] "Obsydian"
#. [RU] "Обсидиан"
msgctxt "item_obsidian"
msgid "Obsidian"
msgstr "Абсідыян"

#. [UA] "Темне вулканічне скло."
#. [PL] "Ciemne szkło wulkaniczne."
#. [RU] "Темное вулканическое стекло."
msgctxt "item_obsidian_description"
msgid "Dark volcanic glass."
msgstr "Цёмнае вулканічнае шкло."

#. [UA] "В одну руку"
#. [PL] "Jednoręczny"
#. [RU] "Одноручное"
msgctxt "item_onehanded"
msgid "One-handed"
msgstr "У адну руку"

#. [UA] "Цибуля"
#. [PL] "Cebula"
#. [RU] "Лук"
msgctxt "item_onion"
msgid "Onion"
msgstr "Цыбуля"

#. [UA] "Хрустка й гостра."
#. [PL] "Chrupiąca o pikantnym smaku."
#. [RU] "Пикантный и хрустящий."
msgctxt "item_onion_description"
msgid "A crunchy and spicy taste."
msgstr "Хрумсткая і вострая на смак."

#. [UA] "Насіння цибулі"
#. [PL] "Nasiona cebuli"
#. [RU] "Семена лука"
msgctxt "item_onionseeds"
msgid "Onion Seeds"
msgstr "Насенне цыбулі"

#. [UA] "Посадіть, щоби виростити хорошу цибулю."
#. [PL] "Zasadź, aby wyrosła zdrowa cebula."
#. [RU] "Посадите в землю, чтобы вырастить лук, полезный для здоровья."
msgctxt "item_onionseeds_description"
msgid "Plant to grow a healthy onion."
msgstr "Пасадзіце, каб вырасціць карысную для здароўя цыбулю."

#. [UA] "Цибулевий суп"
#. [PL] "Zupa z cebuli"
#. [RU] "Луковый суп"
msgctxt "item_onionsoup"
msgid "Onion Soup"
msgstr "Цыбульны суп"

#. [UA] "Насичена смакота."
#. [PL] "Niezwykle pożywna."
#. [RU] "Изумительный насыщенный вкус."
msgctxt "item_onionsoup_description"
msgid "Deliciously rich."
msgstr "Пажыўная смаката."

#. [UA] "Твань"
#. [PL] "Śluz"
#. [RU] "Жижа"
msgctxt "item_ooze"
msgid "Ooze"
msgstr "Буза"

#. [UA] "Гниле й смердюче — воно точно вам потрібне?"
#. [PL] "Zgniły i cuchnący. Na co to komu?"
#. [RU] "Отвратительно воняет, а выглядит и того хуже. Зачем она вам вообще
#. нужна?"
msgctxt "item_ooze_description"
msgid "Rotten and putrid-smelling. Why do you want this?"
msgstr "Гнілая ды смярдзіць. Нашто яна вам?"

#. [UA] "Мертвий пульпак"
#. [PL] "Martwa pulpa"
#. [RU] "Мертвая масса"
#, fuzzy
msgctxt "item_ooze_mork"
msgid "Dead Pulp"
msgstr "Мёртвая мякаць"

#. [UA] "Ліпше не думати про його склад."
#. [PL] "Lepiej nie myśleć o tym, z czego się składa."
#. [RU] "Лучше не задумываться о ее происхождении."
msgctxt "item_ooze_mork_description"
msgid "It's best not to think about what this consists of."
msgstr "Пра тое, з чаго яно складаецца, лепш не думаць."

#. [UA] "Багниста бомба"
#. [PL] "Cieknąca bomba"
#. [RU] "Гнилостная бомба"
msgctxt "item_oozebomb"
msgid "Ooze Bomb"
msgstr "Глеістая бомба"

#. [UA] "Сморід просто нестерпний…"
#. [PL] "Smród nie do wytrzymania…"
#. [RU] "Невыносимо воняет…"
msgctxt "item_oozebomb_description"
msgid "The stench is unbearable..."
msgstr "Ейны смурод невыносны..."

#. [UA] "Вогнекрижна сутність"
#. [PL] "Mroźnognista esencja"
#. [RU] "Сущность льда и огня"
msgctxt "item_orbfrostfire"
msgid "Frostfire Essence"
msgstr "Эсэнцыя Агнялёду"

#. [UA] "Якимсь чином водночас холодне й гаряче на дотик."
#. [PL] "Jakimś cudem jest jednocześnie gorąca i zimna w dotyku."
#. [RU] "На ощупь одновременно и горячая, и холодная."
#, fuzzy
#| msgctxt "item_trophy_hatchling_description"
#| msgid "Still cold to the touch."
msgctxt "item_orbfrostfire_description"
msgid "Somehow both hot and cold to the touch."
msgstr "Нейкім чынам адначасова гарачы і халодны навобмацак."

#. [UA] "Громокровна сутність"
#. [PL] "Grzmotokrwista esencja"
#. [RU] "Сущность громовой крови"
#, fuzzy
#| msgctxt "item_thunderstone"
#| msgid "Thunder Stone"
msgctxt "item_orbthunderblood"
msgid "Thunderblood Essence"
msgstr "Эсэнцыя Громавай Крыві"

#. [UA] "Неврівноважене, непередбачуване і… живе?"
#. [PL] "Niestabilna, zmienna i... żywa?"
#. [RU] "Нестабильная, непредсказуемая и... живая?"
#, fuzzy
msgctxt "item_orbthunderblood_description"
msgid "Unstable, erratic and...alive?"
msgstr "Нестабільны, перарывісты і... жывы?"

#. [UA] "Запечена оладка"
#. [PL] "Naleśnik z piekarnika"
#. [RU] "Запеченный блин"
#, fuzzy
msgctxt "item_ovenpancake"
msgid "Oven Pancake"
msgstr "Печны блін"

#. [UA] "Теплі й пухнасті."
#. [PL] "Cieplutki i puszysty."
#. [RU] "Теплый и пышный."
msgctxt "item_ovenpancake_description"
msgid "Warm and fluffy."
msgstr "Цёплы і пульхны."

#. [UA] "Тісто для печених оладок"
#. [PL] "Ciasto na naleśniki z piekarnika"
#. [RU] "Тесто для запеченного блина"
#, fuzzy
msgctxt "item_ovenpancake_uncooked"
msgid "Oven Pancake Batter"
msgstr "Цеста для печнага бліна"

#. [UA] "Можна випікати."
#. [PL] "Czeka na upieczenie w piekarniku."
#. [RU] "Готово к запеканию."
#| msgctxt "item_breaddough_description"
#| msgid "Ready for the oven."
msgctxt "item_ovenpancake_uncooked_description"
msgid "Ready for the oven."
msgstr "Гатова да запякання."

#. [UA] "Оладки"
#. [PL] "Naleśniki"
#. [RU] "Блины"
msgctxt "item_pancakes"
msgid "Pancakes"
msgstr "Бліны"

#. [UA] "Чи є якась інша приємніша й затишніша їжа?"
#. [PL] "Czy jakiekolwiek inne jedzenie potrafi tak poprawić nastrój?"
#. [RU] "Разве существует еда, которая радовала бы больше?"
msgctxt "item_pancakes_description"
msgid "Was there ever a more comforting food?"
msgstr "Ці ёсць на свеце больш дамашняя страва?"

#. [UA] "Адреналін від відбиття"
#. [PL] "Adrenalina parowania"
#. [RU] "Адреналин при парировании"
msgctxt "item_parryadrenaline"
msgid "Parry adrenaline"
msgstr "Атрыманне адрэналіну пры парыраванні"

#. [UA] "Множник блоку за відбиття"
#. [PL] "Premia za parowanie"
#. [RU] "Бонус от парирования"
msgctxt "item_parrybonus"
msgid "Parry bonus"
msgstr "Бонус за парыраванне"

#. [UA] "частини"
#. [PL] "części"
#. [RU] "части"
msgctxt "item_parts"
msgid "parts"
msgstr "часткі"

#. [UA] "Ячмінь"
#. [PL] "Jęczmień"
#. [RU] "Ячмень"
msgctxt "item_pickable_barley"
msgid "Barley"
msgstr "Ячмень"

#. [UA] "Болотяне залізо"
#. [PL] "Żelazo bagienne"
#. [RU] "Болотная руда"
msgctxt "item_pickable_bogiron"
msgid "Bog Iron"
msgstr "Балотнае жалеза"

#. [UA] "Гілка"
#. [PL] "Gałąź"
#. [RU] "Ветка"
msgctxt "item_pickable_branch"
msgid "Branch"
msgstr "Галіна"

#. [UA] "Шерсть Фенріра"
#. [PL] "Sierść Fenrisa"
#. [RU] "Шерсть Фенриса"
msgctxt "item_pickable_hairstrands"
msgid "Fenris Hair"
msgstr "Поўсць Фэнрыра"

#. [UA] "Груда м’яса"
#. [PL] "Stos mięsa"
#. [RU] "Куча мяса"
msgctxt "item_pickable_meatpile"
msgid "Meat Pile"
msgstr "Груда мяса"

#. [UA] "Метеорит"
#. [PL] "Meteoryt"
#. [RU] "Метеорит"
msgctxt "item_pickable_meteorite"
msgid "Meteorite"
msgstr "Метэарыт"

#. [UA] "Обсидіан"
#. [PL] "Obsydian"
#. [RU] "Обсидиан"
msgctxt "item_pickable_obsidian"
msgid "Obsidian"
msgstr "Абсідыян"

#. [UA] "Рештки скелета"
#. [PL] "Szczątki kościotrupa"
#. [RU] "Останки скелета"
msgctxt "item_pickable_skeletalremains"
msgid "Skeletal Remains"
msgstr "Рэшткі шкілета"

#. [UA] "Шматок сірки"
#. [PL] "Siarkowa skała"
#. [RU] "Серный камень"
msgctxt "item_pickable_sulfurrock"
msgid "Sulfur Rock"
msgstr "Серкавы камень"

#. [UA] "Рогове кайло"
#. [PL] "Kilof z poroża"
#. [RU] "Кирка из оленьего рога"
msgctxt "item_pickaxe_antler"
msgid "Antler Pickaxe"
msgstr "Кірка з аленевага рога"

#. [UA] "Цим твердим знаряддям можна розбивати найнеподатливіші скелі."
#. [PL] "To narzędzie jest na tyle twarde, by rozbić nawet najbardziej
#. wytrzymałe skały."
#. [RU] "Достаточно крепкая, чтобы ломать даже самые твердые камни."
msgctxt "item_pickaxe_antler_description"
msgid "This tool is hard enough to crack even the most stubborn rocks."
msgstr "Снадзіва дастаткова цвёрдае, каб разбіць нават самыя ўпартыя камяні."

#. [UA] "Чорнометалеве кайло"
#. [PL] "Kilof z czarnego metalu"
#. [RU] "Кирка из черного металла"
msgctxt "item_pickaxe_blackmetal"
msgid "Black Metal Pickaxe"
msgstr "Кірка з чорнага металу"

#. [UA] "Якісне міцне вістря з лискучого темного металу."
#. [PL] "Dobry mocny kilof z lśniącego ciemnego metalu."
#. [RU] "Хорошая и крепкая кирка из блестящего темного металла."
msgctxt "item_pickaxe_blackmetal_description"
msgid "A good strong pick of glistening dark metal."
