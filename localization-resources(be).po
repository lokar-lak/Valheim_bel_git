msgid "Copper Stack"
msgstr ""

#. [UA] "Мідь вищого ґатунку. Немає на що скаржитися!"
#. [PL] "Miedź najwyższej jakości. Nie ma na co narzekać!"
#. [RU] "Медь высшего качества. Даже не к чему придраться!"
msgctxt "piece_copperbarstack_description"
msgid "Premium quality copper. Nothing to complain about!"
msgstr ""

