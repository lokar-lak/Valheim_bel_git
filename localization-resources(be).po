msgid "Spirit Caller"
msgstr "Заклінальнік Духаў"

#. [UA] "Прикличте потойбічну допомогу. Вам це вартуватиме лише краплину
#. крові…"
#. [PL] "Przywołaj pomoc z innego świata. Kosztuje tylko kroplę twej krwi..."
#. [RU] "Призывает потустороннюю помощь. Нужна всего лишь капля вашей
#. крови..."
#, fuzzy
msgctxt "item_staff_spiritcaller_description"
msgid "Summon otherworldly aid. It only costs a drop of your blood..."
msgstr "Пакліч дапамогу з іншага свету. Каштуе гэта толькі кроплі тваёй крыві..."

#. [UA] "Заготовина: Духозов"
#. [PL] "Odlew: przywoływacz duchów"
#. [RU] "Заготовка: призыватель духов"
#, fuzzy
msgctxt "item_staff_spiritcaller_uncooked"
msgid "Cast: Spirit Caller"
msgstr "Загатоўка: Заклінальнік Духаў"

#. [UA] "Чарівний предмет потрібно загартувати морозом."
#. [PL] "Ten magiczny przedmiot należy zahartować mrozem."
#. [RU] "Этот магический предмет нужно закалить морозом."
