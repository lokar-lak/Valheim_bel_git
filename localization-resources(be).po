#~ msgctxt "language_belarusian"
#~ msgid "Belarusian*"
#~ msgstr "Беларуская*"

#~ msgctxt "item_trophy_boar_lore"
#~ msgid "This boar head would make for a nice decoration in any house."
#~ msgstr "Гэтая галава дзіка стане выдатнай аздобай любога дома."

#~ msgctxt "item_trophy_neck_lore"
#~ msgid "The beady eyes and razorsharp teeth belies the ostensibly calm nature of this small lizard."
#~ msgstr "Вочы-пацеркі і вострыя як брытва зубы супярэчаць паказальна спакойнаму характару гэтай маленькай яшчаркі."

#~ msgctxt "item_trophy_deer_lore"
#~ msgid "A fine specimen but you'll need to kill more than deer to enter Valhalla."
#~ msgstr "Выдатная здабыча, але каб увайсці ў Вальхалу, вы мусіце забіць штосьці буйнейшае за аленя."

#~ msgctxt "item_trophy_greydwarf_lore"
#~ msgid "The mossy, severed head of a Greydwarf."
#~ msgstr "Замшэлая, адсечаная галава шэрага карлы."

#~ msgctxt "item_trophy_greydwarfbrute_lore"
#~ msgid "It took seven blows to hack this gnarled head from its body."
#~ msgstr "Спатрэбілася сем удараў, каб адсекчы ягоную гузаватую галаву ад цела."

#~ msgctxt "item_trophy_greydwarfshaman_lore"
#~ msgid "It may try to come back so be sure to prune any new shoots..."
#~ msgstr "Ён можа паспрабаваць адрадзіцца, таму не забывайцеся абразаць свежыя парасткі..."

#~ msgctxt "item_trophy_troll_lore"
#~ msgid "The leathery skin bears the faded tracery of ancient symbols."
#~ msgstr "Ягоная жорсткая скура мае ледзь заўважныя сляды старажытных сімвалаў."

#~ msgctxt "item_trophy_skeleton_lore"
#~ msgid "The expressionless grin of this skull reminds you of the inevitability of death."
#~ msgstr "Бяздушны вышчар гэтага чэрапа нагадвае пра немінучасць смерці."

#~ msgctxt "item_trophy_skeletonpoison_lore"
#~ msgid "A rank and rotten skull. You're not sure why you kept it..."
#~ msgstr "Смярдзючы гнілы чэрап. Вы не ведаеце, навошта ён вам здаўся..."

#~ msgctxt "item_trophy_wraith_lore"
#~ msgid "The shed skin of a wraith, a flowing robe only visible by moonlight."
#~ msgstr "Скінутая скура здані. Бязважкая адзежына, відная толькі пад месяцовым святлом."

#~ msgctxt "item_trophy_blob_lore"
#~ msgid "A smelly lump of sticky matter."
#~ msgstr "Смярдзючы камяк чагосьці ліпкага."

#~ msgctxt "item_trophy_draugr_lore"
#~ msgid "Bind up the mouth if it starts to whisper in the night..."
#~ msgstr "Калі пачне шаптаць уначы — завяжыце яму рот..."

#~ msgctxt "item_trophy_draugrelite_lore"
#~ msgid "The dead stare of the glowing red eyes sends a shiver through your bones."
#~ msgstr "Мёртвы позірк бліскучых чырвоных вачэй абуджае дрыжыкі ва ўсім целе."

#~ msgctxt "item_trophy_leech_lore"
#~ msgid "Although slimy, the skin is beautifully patterned in red and black."
#~ msgstr "Можа ейная скура і слізкая, затое прыгожа аздобленая чырвона-чорным узорам."

#~ msgctxt "item_trophy_wolf_lore"
#~ msgid "Frozen in death, the hair matted with blood and a silent howl lodged in its throat."
#~ msgstr "Калматая, акрываўленая поўсць назаўжды застыла на ягонай мысе. З разяўленай пашчы нібы вырываецца бязгучны вой."

#~ msgctxt "item_trophy_hatchling_lore"
#~ msgid "Still cold to the touch."
#~ msgstr "Усё яшчэ халодны навобмацак."

#~ msgctxt "item_trophy_sgolem_lore"
#~ msgid "This crystalline rock formation would make for an impressive floor decoration."
#~ msgstr "Гэтае крышталічнае скальнае ўтварэнне стала б уражвальнай аздобай падлогі."

#~ msgctxt "item_trophy_fenring_description"
#~ msgid "Half-way between wolf and man, its face frozen in a snarl of pain."
#~ msgstr "Твар гэтага паўчалавека-паўваўка застыў у грымасе болю."

#~ msgctxt "item_trophy_goblin_lore"
#~ msgid "Loose folds of greenish skin gathered in around a pair of dark and hateful eyes."
#~ msgstr "Вакол пары цёмных, поўных нянавісці вачэй абвіслі друзлыя складкі зеленаватай скуры."

#~ msgctxt "item_trophy_goblinbrute_lore"
#~ msgid "The huge grizzled head is as heavy as a boulder."
#~ msgstr "Гэтая вялізная сівая галава цяжкая, як валун."

#~ msgctxt "item_trophy_surtling_lore"
#~ msgid "Wreathed in pale flame, it still smolders like an ember."
#~ msgstr "Ахоплены блядым полымем, ён усё яшчэ тлее, нібы вугольчык."

#~ msgctxt "item_trophy_serpent_lore"
#~ msgid "The scales have dulled but the eyes are still bright."
#~ msgstr "Луска пацьмянела, але вочы ўсё яшчэ яркія."

#~ msgctxt "item_trophy_lox_lore"
#~ msgid "A giant beast's head, thatched with thick fur."
#~ msgstr "Галава гіганцкага звера, пакрытая густой поўсцю."

#~ msgctxt "item_trophy_deathsquito_lore"
#~ msgid "You don't like touching this thing even when it's dead."
#~ msgstr "Вам не падабаецца дакранацца да гэтай істоты, нават калі яна мёртвая."

#~ msgctxt "item_trophy_goblinshaman_description"
#~ msgid "Even killing it couldn't wipe the knowing smile from its crooked lips..."
#~ msgstr "Нават смерць не змагла сцерці абазнаную ўсмешку з ейных крывых вуснаў..."

#~ msgctxt "item_turnipseeds_description"
#~ msgid "These can be planted in cultivated soil."
#~ msgstr "Яго можна высаджваць ва ўзараную глебу."

#~ msgctxt "item_trophy_growth_lore"
#~ msgid "A black and sticky mess."
#~ msgstr "Чорнае і ліпкае месіва."

#~ msgctxt "item_trophy_abomination_description"
#~ msgid "It's been dead so long that it started living again."
#~ msgstr "Яно так доўга было мёртвым, што пачало нанова ажываць."

#~ msgctxt "item_trophy_ulv_lore"
#~ msgid "A rugged tail from a not so good boy."
#~ msgstr "Грубы хвост аднаго не вельмі добрага хлопчыка."

#~ msgctxt "item_trophy_cultist_description"
#~ msgid "The fire in its eyes has still not burned out."
#~ msgstr "Агонь у ягоных вачах усё яшчэ не згас."

#~ msgctxt "item_trophy_tick_lore"
#~ msgid "It's a conversation piece..."
#~ msgstr "Тут ёсць, пра што пагаварыць..."

#~ msgctxt "item_trophy_hare_lore"
#~ msgid "These are said to bring luck. But not for their original owner."
#~ msgstr "Кажуць, яны прыносяць удачу. Але відаць, не першаму свайму ўладальніку."

#~ msgctxt "item_trophy_seeker_lore"
#~ msgid "Less delicate than they look. The leather of the wings catches the firelight as if remembering flight."
#~ msgstr "Менш далікатныя, чым выглядаюць. Яны ловяць водбліскі агню, нібы ўспамінаючы былыя палёты."

#~ msgctxt "item_trophy_seeker_brute_lore"
#~ msgid "The head of a fallen champion."
#~ msgstr "Галава палеглага байца."

#~ msgctxt "item_trophy_gjall_lore"
#~ msgid "Hopefully it won't float away."
#~ msgstr "Спадзяюся, нікуды не ўляціць."

#~ msgctxt "item_bow_ashlands"
#~ msgid "Ashlands Bow"
#~ msgstr "Попельны лук"

#~ msgctxt "item_bow_ashlands_description"
#~ msgid "Forged through fire and flames."
#~ msgstr "Выкаваны ў агні і полымі."

#~ msgctxt "language_belarusian"
#~ msgid "Беларуская*"
#~ msgstr "Беларуская*"
