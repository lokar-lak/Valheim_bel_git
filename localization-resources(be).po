msgid "Cooking Station"
msgstr "Пожаг"

#. [UA] "Ідеальний варіант для запікання сирого м’яса."
#. [PL] "Idealny do pieczenia surowego mięsa."
#. [RU] "Отлично подходит для жарки сырого мяса."
#| msgctxt "item_roundlog_description"
#| msgid "Perfect for building log cabins."
msgctxt "piece_cookingstation_description"
msgid "Perfect for grilling raw meat."
