msgid "For more detailed work, multiple kinds of anvils can come in handy."
msgstr ""

#. [UA] "Шліфувальне колесо"
#. [PL] "Kamień szlifierski"
#. [RU] "Шлифовальный круг"
msgctxt "piece_forge_ext3"
msgid "Grinding Wheel"
msgstr "Шліфавальны круг"

#. [UA] "Шліфувальне колесо — обов’язковий елемент для гостріння будь-яких
#. клинків."
#. [PL] "Kamień szlifierski jest potrzebny do ostrzenia każdego rodzaju
#. miecza."
#. [RU] "Шлифовальный круг необходим для заточки любого меча."
msgctxt "piece_forge_ext3_description"
msgid "A grinding wheel is necessary for sharpening any kind of sword."
msgstr ""

#. [UA] "Ковадло коваля"
#. [PL] "Kowadło"
#. [RU] "Большая наковальня"
msgctxt "piece_forge_ext4"
msgid "Smith's Anvil"
msgstr "Вялікае кавадла"

#. [UA] "Велике ковадло для роботи з великими предметами. Упевніться, що воно
#. не звалиться вам на ноги."
#. [PL] "Wielkie kowadło do pracy nad wielkimi przedmiotami. Pilnuj, by nie
#. spadło ci na stopy."
#. [RU] "Большая наковальня нужна для работы с крупными предметами. Только не
#. уроните ее себе на ногу."
