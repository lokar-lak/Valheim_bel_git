msgctxt "item_legs_berserker_description"
msgid "It covers all the important bits, but not much else."
msgstr "Прыкрывае найважнейшае, але не болей."

#. [UA] "Дикокістяні лахи"
#. [PL] "Podły Kilt"
#. [RU] "Гнилокостный набедренник"
msgctxt "item_legs_berserker_undead"
msgid "Vilebone Drapes"
msgstr "Паганы кілт"

#. [UA] "Шматки товстої шкури та кісток сплетені у вигляді грубої спідниці."
#. [PL] "Grube skóry i fragmenty kości wszyte w surową spódnicę."
#. [RU] "Жуткая юбка, сотканная из толстых шкур и обломков костей."
msgctxt "item_legs_berserker_undead_description"
msgid "Thick hides and bone fragments woven into a rugged skirt."
msgstr "Тоўстыя шкуры і фрагменты костак, сплеценыя ў грубую спадніцу."

#. [UA] "Бронзові латні поножі"
#. [PL] "Nagolenice z brązu"
#. [RU] "Бронзовые наголенники"
msgctxt "item_legs_bronze"
msgid "Bronze Plate Leggings"
msgstr "Бронзавыя латныя нагавіцы"

#. [UA] "Бронзові наголінники захищають ноги."
#. [PL] "Nagolenniki z brązu chroniące nogi."
#. [RU] "Бронзовые наголенники для защиты ног."
msgctxt "item_legs_bronze_description"
msgid "Bronze greaves to shield your legs."
msgstr "Бронзавыя нагалёначнікі засцерагуць вашыя ногі."

#. [UA] "Хітинові поножі"
#. [PL] "Nagolennice z pancerza"
#. [RU] "Панцирные поножи"
msgctxt "item_legs_carapace"
msgid "Carapace Greaves"
msgstr "Хіцінавыя нагалёначнікі"

#. [UA] "Захист для ніг із жорсткого панцира."
#. [PL] "Ochraniacze nóg ze sztywnego pancerza."
#. [RU] "Поножи из жесткого панциря."
msgctxt "item_legs_carapace_description"
msgid "Leg guards of a rigid carapace."
msgstr "Вашы ногі пад абаронай дыхтоўнага панцыру."

#. [UA] "Штани Фенріра"
#. [PL] "Spodnie z Fenrisa"
#. [RU] "Поножи Фенриса"
msgctxt "item_legs_fenris"
msgid "Fenris Leggings"
msgstr "Нагавіцы Фэнрыра"

#. [UA] "Ноги звіра були жилавими й сильними, щоби робити великі стрибки."
#. [PL] "Nogi bestii były smukłe i silne, by mogła przeskakiwać wielkie
#. odległości."
#. [RU] "Ноги зверя были худыми и сильными, так что он мог делать большие
#. прыжки."
msgctxt "item_legs_fenris_description"
msgid "The legs of the beast were lean and strong, so that it could leap great strides."
msgstr "Ногі звера былі хударлявыя і моцныя, так што мог ён рабіць вялікія скачкі."

#. [UA] "Вогнеметалеві поножі"
#. [PL] "Nagolenniki z ogniometalu"
#. [RU] "Огнеметаллические поножи"
msgctxt "item_legs_flametal"
msgid "Flametal Greaves"
msgstr "Полыметалёвыя нагалёначнікі"

#. [UA] "Важкі штани дадуть захист від жару, а суцільні тверді поножі
#. захистять гомілки від підступних ударів знизу."
#. [PL] "Ciężkie spodnie chronią przed ciepłem, a solidne nagolenniki ochronią
#. golenie przed niskimi ciosami."
#. [RU] "Тяжелые штаны защищают от жара, а цельные поножи защищают голени от
#. низких ударов."
msgctxt "item_legs_flametal_description"
msgid "Heavy trousers insulate against the heat, while solid greaves keep your shins safe from low blows."
msgstr "Цяжкія штаны ўстойлівыя да жару, а трывалыя нагалёначнікі абароняць ногі ад падступных удараў."

#. [UA] "Обладунки потрібно загартувати морозом."
#. [PL] "Ten element zbroi należy zahartować mrozem."
#. [RU] "Этот предмет брони нужно закалить морозом."
msgctxt "item_legs_gold_uncooked_description"
msgid "This armour needs to be hardened with frost."
msgstr "Гэтую браню трэба загартоўваць марозам."

#. [UA] "Штани захисників"
#. [PL] "Spodnie obrońcy"
#. [RU] "Штаны защитника"
msgctxt "item_legs_heavy_deepnorth"
msgid "Trousers of the Protector"
msgstr "Порткі абаронцы"

#. [UA] "Товсте взуття й штани збережуть тепло, коли ви глибоко
#. провалюватиметеся у сніг."
#. [PL] "Ciężkie buty i spodnie, które zapewnią ci ciepło, gdy będziesz
#. przedzierać się przez głęboki śnieg."
#. [RU] "Тяжелые сапоги и штаны не дадут замерзнуть в глубоких снегах."
msgctxt "item_legs_heavy_deepnorth_description"
msgid "Heavy boots and trousers, to keep you warm as you trudge through deep snow."
msgstr "Цяжкія боты і порткі, каб было цёпла, пакуль тупаеш па глыбокім снегу."

#. [UA] "Заготовина: Штани захисників"
#. [PL] "Odlew: spodnie obrońcy"
#. [RU] "Заготовка: штаны защитника"
msgctxt "item_legs_heavy_gold_uncooked"
msgid "Cast: Trousers of the Protector"
msgstr "Загатоўка: Штаны абаронцы"

#. [UA] "Обладунки потрібно загартувати морозом."
#. [PL] "Ten element zbroi należy zahartować mrozem."
#. [RU] "Этот предмет брони нужно закалить морозом."
msgctxt "item_legs_heavy_gold_uncooked_description"
msgid "This armour needs to be hardened with frost."
msgstr "Гэтую браню трэба загартоўваць марозам."

#. [UA] "Залізні поножі"
#. [PL] "Żelazne nagolenniki"
#. [RU] "Железные наголенники"
msgctxt "item_legs_iron"
msgid "Iron Greaves"
msgstr "Жалезныя нагалёначнікі"

#. [UA] "Металеві наголінники захищають ноги."
#. [PL] "Żelazne nagolenniki chroniące nogi."
#. [RU] "Железные наголенники для защиты ног."
msgctxt "item_legs_iron_description"
msgid "Iron greaves to protect your legs."
msgstr "Жалезныя нагалёначнікі засцерагуць вашыя ногі."

#. [UA] "Шкіряні штани"
#. [PL] "Skórzane spodnie"
#. [RU] "Кожаные штаны"
msgctxt "item_legs_leather"
msgid "Leather Trousers"
msgstr "Скураныя штаны"

#. [UA] "Трохи скриплять під час ходи."
#. [PL] "Przy poruszaniu się lekko skrzypią."
#. [RU] "Немного скрипят при ходьбе."
msgctxt "item_legs_leather_description"
msgid "They squeak a little when you walk."
msgstr "Трохі рыпяць пры хадзе."

#. [UA] "Штани з бикоящурового хутра"
#. [PL] "Spodnie z futra loxa"
#. [RU] "Штаны из меха локса"
msgctxt "item_legs_lox"
msgid "Lox Fur Trousers"
msgstr "Порткі з футра быкаяшчара "

#. [UA] "М’які, тихі й гнучкі."
#. [PL] "Miękkie, ciche i giętkie."
#. [RU] "Мягкие, бесшумные и гибкие."
msgctxt "item_legs_lox_description"
msgid "Soft, silent and flexible."
msgstr "Мяккія, бясшумныя і гнуткія."

#. [UA] "Штани з ейтировим плетенням"
#. [PL] "Spodnie z Eitrosplotu"
#. [RU] "Сшитые из эйтра штаны"
msgctxt "item_legs_mage"
msgid "Eitr-weave Trousers"
msgstr "Штаны з эйтравалакна"

#. [UA] "Штани Ембли"
#. [PL] "Spodnie Embli"
#. [RU] "Штаны Эмблы"
msgctxt "item_legs_mage_ashlands"
msgid "Trousers of Embla"
msgstr "Эмбліны штаны"

#. [UA] "Достеменно невідомо, чи перша чаклунка насправді носила саме такі
#. штани."
#. [PL] "Nigdy się nie dowiemy, czy pierwsza czarodziejka naprawdę nosiła
#. takie spodnie."
#. [RU] "Носила ли первая колдунья такие штаны? Достоверно не известно."
msgctxt "item_legs_mage_ashlands_description"
msgid "Whether or not the first sorceress actually wore trousers exactly like these, we can never know."
msgstr "Ці сапраўды першая чараўніца насіла акурат такія штаны? Мы, імаверна, ніколі не дазнаемся."

#. [UA] "Штани заклиначів"
#. [PL] "Spodnie przywoływacza"
#. [RU] "Штаны призывателя"
msgctxt "item_legs_mage_deepnorth"
msgid "Trousers of the Caller"
msgstr "Порткі заклінальніка"

#. [UA] "Щільна тканина вбереже шкіру від укусів холоду."
#. [PL] "Dopasowane ocieplacze, dzięki którym zimno nie przeniknie ci przez
#. ubranie."
#. [RU] "Плотные обмотки, не дающие холоду коснуться вашей кожи."
#, fuzzy
msgctxt "item_legs_mage_deepnorth_description"
msgid "Tight legwraps to keep the cold from touching your skin."
msgstr "Шчыльныя абмоткі для ног, каб холад не кранаўся тваёй скуры."

#. [UA] "Штани, що носять чаклуни, завжди дуже тісні. Дискомфорт стимулює
#. зосередження, потрібне для чарів…"
#. [PL] "Te spodnie noszone przez magów są zawsze bardzo ciasne, Niewygoda
#. napędza skupienie, które jest wymagane przy magii..."
#. [RU] "Штаны, которые носят маги, всегда особенно узкие. Дискомфорт
#. подпитывает концентрацию, которая необходима для магии..."
msgctxt "item_legs_mage_description"
msgid "The trousers worn by mages are always especially tight. Discomfort fuels the focus that is needed for magic..."
msgstr "Чараўніковы штаны заўсёды асабліва цесныя. Дыскамфорт спрыяе канцэнтрацыі, неабходнай для чаравання..."

#. [UA] "Заготовина: Штани заклиначів"
#. [PL] "Odlew: spodnie przywoływacza"
#. [RU] "Заготовка: штаны призывателя"
msgctxt "item_legs_mage_gold_uncooked"
msgid "Cast: Trousers of the Caller"
msgstr "Загатоўка: Порткі заклінальніка"

#. [UA] "Обладунки потрібно загартувати морозом."
#. [PL] "Ten element zbroi należy zahartować mrozem."
#. [RU] "Этот предмет брони нужно закалить морозом."
msgctxt "item_legs_mage_gold_uncooked_description"
msgid "This armour needs to be hardened with frost."
msgstr "Гэтую браню трэба загартоўваць марозам."

#. [UA] "Штани Аска"
#. [PL] "Spodnie Aska"
#. [RU] "Штаны Аска"
msgctxt "item_legs_medium_ashlands"
msgid "Trousers of Ask"
msgstr "Аскавы штаны"

#. [UA] "Першій людині, що подорожувала Мідґардом, подобалась легкість руху.
#. Власники цих штанів могли б чогось навчитися з такої думки."
#. [PL] "Pierwszy wędrowiec Midgardu preferował lekki ubiór. Posiadacze tych
#. spodni mogliby się od niego wiele nauczyć."
#. [RU] "Первый человек в Мидгарде ходил осторожно. Всякий надевающий эти
#. штаны мог бы у него поучиться."
msgctxt "item_legs_medium_ashlands_description"
msgid "The first man to roam Midgard preferred to tread lightly. Wearers of these trousers could learn a thing or two from him."
msgstr "Першы чалавек Мідгарда лічыў за лепшае ступаць лёгка. Апрануўшы гэтыя штаны, чаму-нечаму ад яго навучышся."

#. [UA] "Штани авангарду"
#. [PL] "Spodnie awangardy"
#. [RU] "Штаны авангарда"
msgctxt "item_legs_medium_deepnorth"
msgid "Trousers of the Vanguard"
msgstr "Порткі авангарда"

#. [UA] "Теплі штани підійдуть для холодного клімату. Взуття має взірцеве
#. зчеплення зі слизькими поверхнями."
#. [PL] "Ciepłe spodnie odpowiednie na zimny klimat. Buty oferują wspaniałą
#. przyczepność do zlodowaciałego podłoża."
#. [RU] "Теплые штаны для холодных краев. Сапоги хорошо держат шаг на
#. обледенелой местности."
msgctxt "item_legs_medium_deepnorth_description"
msgid "Warm trousers suitable for a cold climate. The boots offer excellent grip in the icy terrain."
msgstr "Цёплыя штаны для халоднага клімату. Боты даюць выдатнае счапленне на лёдзе."

#. [UA] "Заготовина: Штани авангарду"
#. [PL] "Odlew: spodnie awangardy"
#. [RU] "Заготовка: штаны авангарда"
msgctxt "item_legs_medium_gold_uncooked"
msgid "Cast: Trousers of the Vanguard"
msgstr "Загатоўка: Порткі авангарда"

#. [UA] "Обладунки потрібно загартувати морозом."
#. [PL] "Ten element zbroi należy zahartować mrozem."
#. [RU] "Этот предмет брони нужно закалить морозом."
msgctxt "item_legs_medium_gold_uncooked_description"
msgid "This armour needs to be hardened with frost."
msgstr "Гэтую браню трэба загартоўваць марозам."

#. [UA] "Оббиті поножі"
#. [PL] "Wyściełane nagolenniki"
#. [RU] "Обитые наголенники"
msgctxt "item_legs_pgreaves"
msgid "Padded Greaves"
msgstr "Падшываныя нагалёначнікі"

#. [UA] "Майстерно викуваний захист для ніг."
#. [PL] "Precyzyjnie wykonany pancerz chroniący nogi."
#. [RU] "Искусно созданная защита для ног."
msgctxt "item_legs_pgreaves_description"
msgid "Expertly crafted leg protection."
msgstr "Майстэрскі вырабленая абарона для ног."

#. [UA] "Ряднинні штани"
#. [PL] "Szmaciane spodnie"
#. [RU] "Холщовые штаны"
msgctxt "item_legs_rags"
msgid "Rag Trousers"
msgstr "Анучныя штаны"

#. [UA] "Хай хоч сором прикривають."
#. [PL] "Proste odzienie na nagie ciało."
#. [RU] "Лучше в них, чем совсем без штанов."
msgctxt "item_legs_rags_description"
msgid "A simple remedy for nudity."
msgstr "Калі не хочацца хадзіць у чым маці нарадзіла."

#. [UA] "Кореневі штани"
#. [PL] "Korzenne spodnie"
#. [RU] "Корневые поножи"
msgctxt "item_legs_root"
msgid "Root Leggings"
msgstr "Каранёвыя нагавіцы"

#. [UA] "Легкі обладунки, дивним чином сплетені з прадавніх коренів та кори."
#. [PL] "Lekka zbroja osobliwie zszyta ze starożytnej kory i korzeni."
#. [RU] "Легкая броня, причудливо сотканная из древних корней и коры."
msgctxt "item_legs_root_description"
msgid "A light armour oddly woven together by ancient roots and bark."
msgstr "Лёгкі панцыр, дзіўна сплецены з старадаўніх каранёў і кары."

#. [UA] "Штани зі шкури троля"
#. [PL] "Spodnie ze skóry trolla"
#. [RU] "Штаны из кожи тролля"
msgctxt "item_legs_trollleather"
msgid "Troll Leather Trousers"
msgstr "Штаны з скуры троля"

#. [UA] "Штанці з цупкої шкури троля."
#. [PL] "Nagolenice z grubej skóry trolla."
#. [RU] "Штаны из прочной шкуры тролля."
msgctxt "item_legs_trollleather_description"
msgid "Leggings of tough troll hide."
msgstr "Нагавіцы з трывалай скуры троля."

#. [UA] "Вовчі поножі"
#. [PL] "Spodnie z wilka"
#. [RU] "Волчья защита для ног"
msgctxt "item_legs_wolf"
msgid "Wolf Hide Trousers"
msgstr "Штаны з воўчай шкуры"

#. [UA] "Кудлаті короткі штани з вовчої шкури."
#. [PL] "Kudłate bryczesy z wilczej skóry."
#. [RU] "Штаны из лохматой волчьей шкуры."
msgctxt "item_legs_wolf_description"
msgid "Shaggy breeches of wolfskin."
msgstr "Кудлатыя порткі з ваўчынай шкуры."

#. [UA] "Обмежує швидкість падіння."
#. [PL] "Ogranicza prędkość spadania"
#. [RU] "Снижает скорость падения"
msgctxt "item_limitfallspeed"
msgid "Limit fall speed"
msgstr "Абмяжоўвае хуткасць падзення"

#. [UA] "Лляна нитка"
#. [PL] "Lniana nić"
#. [RU] "Льняная нить"
msgctxt "item_linenthread"
msgid "Linen Thread"
msgstr "Ільняная нітка"

#. [UA] "Чудова лляна нитка з міцного лляного волокна."
#. [PL] "Cienka lniana nić wykonana z mocnego włókna lnianego."
#. [RU] "Тонкая нить из прочного льняного волокна."
msgctxt "item_linenthread_description"
msgid "A fine linen thread made out of a strong flax filament."
msgstr "Тонкая ільняная нітка з моцнага льнянога валакна."

#. [UA] "Брусниця"
#. [PL] "Czerwone borówki"
#. [RU] "Брусника"
msgctxt "item_lingonberries"
msgid "Lingonberries"
msgstr "Брусніцы"

#. [UA] "Терпкі ягоди, що можуть рости навіть у найхолоднішому кліматі."
#. [PL] "Te cierpkie jagody rosną nawet w zimnych klimatach."
#. [RU] "Эти терпкие ягоды могут расти даже в холодном климате."
msgctxt "item_lingonberries_description"
msgid "These tart berries can grow even in cold climates."
msgstr "Кіслыя ягады, якія растуць нават у халодным клімаце."

#. [UA] "Сік брусниці"
#. [PL] "Sok z czerwonych borówek"
#. [RU] "Брусничный сок"
msgctxt "item_lingondricka"
msgid "Lingonberry Juice"
msgstr "Бруснічны сок"

#. [UA] "Пасує майже всій їжі."
#. [PL] "Dobrze pasuje do większości dań."
#. [RU] "Хорошо сочетается с большинством блюд."
msgctxt "item_lingondricka_description"
msgid "Pairs well with most foods."
msgstr "Добра пасуе да большасці страў."

#. [UA] "М’ясо бикоящура"
#. [PL] "Mięso Lox'a"
#. [RU] "Мясо быкоящера"
msgctxt "item_loxmeat"
msgid "Lox Meat"
msgstr "Мяса быкаяшчара"

#. [UA] "Смажене м’ясо бикоящура"
#. [PL] "Pieczone mięso Lox'a"
#. [RU] "Приготовленное мясо быкоящера"
msgctxt "item_loxmeat_cooked"
msgid "Cooked Lox Meat"
msgstr "Печанае мяса быкаяшчара"

#. [UA] "Здоровецький кусень ніжнючого м’ясця, яким не гребуватимуть у самій
#. Вальгаллі!"
#. [PL] "Wyśmienity kawałek delikatnego mięsa, posiłek godny Walhalli!"
#. [RU] "Отличный кусок нежного мяса. Еда, достойная Вальгаллы!"
msgctxt "item_loxmeat_cooked_description"
msgid "A great hunk of tender meat, food fit for Valhalla!"
msgstr "Выдатны кавалак далікатнага мяса, годны бяседы ў Вальгале!"

#. [UA] "Шмат сирого м’яса з жировими прошарками."
#. [PL] "Płat surowego marmurkowego mięsa."
#. [RU] "Сырой кусок мраморного мяса."
msgctxt "item_loxmeat_description"
msgid "A raw slab of marbled meat."
msgstr "Сыры скрыль мармуровага мяса."

#. [UA] "Шкура бикоящура"
#. [PL] "Skóra Lox'a"
#. [RU] "Шкура быкоящера"
msgctxt "item_loxpelt"
msgid "Lox Pelt"
msgstr "Шкура быкаяшчара"

#. [UA] "Важка шкіра з товстим, затхлим хутром."
#. [PL] "Ciężka skóra z gęstym, zatęchłym futrem."
#. [RU] "Тяжелая затхлая шкура."
msgctxt "item_loxpelt_description"
msgid "A heavy pelt of thick, musty fur."
msgstr "Цяжкая шкура з густым, затхлым футрам."

#. [UA] "Бикоящуровий пиріг"
#. [PL] "Pasztecik z Lox'a"
#. [RU] "Пирог из мяса быкоящера"
msgctxt "item_loxpie"
msgid "Lox Meat Pie"
msgstr "Пірог з быкаяшчара"

#. [UA] "Розламайте скоринку, вдихніть цей незабутній аромат. Смакота!"
#. [PL] "Przebij skórkę, aby uwolnić chmurę aromatycznej pary. Palce lizać!"
#. [RU] "Отломите корочку, выпустив облако ароматного пара. Вкуснотища!"
msgctxt "item_loxpie_description"
msgid "Break the crust to release a cloud of fragrant steam. Delicious!"
msgstr "Адламіце скарыначку, каб знутры выйшла воблачка духмянай пары. Смачненька!"

#. [UA] "Сирий пиріг із бикоящура"
#. [PL] "Nieupieczony pasztecik z Loxa"
#. [RU] "Сырой пирог из быкоящера"
msgctxt "item_loxpie_uncooked"
msgid "Unbaked Lox Pie"
msgstr "Сыры пірог з быкаяшчара"

#. [UA] "Можна випікати."
#. [PL] "Można włożyć do pieca."
#. [RU] "Готов к запеканию."
msgctxt "item_loxpie_uncooked_description"
msgid "Ready for the oven."
msgstr "Гатова да запякання."

#. [UA] "Нордична дворучна кувалда"
#. [PL] "Nordycki młot"
#. [RU] "Нордская кувалда"
msgctxt "item_mace2h_gold"
msgid "Nord Sledge"
msgstr "Нардычная кувалда"

#. [UA] "Громокровна кувалда"
#. [PL] "Grzmotokrwisty młot"
#. [RU] "Кувалда громовой крови"
#, fuzzy
#| msgctxt "item_thunderstone"
#| msgid "Thunder Stone"
msgctxt "item_mace2h_gold_bloodlightning"
msgid "Thunderblood Sledge"
msgstr "Кувалда Громавай Крыві"

#. [UA] "Після влучання цієї зброї відлуння лунатиме по всьому світу…"
#. [PL] "Gdy ta broń trafia w swój cel, jej uderzenie odbija się echem po
#. całym świecie..."
#. [RU] "Когда это оружие попадает в цель, грохот разносится эхом по всему
#. миру..."
msgctxt "item_mace2h_gold_bloodlightning_description"
msgid "As this weapon strikes true, the blow shall echo throughout the world..."
msgstr "Калі зброя б'е у цэль, удару рэхам адгукаецца па ўсім свеце..."

#. [UA] "Заготовина: Громокровна кувалда"
#. [PL] "Odlew: grzmotokrwisty młot"
#. [RU] "Заготовка: кувалда громовой крови"
#, fuzzy
msgctxt "item_mace2h_gold_bloodlightning_uncooked"
msgid "Cast: Thunderblood Sledge"
msgstr "Загатоўка: Кувалда Громавай Крыві"

#. [UA] "Та сама форма, але результат буде набагато видовищнішим… З часом
#. мороз усе викаже."
#. [PL] "Ta sama forma, lecz może wydać coś o wiele bardziej
#. spektakularnego... Z biegiem czasu mróz wszystko ukaże."
#. [RU] "Хоть форма и осталась прежней, истинный потенциал стал куда более
#. впечатляющим... Со временем мороз раскрывает все, что скрыто."
msgctxt "item_mace2h_gold_bloodlightning_uncooked_description"
msgid "The same mould, yet inclined to yield a more spectacular result... The frost shall reveal all, in time."
msgstr "Тая ж форма, але здольная прынесці значна ашаламляльнейшы плён ... Мароз расставіць усё па месцах, свайго часу."

#. [UA] "Ударам цієї зброї позаздрив би й троль."
#. [PL] "Z tą bronią możesz zadawać ciosy potężne niczym troll."
#. [RU] "С этим оружием ваши удары будут тяжелы, как у самого тролля."
msgctxt "item_mace2h_gold_description"
msgid "With this weapon, your blows will be heavy as a troll's."
msgstr "З гэтай зброяй твае ўдары будуць цяжкія, нібы ў троля."

#. [UA] "Вогнекрижна кувалда"
#. [PL] "Mroźnognisty młot"
#. [RU] "Кувалда льда и огня"
#, fuzzy
#| msgctxt "item_sledge_iron"
#| msgid "Iron Sledge"
msgctxt "item_mace2h_gold_frostfire"
msgid "Frostfire Sledge"
msgstr "Кувалда Зімняга Полымя"

#. [UA] "Таке холодне, що аж пече, чи таке гаряче, що аж морозить?"
#. [PL] "Jest tak zimny, że aż pali, czy tak gorący, że aż mrozi?"
#. [RU] "Обжигает холодом или морозит огнем?"
#, fuzzy
msgctxt "item_mace2h_gold_frostfire_description"
msgid "Is it so cold that it's burning, or so hot that it's freezing?"
msgstr "Такі халодны, што аж пячэ, ці такі гарачы, што аж замарожвае?"

#. [UA] "Заготовина: Вогнекрижна кувалда"
#. [PL] "Odlew: mroźnognisty młot"
#. [RU] "Заготовка: кувалда льда и огня"
#, fuzzy
msgctxt "item_mace2h_gold_frostfire_uncooked"
msgid "Cast: Frostfire Sledge"
msgstr "Загатоўка: Кувалда Зімняга Полымя"

#. [UA] "Та сама форма, але результат буде набагато видовищнішим… З часом
#. мороз усе викаже."
#. [PL] "Ta sama forma, lecz może wydać coś o wiele bardziej
#. spektakularnego... Z biegiem czasu mróz wszystko ukaże."
#. [RU] "Хоть форма и осталась прежней, истинный потенциал стал куда более
#. впечатляющим... Со временем мороз раскрывает все, что скрыто."
msgctxt "item_mace2h_gold_frostfire_uncooked_description"
msgid "The same mould, yet inclined to yield a more spectacular result... The frost shall reveal all, in time."
msgstr "Тая ж форма, але здольная прынесці значна ашаламляльнейшы плён ... Мароз расставіць усё па месцах, свайго часу."

#. [UA] "Заготовина: Нордична дворучна кувалда"
#. [PL] "Odlew: nordycki młot"
#. [RU] "Заготовка: нордская кувалда"
msgctxt "item_mace2h_gold_uncooked"
msgid "Cast: Nord Sledge"
msgstr "Загатоўка: Нардычная кувалда"

#. [UA] "Зброю потрібно загартувати морозом."
#. [PL] "Tę broń należy zahartować mrozem."
#. [RU] "Это оружие нужно закалить морозом."
msgctxt "item_mace2h_gold_uncooked_description"
msgid "This weapon needs to be hardened with frost."
msgstr "Гэтую зброю трэба загартоўваць марозам."

#. [UA] "Бронзова булава"
#. [PL] "Buława z brązu"
#. [RU] "Бронзовая булава"
msgctxt "item_mace_bronze"
msgid "Bronze Mace"
msgstr "Бронзавая булава"

#. [UA] "Головний біль на паличці."
#. [PL] "Ból głowy osadzony na kiju."
#. [RU] "Одаривает болью в голове."
msgctxt "item_mace_bronze_description"
msgid "A headache on a stick."
msgstr "Галаўны боль на палачцы."

#. [UA] "Вогнеметалева булава"
#. [PL] "Buława z ogniometalu"
#. [RU] "Огнеметаллическая булава"
msgctxt "item_mace_eldner"
msgid "Flametal Mace"
msgstr "Полыметалёвая булава"

#. [UA] "Кривавник"
#. [PL] "Krwiobuch"
#. [RU] "Кровавая булава"
msgctxt "item_mace_eldner_blood"
msgid "Bloodgeon"
msgstr "Крывалава"

#. [UA] "Булава вбирає всю кров і завжди прагне додаткової порції."
#. [PL] "Krew wsiąka w pałkę, lecz ona łaknie więcej."
#. [RU] "Булава словно впитывает кровь и всегда жаждет больше."
msgctxt "item_mace_eldner_blood_description"
msgid "The blood all but soaks into this mace, and it always yearns for more."
msgstr "Булава нібы ўсмоктвае ўсю кроў навокал, і заўжды прагне дадатку."

#. [UA] "Ущільнене шиповане навершя з вогняного металу бездоганно підійде для
#. лупцювання ворожих пик."
#. [PL] "Ciężki, najeżony szpicami ogniometal, idealny do roztrzaskiwania
#. głów."
#. [RU] "Шипастый огнеметалл высокой плотности идеально подходит для крушения
#. вражеских голов."
msgctxt "item_mace_eldner_description"
msgid "Dense yet spiked flametal, perfect for bashing enemy faces in."
msgstr "Мае полыметалёвае наверша з прытупленымі шыпамі. Ідэальна пасуе для лупцавання варожых твараў."

#. [UA] "Громовик"
#. [PL] "Gwiazda burzy"
#. [RU] "Штормовая звезда"
msgctxt "item_mace_eldner_lightning"
msgid "Storm Star"
msgstr "Навальнічная зорка"

#. [UA] "Надзвичайно дієво, коли ранок хмарний."
#. [PL] "Szczególnie przydatna w chmurne poranki."
#. [RU] "Особенно хорошо работает в облачное утро."
msgctxt "item_mace_eldner_lightning_description"
msgid "Particularly effective on cloudy mornings."
msgstr "Асабліва эфектыўны пахмурнымі раніцамі."

#. [UA] "Цеглик"
#. [PL] "Klossen"
#. [RU] "Клоссен"
msgctxt "item_mace_eldner_nature"
msgid "Klossen"
msgstr "Клосэн"

#. [UA] "Якщо сили вашого удару недостатньо, щоби збити ворогів із ніг, то ці
#. первісні коріння зможуть утримати їх на місці."
#. [PL] "Jeśli wrogów nie powali czysta potęga twoich ciosów, być może pomogą
#. ci pierwotne korzenie."
#. [RU] "Если враг не упадет от силы удара, первобытные корни его обязательно
#. прижмут к земле."
msgctxt "item_mace_eldner_nature_description"
msgid "If the force of your blow isn't enough to knock your enemies to the ground, perhaps the primal roots will hold them down for you."
msgstr "Калі аднаго ўдару недастаткова, каб зваліць супраціўніка з ног, на помач прыйдуць першабытныя карані."

#. [UA] "Нордична булава"
#. [PL] "Nordycka buława"
#. [RU] "Нордская булава"
msgctxt "item_mace_gold"
msgid "Nord Mace"
msgstr "Нардычная булава"

#. [UA] "Громокровна булава"
#. [PL] "Grzmotokrwista buława"
#. [RU] "Булава громовой крови"
#, fuzzy
msgctxt "item_mace_gold_bloodlightning"
msgid "Thunderblood Mace"
msgstr "Булава Громавай Крыві"

#. [UA] "Зброя, з якою певно можна вийти навіть супроти бога грому…"
#. [PL] "Broń, która mogłaby rywalizować nawet z samym bogiem błyskawic..."
#. [RU] "Оружие, способное соперничать даже с молотом самого Тора..."
#, fuzzy
msgctxt "item_mace_gold_bloodlightning_description"
msgid "A weapon to rival perhaps even that of the thunder god himself..."
msgstr "Зброя, якая можа паспрачацца нават з той, што ў самога бога грому..."

#. [UA] "Заготовина: Громокровна булава"
#. [PL] "Odlew: grzmotokrwista buława"
#. [RU] "Заготовка: булава громовой крови"
#, fuzzy
msgctxt "item_mace_gold_bloodlightning_uncooked"
msgid "Cast: Thunderblood Mace"
msgstr "Загатоўка: Булава Громавай Крыві"

#. [UA] "Та сама форма, але результат буде набагато видовищнішим… З часом
#. мороз усе викаже."
#. [PL] "Ta sama forma, lecz może wydać coś o wiele bardziej
#. spektakularnego... Z biegiem czasu mróz wszystko ukaże."
#. [RU] "Хоть форма и осталась прежней, истинный потенциал стал куда более
#. впечатляющим... Со временем мороз раскрывает все, что скрыто."
msgctxt "item_mace_gold_bloodlightning_uncooked_description"
msgid "The same mould, yet inclined to yield a more spectacular result... The frost shall reveal all, in time."
msgstr "Тая ж форма, але здольная прынесці значна ашаламляльнейшы плён ... Мароз расставіць усё па месцах, свайго часу."

#. [UA] "Бийте швидко й болісно — не дайте ворогам і миті на відновлення."
#. [PL] "Uderzaj mocno i szybko, nie dając swojemu wrogowi czasu na dojście do
#. siebie."
#. [RU] "Бейте сильно и быстро, чтобы враг не успевал восстанавливаться."
#, fuzzy
msgctxt "item_mace_gold_description"
msgid "Hit hard and fast, and leave your foe no time to recover."
msgstr "Бі моцна і хутка, не пакідаючы ворагу часу на апамятанне."

#. [UA] "Вогнекрижна булава"
#. [PL] "Mroźnognista buława"
#. [RU] "Булава льда и огня"
#, fuzzy
#| msgctxt "skill_frostmagic"
#| msgid "Frost Magic"
msgctxt "item_mace_gold_frostfire"
msgid "Frostfire Mace"
msgstr "Булава Зімняга Полымя"

#. [UA] "Це іскри розлітаються, коли зброя влучає в ціль, чи крижинки?"
#. [PL] "Czy przy uderzeniu nią latają iskry, czy to odłamki lodu?"
#. [RU] "Это искры разлетаются при ударе или осколки льда?"
#, fuzzy
msgctxt "item_mace_gold_frostfire_description"
msgid "Are those sparks that fly as this weapon finds its impact, or are they shards of ice?"
msgstr "Гэта іскры ляцяць, калі зброя знаходзіць мэту, ці кавалкі лёду?"

#. [UA] "Заготовина: Вогнекрижна булава"
#. [PL] "Odlew: mroźnognista buława"
#. [RU] "Заготовка: Булава льда и огня"
msgctxt "item_mace_gold_frostfire_uncooked"
msgid "Cast: Frostfire Mace"
msgstr "Загатоўка: Булава агнялёду"

#. [UA] "Та сама форма, але результат буде набагато видовищнішим… З часом
#. мороз усе викаже."
#. [PL] "Ta sama forma, lecz może wydać coś o wiele bardziej
#. spektakularnego... Z biegiem czasu mróz wszystko ukaże."
#. [RU] "Хоть форма и осталась прежней, истинный потенциал стал куда более
#. впечатляющим... Со временем мороз раскрывает все, что скрыто."
msgctxt "item_mace_gold_frostfire_uncooked_description"
msgid "The same mould, yet inclined to yield a more spectacular result... The frost shall reveal all, in time."
msgstr "Тая ж форма, але здольная прынесці значна ашаламляльнейшы плён ... Мароз расставіць усё па месцах, свайго часу."

#. [UA] "Заготовина: Нордична булава"
#. [PL] "Odlew: nordycka buława"
#. [RU] "Заготовка: нордская булава"
#, fuzzy
msgctxt "item_mace_gold_uncooked"
msgid "Cast: Nord Mace"
msgstr "Загатоўка: Нардычная булава"

#. [UA] "Зброю потрібно загартувати морозом."
#. [PL] "Tę broń należy zahartować mrozem."
#. [RU] "Это оружие нужно закалить морозом."
msgctxt "item_mace_gold_uncooked_description"
msgid "This weapon needs to be hardened with frost."
msgstr "Гэтую зброю трэба загартоўваць марозам."

#. [UA] "Залізна булава"
#. [PL] "Żelazna buława"
#. [RU] "Железная булава"
msgctxt "item_mace_iron"
msgid "Iron Mace"
msgstr "Жалезная булава"

#. [UA] "Шматок заліза, розміром із кулак, на дерев’яному держаку."
#. [PL] "Żelazna bryła wielkości pięści na drewnianym trzonku."
#. [RU] "Кусок железа размером с кулак; имеет деревянную рукоять."
msgctxt "item_mace_iron_description"
msgid "A fist-sized lump of iron on a wooden shaft."
msgstr "Кавалак жалеза памерам з кулак на драўляным дзяржанні."

#. [UA] "Шипач"
#. [PL] "Jeżozwierz"
#. [RU] "Дикобраз"
msgctxt "item_mace_needle"
msgid "Porcupine"
msgstr "Іглак"

#. [UA] "Смертельна зброя, увінчана гострими шипами."
#. [PL] "Śmiertelna broń nabita diabelskimi kolcami."
#. [RU] "Смертоносное оружие, покрытое дьявольскими шипами."
msgctxt "item_mace_needle_description"
msgid "A deadly weapon, bristling with fiendish spikes."
msgstr "Смертаносная зброя, ашчаціненая д'ябальскімі шыпамі."

#. [UA] "Холодник"
#. [PL] "Mroziarz"
#. [RU] "Ледомор"
msgctxt "item_mace_silver"
msgid "Frostner"
msgstr "Сцюжнік"

#. [UA] "Мертві бояться срібла. Нагадайте їм чому."
#. [PL] "Martwi obawiają się srebra. Przypomnij im dlaczego."
#. [RU] "Мертвые боятся серебра. Напомните им, почему."
msgctxt "item_mace_silver_description"
msgid "The dead fear silver. Remind them why."
msgstr "Мёртвыя баяцца серабра. Нагадайце ім, чаму."

#. [UA] "Дерев’яна булава"
#. [PL] "Drewniana Buława"
#. [RU] "Деревянная булава"
msgctxt "item_mace_wood"
msgid "Wooden Mace"
msgstr "Драўляная булава"

#. [UA] "Цікаво, кому це здалося ліпшою вигадкою за звичайну палицю."
#. [PL] "Zastanawia, czemu ktoś stworzył to zamiast zwykłej pałki."
#. [RU] "Возникает вопрос, почему кто-то сделал именно это, а не простую
#. дубинку."
msgctxt "item_mace_wood_description"
msgid "One has to wonder why someone made this instead of a simple club."
msgstr "Трэба задацца пытаннем, чаму хтосьці зрабіў акурат гэта, а не простую дубіну."

#. [UA] "Чаклунський гриб"
#. [PL] "Magikubek"
#. [RU] "Волшебный гриб"
msgctxt "item_magecap"
msgid "Magecap"
msgstr "Падчароўнік"

#. [UA] "Тендітний синій гриб, насичений чаклунською життєвою силою."
#. [PL] "Delikatne niebieskie Magikubki strzelają jak zakończenia nerwowe z
#. czarodziejską witalnością."
#. [RU] "Нежные голубые магические шляпки потрескивают, словно нервные
#. окончания, полные волшебной жизненной силы."
msgctxt "item_magecap_description"
msgid "The delicate blue magecaps crackle like nerve-endings with sorcerous vitality."
msgstr "Далікатна-блакітныя шапачкі грыбоў патрэскваюць, напоўненыя чарадзейнай сілай, нібыта нервовыя канчаткі."

#. [UA] "Фарширований гриб"
#. [PL] "Grzyb nadziewany"
#. [RU] "Фаршированный гриб"
msgctxt "item_magicallystuffedmushroom"
msgid "Stuffed Mushroom"
msgstr "Фаршаваныя грыбы"

#. [UA] "Аж лускає від чарівного смаку."
#. [PL] "Aż pęka od smaku magii."
#. [RU] "С волшебным ароматом."
msgctxt "item_magicallystuffedmushroom_description"
msgid "Bursting with magical flavour."
msgstr "Амаль выбухае чароўным водарам."

#. [UA] "Сирий фарширований гриб"
#. [PL] "Nieupieczony grzyb nadziewany"
#. [RU] "Сырой фаршированный гриб"
msgctxt "item_magicallystuffedmushroomuncooked"
msgid "Uncooked Stuffed Mushroom"
msgstr "Сырыя фаршаваныя грыбы"

#. [UA] "Мандибула"
#. [PL] "Szczęka"
#. [RU] "Мандибула"
msgctxt "item_mandible"
msgid "Mandible"
msgstr "Мандыбула"

#. [UA] "Людська рука навряд чи могла придумати ідеальнішу зброю."
#. [PL] "Ręka ludzka nie mogłaby zaprojektować doskonalszej broni."
#. [RU] "Рука человека едва ли могла бы создать более совершенное оружие."
msgctxt "item_mandible_description"
msgid "The hand of man could hardly design a more perfect weapon."
msgstr "Чалавечая рука наўрад ці магла б стварыць больш дасканалую зброю."

#. [UA] "Мариновані овочі"
#. [PL] "Marynowane pędy"
#. [RU] "Маринованные овощи"
msgctxt "item_marinatedgreens"
msgid "Marinated Greens"
msgstr "Марынаваная гародніна"

#. [UA] "Гостреньке, ніжне, але треба жувати… Неймовірно божевільна страва
#. лоскоче язик і мізки."
#. [PL] "Pikantne, łykowate, słodkawe… To szalone danie jest wyzwaniem i dla
#. języka, i dla umysłu."
#. [RU] "Острые, тягучие, сладкие... Услада для языка и разума."
msgctxt "item_marinatedgreens_description"
msgid "It's spicy, it's chewy, it's sweet… This mad dish tickles your tongue as well as your mind."
msgstr "Вострая, салодкая, але доўга перажоўваецца... Вар'яцкая страва, якая казыча і язык, і глузды."

#. [UA] "Товчене м’ясо"
#. [PL] "Mięsna siekanka"
#. [RU] "Отбивное мясо"
msgctxt "item_mashedmeat"
msgid "Mashed Meat"
msgstr "Мясныя камы"

#. [UA] "М’ясні обрізки можуть бути доволі смачними, якщо їх добряче
#. розтовкти!"
#. [PL] "Z resztek mięsa można przyrządzić całkiem smaczny posiłek, wystarczy
#. je tylko odpowiednio posiekać!"
#. [RU] "Мясные обрезки можно сделать вкусными, если их как следует отбить!"
msgctxt "item_mashedmeat_description"
msgid "Leftover meat can actually be pretty tasty if you just mash it right!"
msgstr "Нават мясныя абрэзкі могуць быць вельмі смачнымі, калі іх правільна растаўчы!"

#. [UA] "Адреналін"
#. [PL] "Adrenalina"
#. [RU] "Адреналин"
msgctxt "item_maxadrenaline"
msgid "Adrenaline"
msgstr "Адрэналін"

#. [UA] "Протижальний збір"
#. [PL] "Mikstura przeciw użądleniom"
#. [RU] "Средство от смертожалов"
msgctxt "item_mead_bugrepellent"
msgid "Anti-Sting Concoction"
msgstr "Мікстура супраць укусаў"

#. [UA] "Ідеальний напій для будь-якого дня на рівнинах."
#. [PL] "Idealna na spacery po Równinach."
#. [RU] "Идеальный напиток для путешествия по равнинам."
msgctxt "item_mead_bugrepellent_description"
msgid "The perfect drink for a day in the Plains."
msgstr "Ідэальны напой для падарожжа па раўнінах."

#. [UA] "Берсеркова медовиця"
#. [PL] "Miód pitny berserków"
#. [RU] "Медовуха берсеркира"
msgctxt "item_mead_bzerker"
msgid "Berserkir Mead"
msgstr "Пітны мёд: берсерк"

#. [UA] "Щось надзвичайно отруйне замішане тут і настояне до стану, коли
#. потенціальну силу напою можна опанувати. Будьте обережні, випускаючи
#. звіра…"
#. [PL] "Coś trującego czai się wewnątrz, warzonego tak długo, by dało się
#. ujarzmić jego potencjał. Uważaj, by nie uwolnić bestii..."
#. [RU] "Над кружкой поднимается ядовитый парок, но после долгого
#. приготовления яд удалось обуздать. Будьте осторожны, впуская эту напасть в
#. себя."
msgctxt "item_mead_bzerker_description"
msgid "Something poisonous stirs within, brewed to the point where its potential can finally be harnessed. But be careful to let the beast out..."
msgstr "Тут намяшана нешта атрутнае, забрадзілае да такой ступені, што ягоны яд можна нарэшце ўтаймаваць. Але будзьце асцярожныя, як станеце выпускаць звера..."

#. [UA] "Тривка ейтирська медовиця"
#. [PL] "Miód pitny ciągłego Eitru"
#. [RU] "Мощная медовуха эйтра"
msgctxt "item_mead_eitr_lingering"
msgid "Lingering Eitr Mead"
msgstr "Стойкі пітны мёд: эйтр"

#. [UA] "Збільшує відновлення ейтиру."
#. [PL] "Zwiększa regenerację eitru."
#. [RU] "Увеличивает восстановление эйтра."
msgctxt "item_mead_eitr_lingering_description"
msgid "Increases eitr regeneration."
msgstr "Павялічвае аднаўленне эйтру."

#. [UA] "Слабка медовиця ейтиру"
#. [PL] "Miód pitny mniejszego Eitru"
#. [RU] "Малая медовуха эйтра"
msgctxt "item_mead_eitr_minor"
msgid "Minor Eitr Mead"
msgstr "Малы пітны мёд: эйтр"

#. [UA] "Відновлює ейтир."
#. [PL] "Przywraca Eitr."
#. [RU] "Восстанавливает эйтр."
msgctxt "item_mead_eitr_minor_description"
msgid "Restores eitr."
msgstr "Аднаўляе эйтр."

#. [UA] "Медовиця опору морозу"
#. [PL] "Miód pitny mrozoodporności"
#. [RU] "Морозоустойчивая медовуха"
msgctxt "item_mead_frostres"
msgid "Frost Resistance Mead"
msgstr "Пітны мёд: марозаўстойлівасць"

#. [UA] "Зігріває в лютий холод."
#. [PL] "Sprawia cię odpornym na mróz i zamarzanie."
#. [RU] "Защищает от холода."
msgctxt "item_mead_frostres_description"
msgid "Protects against the cold."
msgstr "Ахоўвае ад холаду."

#. [UA] "Рататосковий тонік"
#. [PL] "Tonik Ratatoska"
#. [RU] "Эликсир Рататоска"
msgctxt "item_mead_hasty"
msgid "Tonic of Ratatosk"
msgstr "Настой Рататоска"

#. [UA] "Білка має бути спритною у своїх побігеньках угору й униз стовбуром
#. Світового Дерева. Хоча цей персонаж уже не відвідує Вальгайм, але тут ще
#. досі є ті, хто його пам’ятають…"
#. [PL] "Wiewiórka musi mieć szybkie nogi, podczas biegu to w górę, to w dół
#. pnia drzewa świata. Choć w Valheim nie jest już widziana, wciąż są ci, co
#. ją pamiętają..."
#. [RU] "Чтобы бегать вверх и вниз по стволу Мирового древа, белке нужно быть
#. шустрой. Хоть она и не навещает больше Вальхейм, некоторые ее еще
#. помнят..."
msgctxt "item_mead_hasty_description"
msgid "The squirrel must be quick on its feet as it runs up and down the trunk of the world tree. Although it no longer visits Valheim, there are still those who remember it..."
msgstr "Вавёрка гойсае ўверх і ўніз па ствале сусветнага дрэва, таму мусіць мець борздыя ногі. Хоць Рататоск больш не наведвае Вальхэйм, усё яшчэ ёсць тыя, хто яго памятае..."

#. [UA] "Тривка медовиця зцілення"
#. [PL] "Miód pitny ciągłego leczenia"
#. [RU] "Мощная медовуха лечения"
msgctxt "item_mead_hp_lingering"
msgid "Lingering Healing Mead"
msgstr "Стойкі пітны мёд: лячэнне"

#. [UA] "Збільшує відновлення здоров’я."
#. [PL] "Zwiększa regenerację zdrowia."
#. [RU] "Увеличивает восстановление здоровья."
msgctxt "item_mead_hp_lingering_description"
msgid "Increases health regeneration."
msgstr "Павялічвае аднаўленне здароўя."

#. [UA] "Сильна медовиця зцілення"
#. [PL] "Miód pitny mocnego uzdrowienia"
#. [RU] "Большая медовуха лечения"
msgctxt "item_mead_hp_major"
msgid "Major Healing Mead"
msgstr "Вялікі пітны мёд: лячэнне"

#. [UA] "Відновлює здоров’я."
#. [PL] "Przywraca życie."
#. [RU] "Восстанавливает здоровье."
msgctxt "item_mead_hp_major_description"
msgid "Restores health."
msgstr "Аднаўляе здароўе."

#. [UA] "Медовиця зцілення"
#. [PL] "Miód pitny uzdrowienia"
#. [RU] "Средняя медовуха лечения"
msgctxt "item_mead_hp_medium"
msgid "Medium Healing Mead"
msgstr "Сярэдні пітны мёд: лячэнне"

#. [UA] "Відновлює здоров’я."
#. [PL] "Przywraca życie."
#. [RU] "Восстанавливает здоровье."
msgctxt "item_mead_hp_medium_description"
msgid "Restores health."
msgstr "Аднаўляе здароўе."

#. [UA] "Слабка медовиця зцілення"
#. [PL] "Miód pitny słabego uzdrowienia"
#. [RU] "Малая медовуха лечения"
msgctxt "item_mead_hp_minor"
msgid "Minor Healing Mead"
msgstr "Малы пітны мёд: лячэнне"

#. [UA] "Відновлює здоров’я."
#. [PL] "Przywraca życie."
#. [RU] "Восстанавливает здоровье."
msgctxt "item_mead_hp_minor_description"
msgid "Restores health."
msgstr "Аднаўляе здароўе."

#. [UA] "Медовиця легконогів"
#. [PL] "Miód pitny lekkiego kroku"
#. [RU] "Медовуха Легкоступа"
msgctxt "item_mead_lightfoot"
msgid "Lightfoot Mead"
msgstr "Пітны мёд: лёгкія крокі"

#. [UA] "Пляшка вщерть заповнена, але на вагу не відчувається ніяк."
#. [PL] "Niby pełna butelka, a waży tak niewiele, jakby nic w niej nie było."
#. [RU] "Бутылка полная, но кажется невесомой."
msgctxt "item_mead_lightfoot_description"
msgid "This bottle is full, yet it feels like it weighs almost nothing at all."
msgstr "Бутэлька ж поўная, але, здаецца, амаль нічога не важыць."

#. [UA] "Медовиця опору отруті"
#. [PL] "Miód pitny truciznoodporności"
#. [RU] "Медовуха-антидот"
msgctxt "item_mead_poisonres"
msgid "Poison Resistance Mead"
msgstr "Пітны мёд: атрутаўстойлівасць"

#. [UA] "Зміцнює ваш опір різним отруйним речовинам."
#. [PL] "Sprawia cię odpornym na trucizny."
#. [RU] "Защищает от яда."
msgctxt "item_mead_poisonres_description"
msgid "Fortifies you against poison."
msgstr "Ахоўвае вас ад атруты."

#. [UA] "Тривка медовиця освіження"
#. [PL] "Miód pitny ciągłej kondycji"
#. [RU] "Большая медовуха выносливости"
msgctxt "item_mead_stamina_lingering"
msgid "Lingering Stamina Mead"
msgstr "Стойкі пітны мёд: вынослівасць"

#. [UA] "Збільшує відновлення витривалості."
#. [PL] "Zwiększa regenerację kondycji."
#. [RU] "Повышает восстановление выносливости."
msgctxt "item_mead_stamina_lingering_description"
msgid "Increases stamina regeneration."
msgstr "Павялічвае аднаўленне вынослівасці."

#. [UA] "Медовиця освіження"
#. [PL] "Miód pitny kondycji"
#. [RU] "Средняя медовуха выносливости"
msgctxt "item_mead_stamina_medium"
msgid "Medium Stamina Mead"
msgstr "Сярэдні пітны мёд: вынослівасць"

#. [UA] "Відновлює витривалість."
#. [PL] "Przywraca kondycję."
#. [RU] "Восстанавливает выносливость."
msgctxt "item_mead_stamina_medium_description"
msgid "Restores stamina."
msgstr "Аднаўляе вынослівасць."

#. [UA] "Слабка медовиця освіження"
#. [PL] "Miód pitny mniejszej kondycji"
#. [RU] "Малая медовуха выносливости"
msgctxt "item_mead_stamina_minor"
msgid "Minor Stamina Mead"
msgstr "Малы пітны мёд: вынослівасць"

#. [UA] "Відновлює витривалість."
#. [PL] "Przywraca kondycję."
#. [RU] "Восстанавливает выносливость."
msgctxt "item_mead_stamina_minor_description"
msgid "Restores stamina."
msgstr "Аднаўляе вынослівасць."

#. [UA] "Медовиця трольської міці"
#. [PL] "Miód pitny wytrzymałości trolla"
#. [RU] "Медовуха силы тролля"
msgctxt "item_mead_strength"
msgid "Mead of Troll Endurance"
msgstr "Пітны мёд: трольская трываласць"

#. [UA] "Хто може бути сильніше за троля? Ну ясно, що вікінги, що напилися
#. цього напою!"
#. [PL] "Jakie stworzenie jest silniejsze od trolla? Wiking po wypiciu tego
#. miodu rzecz jasna!"
#. [RU] "Кто может быть сильнее тролля? Только викинг, который выпил это
#. варево!"
msgctxt "item_mead_strength_description"
msgid "What creature can carry more than a troll? Why, a viking with this drink of course!"
msgstr "Якая істота будзе мацнейшай за троля? Вядома ж, вікінг што гэтага мёду напіўся!"

#. [UA] "Чаша Вананідіра"
#. [PL] "Nasycony Vananidir"
#. [RU] "Напиток Вананидир"
msgctxt "item_mead_swimmer"
msgid "Draught of Vananidir"
msgstr "Трунак Ванандыра"

#. [UA] "Ви відчуваєте бадьорість одразу, коли берете в руки, а з ковтком
#. чуєте заклик океану до плавання."
#. [PL] "Już samo trzymanie go sprawia, że czujesz przypływ energii, jak gdyby
#. ocean wzywał cię do popływania w nim."
#. [RU] "От одного прикосновения к бутылке вас наполняет бодрость, будто вы
#. слышите зов океана."
msgctxt "item_mead_swimmer_description"
msgid "You feel invigorated just by holding this, as the ocean beckons you to come for a swim."
msgstr "Проста трымаючы бутэльку ў руках, вы ўжо адчуваеце прыліў бадзёрасці, нібы акіян кліча вас паплаваць."

#. [UA] "Настоянка тваринного шепоту"
#. [PL] "Wywar zwierzęcych szeptów"
#. [RU] "Отвар звериного шепота"
msgctxt "item_mead_tamer"
msgid "Brew of Animal Whispers"
msgstr "Узвар звярынага шэпту"

#. [UA] "Смердить, наче зі свинарника. Схоже, що на смак буде не ліпшим."
#. [PL] "Daje chlewem. Smakować pewnie też lepiej nie będzie."
#. [RU] "От него несет свинарником. Вряд ли вкус будет сильно лучше."
msgctxt "item_mead_tamer_description"
msgid "It smells like a pigsty. Likely the taste won't be much better."
msgstr "Смярдзіць, нібы ў свінушніку. Імаверна, смак будзе не лепшы."

#. [UA] "Смачна медовиця"
#. [PL] "Pyszny miód pitny"
#. [RU] "Вкусная медовуха"
msgctxt "item_mead_tasty"
msgid "Tasty Mead"
msgstr "Пітны мёд: смачны"

#. [UA] "Нектар богів, божественна медовиця."
#. [PL] "Nektar bogów, boski miód pitny."
#. [RU] "Божественная амброзия, совершенный напиток."
msgctxt "item_mead_tasty_description"
msgid "The nectar of the Gods, divine mead."
msgstr "Райская медавуха; нектар, годны саміх багоў."

#. [UA] "Любовне зілля"
#. [PL] "Eliksir miłości"
#. [RU] "Любовное зелье"
msgctxt "item_mead_trollpheromones"
msgid "Love Potion"
msgstr "Любізнік"

#. [UA] "Навколо пляшки розливається насичений мускусний сморід трольської
#. печери."
#. [PL] "Flakon ten roztacza wokół intensywną woń piżma wprost z jaskini
#. trolla."
#. [RU] "Интенсивный мускус пронизывает воздух вокруг этого флакона."
msgctxt "item_mead_trollpheromones_description"
msgid "An intense musk permeates the air around this bottle."
msgstr "Інтэнсіўны мускусны імпат прасякае паветра вакол флакона."

#. [UA] "Має перебродити."
#. [PL] "Baza do zrobienia miodu pitnego. Musi się sfermentować."
#. [RU] "Напиток должен побродить."
msgctxt "item_meadbase_description"
msgid "Needs to be fermented."
msgstr "Мае перабрадзіць."

#. [UA] "Основа медовиці: протижальний збір"
#. [PL] "Brzeczka miodowa: Przeciw użądleniom"
#. [RU] "Основа медовухи: средство от смертожалов"
msgctxt "item_meadbasebugrepellent"
msgid "Mead Base: Anti-Sting"
msgstr "Мядовая аснова: сродак ад укусаў"

#. [UA] "Основа медовиці: берсерк"
#. [PL] "Brzeczka miodowa: Berserk"
#. [RU] "Основа медовухи: берсеркир"
msgctxt "item_meadbasebzerker"
msgid "Mead base: Berserkir"
msgstr "Мядовая аснова: берсерк"

#. [UA] "Основа медовиці: слабкий ейтир"
#. [PL] "Brzeczka miodowa: Mniejszy Eitr"
#. [RU] "Основа медовухи: малый эйтр"
msgctxt "item_meadbaseeitr"
msgid "Mead Base: Minor Eitr"
msgstr "Малая мядовая аснова: эйтр"

#. [UA] "Основа медовиці: тривкий ейтир"
#. [PL] "Brzeczka miodowa: Ciągły Eitr"
#. [RU] "Основа медовухи: мощный эйтр"
msgctxt "item_meadbaseeitr_lingering"
msgid "Mead Base: Lingering Eitr"
msgstr "Стойкая мядовая аснова: эйтр"

#. [UA] "Основа медовиці: опір морозу"
#. [PL] "Brzeczka miodowa: Mrozoodporność"
#. [RU] "Основа медовухи: сопротивление морозу"
msgctxt "item_meadbasefrostresist"
msgid "Mead Base: Frost Resistance"
msgstr "Мядовая аснова: марозаўстойлівасць"

#. [UA] "Основа медовиці: Рататоск"
#. [PL] "Brzeczka miodowa: Ratatosk"
#. [RU] "Основа медовухи: Рататоск"
msgctxt "item_meadbasehasty"
msgid "Mead base: Ratatosk"
msgstr "Мядовая аснова: Рататоск"

#. [UA] "Основа медовиці: слабке зцілення"
#. [PL] "Brzeczka miodowa: Słabe uzdrowienie"
#. [RU] "Основа медовухи: малое лечение"
msgctxt "item_meadbasehealth"
msgid "Mead Base: Minor Healing"
msgstr "Малая мядовая аснова: лячэнне"

#. [UA] "Основа медовиці: тривке зцілення"
#. [PL] "Brzeczka miodowa: Ciągłe leczenie"
#. [RU] "Основа медовухи: мощное лечение"
msgctxt "item_meadbasehealth_lingering"
msgid "Mead Base: Lingering Health"
msgstr "Стойкая мядовая аснова: лячэнне"

#. [UA] "Основа медовиці: сильне зцілення"
#. [PL] "Brzeczka miodowa: Mocne uzdrowienie"
#. [RU] "Основа медовухи: большое лечение"
msgctxt "item_meadbasehealth_major"
msgid "Mead Base: Major Healing"
msgstr "Мядовая аснова: моцнае лячэнне"

#. [UA] "Основа медовиці: зцілення"
#. [PL] "Brzeczka miodowa: Uzdrowienie"
#. [RU] "Основа медовухи: среднее лечение"
msgctxt "item_meadbasehealth_medium"
msgid "Mead Base: Medium Healing"
msgstr "Сярэдняя мядовая аснова: лячэнне"

#. [UA] "Основа медовиці: легконіг"
#. [PL] "Brzeczka miodowa: Lekki krok"
#. [RU] "Основа медовухи: Легкоступ"
msgctxt "item_meadbaselightfoot"
msgid "Mead Base: Lightfoot"
msgstr "Мядовая аснова: лёгкія крокі"

#. [UA] "Основа медовиці: опір отруті"
#. [PL] "Brzeczka miodowa: Truciznoodporność"
#. [RU] "Основа медовухи: сопротивление яду"
msgctxt "item_meadbasepoisonresist"
msgid "Mead Base: Poison Resistance"
msgstr "Мядовая аснова: атрутаўстойлівасць"

