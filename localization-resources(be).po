msgstr "Грудная клетка погані"

#. [UA] "Рештки дикої сили ідеально підійдуть для виготовлення обладунків, які
#. містять первісну лють."
#. [PL] "Relikt brutalnej siły, idealny do wykucia zbroi nasyconej dziką
#. furią."
#. [RU] "Реликвия дикой силы, идеально подходящая для создания доспехов,
#. наделенная яростью дикой природы."
msgctxt "item_UndeadBjornRibcage_description"
msgid "A relic of savage strength, perfect for forging armour that bears the wild’s fury."
msgstr "Рэліквія дзікай сілы. Ідэальная пасуе для коўкі брані, здольнай вытрымаць лютасць прыроды."

#. [UA] "Бурштин"
#. [PL] "Bursztyn"
#. [RU] "Янтарь"
msgctxt "item_amber"
msgid "Amber"
msgstr "Бурштын"

#. [UA] "<color=yellow>Цінний</color>"
#. [PL] "<color=yellow>Cenne</color>"
#. [RU] "<color=yellow>Ценное</color>"
msgctxt "item_amber_description"
msgid "<color=yellow>Valuable</color>"
msgstr "<color=yellow>Каштоўны</color>"

#. [UA] "Бурштинова перлина"
#. [PL] "Perła z bursztynu"
#. [RU] "Янтарная жемчужина"
msgctxt "item_amberpearl"
msgid "Amber Pearl"
msgstr "Бурштынавая жамчужына"

#. [UA] "<color=yellow>Цінна</color>"
#. [PL] "<color=yellow>Cenne</color>"
#. [RU] "<color=yellow>Ценное</color>"
msgctxt "item_amberpearl_description"
msgid "<color=yellow>Valuable</color>"
msgstr "<color=yellow>Каштоўная</color>"

#. [UA] "Прадавня монета"
#. [PL] "Starożytna moneta"
#. [RU] "Древняя монета"
#| msgctxt "ancient_chest"
#| msgid "Ancient Coffin"
msgctxt "item_ancientcoin"
msgid "Ancient Coin"
msgstr ""

#. [UA] "Реліквія утрачених епох. На поверхні досі можна розгледіти загадкові
#. символи."
#. [PL] "Relikt zapomnianej przeszłości. Jej powierzchnia nadal nosi znamiona
#. tajemniczych symboli."
#. [RU] "Реликвия ушедшей эпохи. На поверхности еще видны загадочные символы."
msgctxt "item_ancientcoin_description"
msgid "A relic of a lost age. Its surface still bears the trace of mysterious symbols."
msgstr ""

#. [UA] "Дреймукс"
#. [PL] "Draumyks"
#. [RU] "Драумикс"
#| msgctxt "enemy_draugr"
#| msgid "Draugr"
msgctxt "item_ancientgemstone_black"
msgid "Draumyx"
msgstr ""

#. [UA] "Темний непрозорий самоцвіт із гладкою відполірованою поверхнею."
#. [PL] "Ciemny, matowy klejnot o gładkiej i wypolerowanej powierzchni."
#. [RU] "Темный, непрозрачный камень с гладкой и отполированной поверхностью."
msgctxt "item_ancientgemstone_black_description"
msgid "A dark, opaque gem with a smooth and polished surface."
msgstr ""

#. [UA] "Ґримварн"
#. [PL] "Grimvarn"
#. [RU] "Гримварн"
msgctxt "item_ancientgemstone_green"
msgid "Grimvarn"
msgstr ""

#. [UA] "Разючий зелений самоцвіт, барви якого нагадують пишні ліси."
#. [PL] "Klejnot o uderzająco zielonej barwie przypominającej głębokie lasy."
#. [RU] "Яркий зеленый камень цвета лесных глубин."
msgctxt "item_ancientgemstone_green_description"
msgid "A striking green gem, the colour reminiscent of deep forests."
msgstr ""

#. [UA] "Солрит"
#. [PL] "Solryth"
#. [RU] "Солрит"
msgctxt "item_ancientgemstone_orange"
msgid "Solryth"
msgstr ""

#. [UA] "Яскравий помаранчевий самоцвіт, схожий на захід літнього сонця."
#. [PL] "Jaskrawopomarańczowy kamień, zupełnie niczym letni zachód słońca."
#. [RU] "Яркий оранжевый камень цвета летнего заката."
msgctxt "item_ancientgemstone_orange_description"
msgid "A vibrant orange stone, like a summer sunset."
msgstr ""

#. [UA] "Вейдрис"
#. [PL] "Veydris"
#. [RU] "Вейдрис"
msgctxt "item_ancientgemstone_purple"
msgid "Veydris"
msgstr ""

#. [UA] "Насичений пурпуровий самоцвіт, пасуватиме королівським особам."
#. [PL] "Kamień w kolorze głębokiej purpury. Odpowiedni dla rodziny
#. królewskiej."
#. [RU] "Насыщенный фиолетовый камень, достойный королей."
msgctxt "item_ancientgemstone_purple_description"
msgid "A rich purple stone, suitable for royalty."
msgstr "Багаты фіялетавы камень, годны каралёў."

#. [UA] "Прадавній корінь"
#. [PL] "Starożytny korzeń"
#. [RU] "Древний корень"
msgctxt "item_ancientroot"
msgid "Ancient Root"
msgstr "Старадаўні корань"

#. [UA] "Прадавній корінь повністю засох"
#. [PL] "Starożytny korzeń wydaje się wyschnięty"
#. [RU] "Древний корень кажется высохшим"
msgctxt "item_ancientroot_empty"
msgid "The ancient root seems all dried up"
msgstr "Старадаўні корань, здаецца, усох"

#. [UA] "Прадавній корінь пульсує енергією"
#. [PL] "Starożytny korzeń pulsuje energią"
#. [RU] "Древний корень пульсирует энергией"
msgctxt "item_ancientroot_full"
msgid "The ancient root is pulsating with energy"
msgstr "Старадаўні корань пульсуе энергіяй"

#. [UA] "Сяйво прадавнього кореня слабшає"
#. [PL] "Blask starożytnego korzenia słabnie"
#. [RU] "Свечение древнего корня угасает"
msgctxt "item_ancientroot_half"
msgid "The ancient root's glow is fading"
msgstr "Ззянне старадаўняга кораня знікае"

#. [UA] "Прадавнє сім’я"
#. [PL] "Starożytne nasiono"
#. [RU] "Древнее семя"
msgctxt "item_ancientseed"
msgid "Ancient Seed"
msgstr "Старажытнае семя"

#. [UA] "Приклавши до вуха, можна почути всередині шепіт."
#. [PL] "Trzymając je przy uchu, usłyszysz ciche szepty…"
#. [RU] "Если поднести к уху, можно услышать едва уловимый шепот…"
msgctxt "item_ancientseed_description"
msgid "Held against your ear, you hear tiny whisperings within..."
msgstr "Прыціснуўшы яго вуха, вы пачуеце знутры слабенькі шэпт..."

#. [UA] "Захист"
#. [PL] "Pancerz"
#. [RU] "Броня"
msgctxt "item_armor"
msgid "Armour"
msgstr "Браня"

#. [UA] "Кровозлотна стріла"
#. [PL] "Strzała z krwawego złota"
#. [RU] "Стрела из кровавого золота"
#, fuzzy
#| msgctxt "item_arrow_wood"
#| msgid "Wood Arrow"
msgctxt "item_arrow_bloodgold"
msgid "Bloodgold Arrow"
msgstr "Крывазолатая страла"

#. [UA] "Стріла, викувана либонь із найтвердіших матеріалів у цьому світі…"
#. [PL] "Strzała wykuta z prawdopodobnie najtwardszego materiału na
#. świecie..."
#. [RU] "Стрела, выкованная, быть может, из самых твердых материалов в этом
#. мире..."
msgctxt "item_arrow_bloodgold_description"
msgid "An arrow forged of perhaps the hardest materials in this world..."
msgstr "Страла, скаваная з, магчыма, найцвярдзейшага матэрыялу гэтага свету..."

#. [UA] "Бронзова стріла"
#. [PL] "Strzały z grotem z brązu"
#. [RU] "Стрела с бронзовым наконечником"
msgctxt "item_arrow_bronze"
msgid "Bronzehead Arrow"
msgstr "Бронзавая страла"

#. [UA] "Гостріший за кремінь посланець смерті."
#. [PL] "Ostrzejsza niż krzemień – lśniący posłaniec śmierci."
#. [RU] "Эти стрелы острее кремниевых, они быстры и смертоносны."
msgctxt "item_arrow_bronze_description"
msgid "Sharper than flint. A sleek messenger of death."
msgstr "Наканечнік вастрэйшы за крамянёвы. Бліскучы вястун смерці."

#. [UA] "Хітинова стріла"
#. [PL] "Strzały z pancerza"
#. [RU] "Панцирная стрела"
msgctxt "item_arrow_carapace"
msgid "Carapace Arrow"
msgstr "Хіцінавая страла"

#. [UA] "Важка й гостра. Комусь буде боляче."
#. [PL] "Ciężkie i szpiczaste, na pewno zaboli."
#. [RU] "Тяжелая и острая. Кому-то будет больно."
msgctxt "item_arrow_carapace_description"
msgid "Heavy and pointy, this one's gonna hurt."
msgstr "Цяжкая і вострая. Камусьці будзе вельмі балюча."

#. [UA] "Обвуглена стріла"
#. [PL] "Zwęglona strzała"
#. [RU] "Обугленная стрела"
msgctxt "item_arrow_charred"
msgid "Charred Arrow"
msgstr "Абвугленая страла"

#. [UA] "Цю стрілу вирізьбили з обвугленої стегнової кістки. Вона твердіша за
#. будь-який метал."
#. [PL] "Tę strzałę wykonano ze zwęglonej kości udowej, dzięki czemu jest
#. twarda jak metal."
#. [RU] "Стрела выточена из обугленной бедренной кости. Она тверже любого
#. металла."
msgctxt "item_arrow_charred_description"
msgid "This arrow has been whittled into shape from a charred femur, and it's as hard as any metal."
msgstr "Страла была выразана з абгарэлай сцегнавіцы, дзякуючы чаму яна цвёрдая, як метал."

#. [UA] "Вогняна стріла"
#. [PL] "Ogniste strzały"
#. [RU] "Огненная стрела"
msgctxt "item_arrow_fire"
msgid "Fire Arrow"
msgstr "Вогненная страла"

#. [UA] "Підпалить усе, що проштрикне."
#. [PL] "Ta strzała podpala przeszyty cel."
#. [RU] "В кого попадешь - того и подожжешь."
msgctxt "item_arrow_fire_description"
msgid "This arrow burns whatever it pierces."
msgstr "Ва што ні трапіш — усё падпаліш."

#. [UA] "Крем’яна стріла"
#. [PL] "Krzemienne strzały"
#. [RU] "Стрела с кремниевым наконечником"
msgctxt "item_arrow_flint"
msgid "Flinthead Arrow"
msgstr "Крамянёвая страла"

#. [UA] "Може пробити шкуру тварин."
#. [PL] "Krzemienny grot przeszywający skórę."
#. [RU] "С легкостью пробивает даже самые крепкие шкуры."
msgctxt "item_arrow_flint_description"
msgid "A hide-breaker with a head of flint."
msgstr "Праб’е ўсякую шкуру сваім крамянёвым наканечнікам."

#. [UA] "Морозна стріла"
#. [PL] "Lodowe strzały"
#. [RU] "Ледяная стрела"
msgctxt "item_arrow_frost"
msgid "Frost Arrow"
msgstr "Марозная страла"

#. [UA] "Загострений крижаний уламок."
#. [PL] "Odłamek przeszywającego lodu."
#. [RU] "Острый осколок льда."
msgctxt "item_arrow_frost_description"
msgid "A shard of piercing ice."
msgstr "Аскепак пранізлівага лёду."

#. [UA] "Залізна стріла"
#. [PL] "Strzały z żelaznym grotem"
#. [RU] "Стрела с железным наконечником"
msgctxt "item_arrow_iron"
msgid "Ironhead Arrow"
msgstr "Жалезная страла"

#. [UA] "Залізне вістря й чорне оперення."
#. [PL] "Pokryta żelazem strzała z ciemnymi piórami."
#. [RU] "Стрела с железным наконечником и темным оперением."
msgctxt "item_arrow_iron_description"
msgid "Capped with iron and flighted with dark feathers."
msgstr "Жалезны наканечнік і цёмнае апярэнне."

#. [UA] "Голкова стріла"
#. [PL] "Strzały z igieł"
#. [RU] "Игольная стрела"
msgctxt "item_arrow_needle"
msgid "Needle Arrow"
msgstr "Іголкавая страла"

#. [UA] "Останній шов."
#. [PL] "Ostatni ścieg."
#. [RU] "Последний стежок."
msgctxt "item_arrow_needle_description"
msgid "The final stitch."
msgstr "Апошняе шво."

#. [UA] "Обсидіанова стріла"
#. [PL] "Strzały z obsydianu"
#. [RU] "Обсидиановая стрела"
msgctxt "item_arrow_obsidian"
msgid "Obsidian Arrow"
msgstr "Абсідыянавая страла"

#. [UA] "Уламок темряви."
#. [PL] "Odłamek ciemności."
#. [RU] "Осколок тьмы."
msgctxt "item_arrow_obsidian_description"
msgid "A sliver of darkness."
msgstr "Стрэмка цемры."

#. [UA] "Отруйна стріла"
#. [PL] "Zatrute strzały"
#. [RU] "Отравленная стрела"
msgctxt "item_arrow_poison"
msgid "Poison Arrow"
msgstr "Атручаная страла"

#. [UA] "Пекуче жало, що жалить здалеку."
#. [PL] "Bolesne ukłucie z oddali."
#. [RU] "Жгучее жало, способное поразить свою жертву издалека."
msgctxt "item_arrow_poison_description"
msgid "A bitter sting from afar."
msgstr "Пранізлівае джала, што б’е здалёк."

#. [UA] "Срібна стріла"
#. [PL] "Srebrne strzały"
#. [RU] "Серебряная стрела"
msgctxt "item_arrow_silver"
msgid "Silver Arrow"
msgstr "Сярэбраная страла"

#. [UA] "Тонкий, мов голка, заспокоювач тривожних духів."
#. [PL] "Ostrze uspokajające niespokojne duchy."
#. [RU] "Игла, приносящая покой неприкаянным духам."
msgctxt "item_arrow_silver_description"
msgid "A needle to calm restless spirits."
msgstr "Іголка, што ўціхамірвае неспакойных духаў."

#. [UA] "Дерев’яна стріла"
#. [PL] "Drewniane strzały"
#. [RU] "Деревянная стрела"
msgctxt "item_arrow_wood"
msgid "Wood Arrow"
msgstr "Драўляная страла"

#. [UA] "Просто загострений тонкий прутик."
#. [PL] "Strzała z zaostrzonego drewna."
#. [RU] "Стрела из бруска заостренной древесины."
msgctxt "item_arrow_wood_description"
msgid "An arrow of sharpened wood."
msgstr "Страла, зробленая з завостранай палкі."

#. [UA] "Сечовий міхур попелозавра"
#. [PL] "Pęcherz szarowieprza"
#. [RU] "Мочевой пузырь пеплозавра"
msgctxt "item_askbladder"
msgid "Asksvin Bladder"
msgstr "Мачавік тленнавепра"

#. [UA] "Кислий запах досі не вивітрився. Аж очі ріже."
#. [PL] "Wciąż czuć kwaśny fetor. I to bardzo mocny."
#. [RU] "Сильный кислый запах. Аж глаза режет."
msgctxt "item_askbladder_description"
msgid "An acidic smell still lingers. Prominently."
msgstr "Кіслотны смурод нікуды не знікае. І ён вельмі моцны."

#. [UA] "Шкура попелозавра"
#. [PL] "Skóra szarowieprza"
#. [RU] "Шкура пеплозавра"
msgctxt "item_askhide"
msgid "Asksvin Hide"
msgstr "Скура тленнавепра"

#. [UA] "Доволі товста й міцна шкіра, ще й досі тепла на дотик."
#. [PL] "Gruba, twarda skóra, wciąż ciepła w dotyku."
#. [RU] "Добротная толстая кожа. Теплая на ощупь."
msgctxt "item_askhide_description"
msgid "This sturdy leather is thick, and still warm to the touch."
msgstr "Дыхтоўная тоўстая скура, усё яшчэ цёплая навобмацак."

#. [UA] "Яйце попелозавра"
#. [PL] "Jajo szarowieprza"
#. [RU] "Яйцо пеплозавра"
msgctxt "item_asksvin_egg"
msgid "Asksvin Egg"
msgstr "Яйка тленнавепра"

#. [UA] "Тверде, наче камінь, але відчувається, що всередині щось є. Треба
#. тримати в теплі."
#. [PL] "Twarde jak skała, a jednak wyczuwasz, że coś w sobie kryje. Należy je
#. trzymać w cieple."
#. [RU] "Твердое, словно камень, но внутри что-то точно есть, вы это
#. чувствуете. Его надо держать в тепле."
msgctxt "item_asksvin_egg_description"
msgid "Hard as rock, yet you can sense the presence of something inside. This should be kept warm."
msgstr "Цвёрдае як камень, але вы адчуваеце нечую прысутнасць унутры. Варта трымаць у цяпле."

#. [UA] "Хвіст попелозавра"
#. [PL] "Ogon szarowieprza"
#. [RU] "Хвост пеплозавра"
msgctxt "item_asksvin_meat"
msgid "Asksvin Tail"
msgstr "Хвост тленнавепра"

#. [UA] "Смажений хвіст попелозавра"
#. [PL] "Gotowany ogon szarowieprza"
#. [RU] "Жареный хвост пеплозавра"
msgctxt "item_asksvin_meat_cooked"
msgid "Cooked Asksvin Tail"
msgstr "Печаны хвост тленнавепра"

#. [UA] "Це м’ясо має насичений аромат старого звіра, але дуже смачне, якщо
#. його приготувати правильно."
#. [PL] "Aromatyczne, dojrzałe mięso. Pyszne po odpowiednim upieczeniu."
#. [RU] "Сильный и выдержанный вкус, но если правильно обжарить — объедение."
msgctxt "item_asksvin_meat_cooked_description"
msgid "This meat has a potent and mature flavour, but is very tasty when grilled right."
msgstr "Мяса мае моцны і вытрыманы смак, але як падсмажыце — увогуле смаката будзе."

#. [UA] "Трохи пахне димом, навіть ще до обсмажування."
#. [PL] "Ma zapach dymu, nawet na surowo."
#. [RU] "Отдает дымком, даже когда сырой."
msgctxt "item_asksvin_meat_description"
msgid "Smells a bit smokey, even when raw."
msgstr "Мае дымны пах нават сырым."

#. [UA] "Шия попелозавра"
#. [PL] "Szyja szarowieprza"
#. [RU] "Шея пеплозавра"
msgctxt "item_asksvincarrionneck"
msgid "Asksvin Neck"
msgstr "Шыя тленнавепра"

#. [UA] "Шия на останньому етапі існування."
#. [PL] "Szyja w ostatnim stadium życia."
#. [RU] "Шея — или то, что от нее осталось."
msgctxt "item_asksvincarrionneck_description"
msgid "A neck in its final stage of life."
msgstr "Фінальная ступень развіцця нёка."

#. [UA] "Таз попелозавра"
#. [PL] "Miednica szarowieprza"
#. [RU] "Таз пеплозавра"
msgctxt "item_asksvincarrionpelvic"
msgid "Asksvin Pelvis"
msgstr "Таз тленнавепра"

#. [UA] "Тазова кістка чотириногого створіння."
#. [PL] "Kość miednicy czworonożnego stworzenia."
#. [RU] "Тазовая кость четвероногого зверя."
msgctxt "item_asksvincarrionpelvic_description"
msgid "The pelvic bone of a four legged creature."
msgstr "Тазавая костка чатырохногай істоты."

#. [UA] "Грудина попелозавра"
#. [PL] "Klatka piersiowa szarowieprza"
#. [RU] "Ребра пеплозавра"
msgctxt "item_asksvincarrionribcage"
msgid "Asksvin Ribcage"
msgstr "Грудная клетка тленнавепра"

#. [UA] "На цих ребрах не лишилося ані шматочка м’яса."
#. [PL] "Żebra pozbawiono już wszelkich śladów mięsa."
#. [RU] "На ребрах не осталось ни следа мяса."
msgctxt "item_asksvincarrionribcage_description"
msgid "These ribs have already been stripped clean of any meat."
msgstr "На гэтых рэбрах не засталося ані шматка мяса."

#. [UA] "Череп попелозавра"
#. [PL] "Czaszka szarowieprza"
#. [RU] "Череп пеплозавра"
msgctxt "item_asksvincarrionskull"
msgid "Asksvin Skull"
msgstr "Чэрап тленнавепра"

#. [UA] "Товстий череп для навдивовижу великого мозку."
#. [PL] "Gruba czaszka, która pomieści zaskakująco duży mózg."
#. [RU] "Толстый череп с неожиданно большой мозговой полостью."
msgctxt "item_asksvincarrionskull_description"
msgid "A thick skull, with room for a surprisingly large brain."
msgstr "Тоўсты чэрап, з прасторай для на дзіва вялікага мозгу."

#. [UA] "Чорнометалевий атгейр"
#. [PL] "Atgeir z czarnego metalu"
#. [RU] "Алебарда из черного металла"
msgctxt "item_atgeir_blackmetal"
msgid "Black Metal Atgeir"
msgstr "Атгейр з чорнага металу"

#. [UA] "Лиховісна сокира із чорного металу, що майже не піддається руйнації."
#. [PL] "Potężny topór z prawie niezniszczalnego czarnego metalu."
#. [RU] "Прекрасная алебарда из почти неуязвимого черного металла."
msgctxt "item_atgeir_blackmetal_description"
msgid "A vicious hewing-axe of almost unbreakable black metal."
msgstr "Ліхая алебарда з амаль небіткога чорнага металу."

#. [UA] "Бронзовий атгейр"
#. [PL] "Atgeir z brązu"
#. [RU] "Бронзовая алебарда"
msgctxt "item_atgeir_bronze"
msgid "Bronze Atgeir"
msgstr "Бронзавы Атгейр"

#. [UA] "Знаряддя справжнього воїна."
#. [PL] "Narzędzie prawdziwego wojownika."
#. [RU] "Оружие настоящего воина."
msgctxt "item_atgeir_bronze_description"
msgid "A true warrior's tool."
msgstr "Снадзіва праўдзівага ваяра."

#. [UA] "Нордичний атгейр"
#. [PL] "Nordycki atgeir"
#. [RU] "Нордская алебарда"
msgctxt "item_atgeir_gold"
msgid "Nord Atgeir"
msgstr "Нардычны Атгейр"

#. [UA] "Громокровний атгейр"
#. [PL] "Grzmotokrwisty atgeir"
#. [RU] "Алебарда громовой крови"
#, fuzzy
#| msgctxt "item_thunderstone"
#| msgid "Thunder Stone"
msgctxt "item_atgeir_gold_bloodlightning"
msgid "Thunderblood Atgeir"
msgstr "Атгейр Громавай Крыві"

#. [UA] "Небеса молитимуться, коли ви пускатимете ворогами кров."
#. [PL] "Niebiosa będą cię wychwalać, gdy twoi wrogowie będą krwawić."
#. [RU] "Небеса воздадут хвалу, когда вы заставите своих врагов истекать
#. кровью."
#, fuzzy
msgctxt "item_atgeir_gold_bloodlightning_description"
msgid "The heavens shall sound their praise as you make your enemies bleed."
msgstr "Нябёсы ўзгучуць пахвалой, калі ты пусціш кроў сваіх ворагаў."

#. [UA] "Заготовина: Громокровний атгейр"
#. [PL] "Odlew: grzmotokrwisty atgeir"
#. [RU] "Заготовка: алебарда громовой крови"
#, fuzzy
msgctxt "item_atgeir_gold_bloodlightning_uncooked"
msgid "Cast: Thunderblood Atgeir"
msgstr "Загатоўка: Атгейр Громавай Крыві"

#. [UA] "Та сама форма, але результат буде набагато видовищнішим… З часом
#. мороз усе викаже."
#. [PL] "Ta sama forma, lecz może wydać coś o wiele bardziej
#. spektakularnego... Z biegiem czasu mróz wszystko ukaże."
#. [RU] "Хоть форма и осталась прежней, истинный потенциал стал куда более
#. впечатляющим... Со временем мороз раскрывает все, что скрыто."
msgctxt "item_atgeir_gold_bloodlightning_uncooked_description"
msgid "The same mould, yet inclined to yield a more spectacular result... The frost shall reveal all, in time."
msgstr "Тая ж форма, але здольная прынесці значна ашаламляльнейшы плён ... Мароз расставіць усё па месцах, свайго часу."

#. [UA] "Край цієї зброї настільки лискучий, наскільки  смертоносний."
#. [PL] "Ostrze tej broni jest równie zabójcze, co błyszczące."
#. [RU] "Острие этого оружия столь же смертоносно, сколь и ослепительно."
#, fuzzy
msgctxt "item_atgeir_gold_description"
msgid "The edge of this weapon is as deadly as it is shiny."
msgstr "Востры край гэтай зброі настолькі ж смяротны, наколькі і бліскучы."

#. [UA] "Вогнекрижний атгейр"
#. [PL] "Mroźnognisty atgeir"
#. [RU] "Алебарда льда и огня"
#, fuzzy
#| msgctxt "item_atgeir_bronze"
#| msgid "Bronze Atgeir"
msgctxt "item_atgeir_gold_frostfire"
msgid "Frostfire Atgeir"
msgstr "Атгейр Зімняга Полымя"

#. [UA] "Нехай полум’я починає поглинати, а крига забере рештки."
#. [PL] "Niechaj płomienie zaczną trawić, a lód pochłonie wszystko, co po nich
#. pozostanie."
#. [RU] "Ее пламя пожирает все на своем пути, а лед заковывает остатки."
#, fuzzy
msgctxt "item_atgeir_gold_frostfire_description"
msgid "Let the flames begin to devour, while the ice claims whatever remains."
msgstr "Няхай полымя пачне знішчаць, а лёд забярэ тое, што застанецца."

#. [UA] "Заготовина: Вогнекрижний атгейр"
#. [PL] "Odlew: mroźnognisty atgeir"
#. [RU] "Заготовка: алебарда льда и огня"
#, fuzzy
msgctxt "item_atgeir_gold_frostfire_uncooked"
msgid "Cast: Frostfire Atgeir"
msgstr "Загатоўка: Атгейр Зімняга Полымя"

#. [UA] "Та сама форма, але результат буде значно видовищнішим… З часом мороз
#. усе викаже."
#. [PL] "Ta sama forma, lecz może wydać coś o wiele bardziej
#. spektakularnego... Z biegiem czasu mróz wszystko ukaże."
#. [RU] "Хоть форма и осталась прежней, истинный потенциал стал куда более
#. впечатляющим... Со временем мороз раскрывает все, что скрыто."
msgctxt "item_atgeir_gold_frostfire_uncooked_description"
msgid "The same mould, yet inclined to yield a more spectacular result... The frost shall reveal all, in time."
msgstr "Тая ж форма, але здольная прынесці значна ашаламляльнейшы плён ... Мароз расставіць усё па месцах, свайго часу."

#. [UA] "Заготовина: Нордичний атгейр"
#. [PL] "Odlew: nordycki atgeir"
#. [RU] "Заготовка: нордская алебарда"
msgctxt "item_atgeir_gold_uncooked"
msgid "Cast: Nord Atgeir"
msgstr "Загатоўка: Нардычны Атгейр"

#. [UA] "Зброю потрібно загартувати морозом."
#. [PL] "Tę broń należy zahartować mrozem."
#. [RU] "Это оружие нужно закалить морозом."
msgctxt "item_atgeir_gold_uncooked_description"
msgid "This weapon needs to be hardened with frost."
msgstr "Гэтую зброю трэба загартоўваць марозам."

#. [UA] "Гіммінафль"
#. [PL] "Himminafl"
#. [RU] "Химминафль"
msgctxt "item_atgeir_himminafl"
msgid "Himminafl"
msgstr "Хіммінафль"

#. [UA] "Можливо, це й не молот, але Тор особисто схвалює цю зброю."
#. [PL] "Może to i nie młot, ale sam Thor by pochwalił tę broń."
#. [RU] "Пусть это и не молот, но сам Тор все равно одобрил бы это оружие."
msgctxt "item_atgeir_himminafl_description"
msgid "It might not be a hammer, but Thor himself would still approve of this weapon."
msgstr "Няхай гэта і не молат, але нават сам Тор ухваліў бы такую зброю."

#. [UA] "Залізний атгейр"
#. [PL] "Żelazny atgeir"
#. [RU] "Железная алебарда"
msgctxt "item_atgeir_iron"
msgid "Iron Atgeir"
msgstr "Жалезны Атгейр"

#. [UA] "Кровопускач, черепотрощій, смертеприкликач."
#. [PL] "Wypija krew, łamie czaszki, zwiastuje śmierć."
#. [RU] "Кровопролитная, головодробящая, смерть приносящая."
msgctxt "item_atgeir_iron_description"
msgid "Blood-drinker, skull-cracker, death-bringer."
msgstr "Крывапіўца, чарапалом, вястун самой смерці."

#. [UA] "Дерев’яний атгейр"
#. [PL] "Drewniany Atgeir"
#. [RU] "Деревянная алебарда"
msgctxt "item_atgeir_wood"
msgid "Wooden Atgeir"
msgstr "Драўляны Атгейр"

#. [UA] "Може й не завдасть багато болю, але дістане здаля!"
#. [PL] "Może i nie boli za bardzo, ale ma zasięg!"
#. [RU] "Много вреда не нанесет, зато длинная!"
msgctxt "item_atgeir_wood_description"
msgid "It might not hurt a lot, but it has reach!"
msgstr "Шмат шкоды не наробіць, але затое які доўгі!"

#. [UA] "Нордичний топір"
#. [PL] "Nordycki topór dwuręczny"
#. [RU] "Нордская секира"
msgctxt "item_axe2h_gold"
msgid "Nord Greataxe"
msgstr "Нардычная аберучная сякера"

#. [UA] "Громокровний топір"
#. [PL] "Grzmotokrwisty topór dwuręczny"
#. [RU] "Секира громовой крови"
#, fuzzy
msgctxt "item_axe2h_gold_bloodlightning"
msgid "Thunderblood Greataxe"
msgstr "Аберучная сякера Громавай Крыві"

#. [UA] "Як сокира ворогів навпіл рубає, то струмені крові, мов громовиці,
#. співають."
#. [PL] "Gdy przerąbiesz swoich wrogów na pół, ich krew zaśpiewa niczym
#. pioruny w burzy."
#. [RU] "Рассекая врагов пополам, вы услышите, как их кровь поет, словно
#. гроза."
#, fuzzy
msgctxt "item_axe2h_gold_bloodlightning_description"
msgid "As you cleave your foes in two, their blood shall sing like a thunderstorm."
msgstr "Пакуль ты рассякаеш ворагаў надвое, іхняя кроў будзе спяваць, як навальніца."

#. [UA] "Заготовина: Громокровний топір"
#. [PL] "Odlew: grzmotokrwisty topór dwuręczny"
#. [RU] "Заготовка: секира громовой крови"
msgctxt "item_axe2h_gold_bloodlightning_uncooked"
msgid "Cast: Thunderblood Greataxe"
msgstr "АдлітакЗагатоўка: Аберучная сякера Громавай Крыві"

#. [UA] "Та сама форма, але результат буде набагато видовищнішим… З часом
#. мороз усе викаже."
#. [PL] "Ta sama forma, lecz może wydać coś o wiele bardziej
#. spektakularnego... Z biegiem czasu mróz wszystko ukaże."
#. [RU] "Хоть форма и осталась прежней, истинный потенциал стал куда более
#. впечатляющим... Со временем мороз раскрывает все, что скрыто."
msgctxt "item_axe2h_gold_bloodlightning_uncooked_description"
msgid "The same mould, yet inclined to yield a more spectacular result... The frost shall reveal all, in time."
msgstr "Тая ж форма, але здольная прынесці значна ашаламляльнейшы плён ... Мароз расставіць усё па месцах, свайго часу."

#. [UA] "Могутній топір для могутніх воїтелів."
#. [PL] "Potężny topór dla potężnego wojownika."
#. [RU] "Могучий топор для настоящего воина."
msgctxt "item_axe2h_gold_description"
msgid "A mighty axe fit for a mighty warrior."
msgstr "Магутная сякера для магутнага ваяра."

#. [UA] "Вогнекрижний топір"
#. [PL] "Mroźnognisty topór dwuręczny"
#. [RU] "Секира льда и огня"
msgctxt "item_axe2h_gold_frostfire"
msgid "Frostfire Greataxe"
msgstr ""

#. [UA] "Уражайте своїх ворогів крижаним інферно!"
#. [PL] "Uderz swoich wrogów zamrożonym ogniem piekielnym!"
#. [RU] "Разите врагов леденящим огнем!"
msgctxt "item_axe2h_gold_frostfire_description"
msgid "Strike your foes with a frozen inferno!"
msgstr "Абрыньце на ворагаў марознае пекла!"

#. [UA] "Заготовина: Вогнекрижний топір"
#. [PL] "Odlew: mroźnognisty topór dwuręczny"
#. [RU] "Заготовка: секира льда и огня"
#, fuzzy
msgctxt "item_axe2h_gold_frostfire_uncooked"
msgid "Cast: Frostfire Greataxe"
msgstr "Загатоўка: Аберучная сякера Зімняга Полымя"

#. [UA] "Та сама форма, але результат буде набагато видовищнішим… З часом
#. мороз усе викаже."
#. [PL] "Ta sama forma, lecz może wydać coś o wiele bardziej
#. spektakularnego... Z biegiem czasu mróz wszystko ukaże."
#. [RU] "Хоть форма и осталась прежней, истинный потенциал стал куда более
#. впечатляющим... Со временем мороз раскрывает все, что скрыто."
msgctxt "item_axe2h_gold_frostfire_uncooked_description"
msgid "The same mould, yet inclined to yield a more spectacular result... The frost shall reveal all, in time."
msgstr "Тая ж форма, але здольная прынесці значна ашаламляльнейшы плён ... Мароз расставіць усё па месцах, свайго часу."

#. [UA] "Заготовина: Нордичний топір"
#. [PL] "Odlew: nordycki topór dwuręczny"
#. [RU] "Заготовка: нордская секира"
msgctxt "item_axe2h_gold_uncooked"
msgid "Cast: Nord Greataxe"
msgstr "Загатоўка: Нардычная аберучная сякера"

#. [UA] "Зброю потрібно загартувати морозом."
#. [PL] "Tę broń należy zahartować mrozem."
#. [RU] "Это оружие нужно закалить морозом."
msgctxt "item_axe2h_gold_uncooked_description"
msgid "This weapon needs to be hardened with frost."
msgstr "Гэтую зброю трэба загартоўваць марозам."

#. [UA] "Берсеркові сокирки"
#. [PL] "Topory berserków"
#. [RU] "Топоры берсеркира"
msgctxt "item_axe_berzerkr"
msgid "Berserkir Axes"
msgstr "Берсеркавы сякеры"

#. [UA] "Кровоточиві берсеркові сокирки"
#. [PL] "Krwawe topory berserków"
#. [RU] "Кровоточащие топоры берсеркира"
msgctxt "item_axe_berzerkr_blood"
msgid "Bleeding Berserkir Axes"
msgstr "Крывавыя берсеркавы сякеры"

#. [UA] "Що ближче смерть до вас, то потужніші ваші удари."
#. [PL] "Im bliżej śmierci jesteś, tym silniejsze twoje ciosy."
#. [RU] "Чем ближе смерть, тем сильнее ваши удары."
msgctxt "item_axe_berzerkr_blood_description"
msgid "The closer you are to death, the harder you are sure to hit."
msgstr "Чым бліжэй вы да смерці, тым мацней будзеце біць."

#. [UA] "Випустіть свою лють і нехай почнеться різанина."
#. [PL] "Niech twój gniew weźmie górę i popchnie cię do rzezi."
#. [RU] "Дайте волю ярости и погрузитесь в бойню."
msgctxt "item_axe_berzerkr_description"
msgid "Let your rage take over and face the slaughter."
msgstr "Няхай ваш гнеў возьме верх і вы занурыцеся ў бойню."

#. [UA] "Громовиті берсеркові сокирки"
#. [PL] "Topory berserków grzmotu"
#. [RU] "Громовые топоры берсеркира"
msgctxt "item_axe_berzerkr_lightning"
msgid "Thundering Berserkir Axes"
msgstr "Грымотныя берсеркавы сякеры"

#. [UA] "Там, де ви й ці сокирки, там усюди бійня такого масштабу, що сам Тор
#. пишався б вами."
#. [PL] "Z tymi toporami w dłoniach siejesz zniszczenie, które pochwaliłby
#. nawet sam Tor."
#. [RU] "Когда в ваших руках эти топоры, вокруг вас всегда будет кровавая
#. баня. Сам Тор был бы доволен."
msgctxt "item_axe_berzerkr_lightning_description"
msgid "Carnage spreads around you when you wield these axes, such that Thor himself would be proud."
msgstr "Пакуль вы трымаеце гэтыя сякеры, разня будзе ўсюды, дзе б вы ні былі. Сам Тор ганарыўся б вамі."

#. [UA] "Первісні берсеркові сокирки"
#. [PL] "Pierwotne topory berserków"
#. [RU] "Первобытные топоры берсеркира"
msgctxt "item_axe_berzerkr_nature"
msgid "Primal Berserkir Axes"
msgstr "Першабытныя берсеркавы сякеры"

#. [UA] "Найпервинніші інстинкти беруть гору над вами, природа прагне
#. допомогти."
#. [PL] "Górę biorą twoje pierwotne instynkty. Otaczająca cię przyroda wyciąga
#. pomocną dłoń."
#. [RU] "Вы отдаетесь первобытным инстинктам, и природа приходит к вам на
#. помощь."
msgctxt "item_axe_berzerkr_nature_description"
msgid "Your most primal instincts take over, and the nature around you reaches out to aid you."
msgstr "Вашыя першабытныя інстынкты бяруць верх, і прырода вакол імкнецца памагчы."

#. [UA] "Чорнометалева сокира"
#. [PL] "Topór z czarnego metalu"
#. [RU] "Топор из черного металла"
msgctxt "item_axe_blackmetal"
msgid "Black Metal Axe"
msgstr "Сякера з чорнага металу"

#. [UA] "Ідеально збалансована сокира з темного металу зі смарагдовим
#. відблиском."
#. [PL] "Doskonale wyważony topór wykuty z ciemnego metalu ze szmaragdowym
#. połyskiem."
#. [RU] "Идеально сбалансированный топор, выкованный из темного металла с
#. изумрудным отливом."
msgctxt "item_axe_blackmetal_description"
msgid "A perfectly-balanced axe forged from dark metal with an emerald sheen."
msgstr "Ідэальна збалансаваная сякера, выкаваная з цёмнага металу з смарагдавым бліскам."

#. [UA] "Бронзова сокира"
#. [PL] "Topór z brązu"
#. [RU] "Бронзовый топор"
msgctxt "item_axe_bronze"
msgid "Bronze Axe"
msgstr "Бронзавая сякера"

#. [UA] "Яскраве й загартоване лезо, викуване у вигляді посмішки."
#. [PL] "Jasne i lśniące ostrze – wygięte niczym uśmiech."
#. [RU] "Лезвие в форме улыбки так отполировано, что сияет."
msgctxt "item_axe_bronze_description"
msgid "A bright and burnished blade, curved like a smile."
msgstr "Мае яскравае і адпаліраванае лязо, якое выгінаецца нібы ва ўсмешцы."

#. [UA] "Ранні сокири"
#. [PL] "Wczesne dostępory"
#. [RU] "Древние топоры"
msgctxt "item_axe_early"
msgid "Early Axes"
msgstr "Старадаўнія сякеры"

#. [UA] "Потужна зброя із сивої давнини — із часів, коли світ був молодим і
#. недовершеним…"
#. [PL] "Potężna broń z dawien dawna, gdy świat nadal był młody i
#. niekompletny..."
#. [RU] "Древнее оружие великой силы. Памятник эпохи, когда мир был юн и не до
#. конца сотворен..."
msgctxt "item_axe_early_description"
msgid "Mighty weapons from long ago, from a time when the world was still young and incomplete..."
msgstr "Магутная зброя са старадаўніх часін, калі свет яшчэ быў малады і недавершаны..."

#. [UA] "Крем’яна сокира"
#. [PL] "Krzemienny topór"
#. [RU] "Кремневый топор"
msgctxt "item_axe_flint"
msgid "Flint Axe"
msgstr "Крамянёвая сякера"

#. [UA] "Гостріша за кам’яну."
#. [PL] "Ostrzejszy niż skała."
#. [RU] "Острее камня."
msgctxt "item_axe_flint_description"
msgid "Sharper than stone."
msgstr "Вастрэйшая за каменную."

#. [UA] "Нордична сокира"
#. [PL] "Nordycki topór"
#. [RU] "Нордский топор"
msgctxt "item_axe_gold"
msgid "Nord Axe"
msgstr "Нардычная сякера"

#. [UA] "Громокровна сокира"
#. [PL] "Grzmotokrwisty topór"
#. [RU] "Топор громовой крови"
#, fuzzy
#| msgctxt "item_thunderstone"
#| msgid "Thunder Stone"
msgctxt "item_axe_gold_bloodlightning"
msgid "Thunderblood Axe"
msgstr "Сякера Громавай Крыві"

#. [UA] "Сокира рубає однаково дерево й плоть, а по всіх усюдах чутно відлуння
#. громовиць."
#. [PL] "Gdy będzie się przedzierał zarówno przez drewno, jak i krew, w całej
#. okolicy rozlegnie się burzowy łoskot."
#. [RU] "Когда этот топор рассекает древесину и плоть, по земле разносятся
#. раскаты грома."
#, fuzzy
msgctxt "item_axe_gold_bloodlightning_description"
msgid "As this axe cuts through wood and blood alike, a resounding thunderous crack shall be heard throughout the land."
msgstr "Калі гэтая сякера сячэ і дрэва, і кроў, па ўсёй зямлі прагучыць грымотны раскол."

#. [UA] "Заготовина: Громокровна сокира"
#. [PL] "Odlew: grzmotokrwisty topór"
#. [RU] "Заготовка: топор громовой крови"
#, fuzzy
msgctxt "item_axe_gold_bloodlightning_uncooked"
msgid "Cast: Thunderblood Axe"
msgstr "Загатоўка: Сякера Громавай Крыві"

#. [UA] "Та сама форма, але результат буде набагато видовищнішим… З часом
#. мороз усе викаже."
#. [PL] "Ta sama forma, lecz może wydać coś o wiele bardziej
#. spektakularnego... Z biegiem czasu mróz wszystko ukaże."
#. [RU] "Хоть форма и осталась прежней, истинный потенциал стал куда более
#. впечатляющим... Со временем мороз раскрывает все, что скрыто."
msgctxt "item_axe_gold_bloodlightning_uncooked_description"
msgid "The same mould, yet inclined to yield a more spectacular result... The frost shall reveal all, in time."
msgstr "Тая ж форма, але здольная прынесці значна ашаламляльнейшы плён ... Мароз расставіць усё па месцах, свайго часу."

#. [UA] "Майстерно викувана сокира для майстерної рубанини ворогів."
#. [PL] "Misterny plan pokonania wrogów wymaga topora o misternych detalach."
#. [RU] "Топор с тонкой отделкой для столь же тонкой расправы над врагами."
#, fuzzy
msgctxt "item_axe_gold_description"
msgid "A finely detailed axe, for finely cutting down your enemies."
msgstr "Вытанчана аздобленая сякера для вытанчанага секу ворагаў."

#. [UA] "Вогнекрижна сокира"
#. [PL] "Mroźnognisty topór"
#. [RU] "Топор льда и огня"
#, fuzzy
#| msgctxt "item_axe_bronze"
#| msgid "Bronze Axe"
msgctxt "item_axe_gold_frostfire"
msgid "Frostfire Axe"
msgstr "Сякера Зімняга Полымя"

#. [UA] "Спаліть усе до тла або заморозьте навіки в мить знищення…"
#. [PL] "Spal wszystko do gołej ziemi lub zamroź w wiecznej chwili
#. zniszczenia..."
#. [RU] "Сжигайте все дотла или замораживайте, увековечивая миг разрушения..."
#, fuzzy
msgctxt "item_axe_gold_frostfire_description"
msgid "Burn it all to the ground, or freeze it in an eternal moment of destruction..."
msgstr "Распай усё дашчэнту ці замразь у вечным імгненні знішчэння..."

#. [UA] "Заготовина: Вогнекрижна сокира"
#. [PL] "Odlew: mroźnognisty topór"
#. [RU] "Заготовка: топор льда и огня"
#, fuzzy
msgctxt "item_axe_gold_frostfire_uncooked"
msgid "Cast: Frostfire Axe"
msgstr "Загатоўка: Сякера Зімняга Полымя"

#. [UA] "Та сама форма, але результат буде набагато видовищнішим… З часом
#. мороз усе викаже."
#. [PL] "Ta sama forma, lecz może wydać coś o wiele bardziej
#. spektakularnego... Z biegiem czasu mróz wszystko ukaże."
#. [RU] "Хоть форма и осталась прежней, истинный потенциал стал куда более
#. впечатляющим... Со временем мороз раскрывает все, что скрыто."
msgctxt "item_axe_gold_frostfire_uncooked_description"
msgid "The same mould, yet inclined to yield a more spectacular result... The frost shall reveal all, in time."
msgstr "Тая ж форма, але здольная прынесці значна ашаламляльнейшы плён ... Мароз расставіць усё па месцах, свайго часу."

#. [UA] "Заготовина: Нордична сокира"
#. [PL] "Odlew: nordycki topór"
#. [RU] "Заготовка: нордский топор"
#, fuzzy
msgctxt "item_axe_gold_uncooked"
msgid "Cast: Nord Axe"
msgstr "Загатоўка: Нардычная сякера"

#. [UA] "Зброю потрібно загартувати морозом."
#. [PL] "Tę broń należy zahartować mrozem."
#. [RU] "Это оружие нужно закалить морозом."
msgctxt "item_axe_gold_uncooked_description"
msgid "This weapon needs to be hardened with frost."
msgstr "Гэтую зброю трэба загартоўваць марозам."

#. [UA] "Залізна сокира"
#. [PL] "Żelazny topór"
#. [RU] "Железный топор"
msgctxt "item_axe_iron"
msgid "Iron Axe"
msgstr "Жалезная сякера"

#. [UA] "Гостра й міцна подруга лісоруба."
#. [PL] "Ostry i wytrzymały przyjaciel drwala."
#. [RU] "Острый и крепкий, лучший друг дровосека."
msgctxt "item_axe_iron_description"
msgid "Sharp and strong, a woodcutter's friend."
msgstr "Вострая і моцная, найлепшая сяброўка дрывасека."

#. [UA] "Прокляття йотунів"
#. [PL] "Zguba Jotuna"
#. [RU] "Погибель йотунов"
msgctxt "item_axe_jotunbane"
msgid "Jotun Bane"
msgstr "Ётунава згуба"

#. [UA] "Отруйного удару цієї зброї боялися навіть велети минулих днів."
#. [PL] "Nawet zamierzchłe giganty nie przetrwałyby zatrutego ukąszenia tej
#. broni."
#. [RU] "Даже великаны древности не могли выдержать ядовитого укуса этого
#. оружия."
msgctxt "item_axe_jotunbane_description"
msgid "Not even the giants of old could weather the poisonous bite of this weapon."
msgstr "Нават волаты старажытнасці не маглі вытрымаць атрутнага ўкусу гэтай зброі."

#. [UA] "Іржава залізна сокира"
#. [RU] "Ржавый железный топор НЕ ИСПОЛЬЗУЕТСЯ"
msgctxt "item_axe_rusty"
msgid "Rusty iron axe UNUSED"
msgstr "Іржавая жалезная сякера НЕ ВЫКАРЫСТОЎАЕЦЦА"

#. [UA] "НЕ ВИКОРИСТОВУЄТЬСЯ"
#. [RU] "НЕ ИСПОЛЬЗУЕТСЯ"
msgctxt "item_axe_rusty_description"
msgid "UNUSED"
msgstr "НЕ ВЫКАРЫСТОЎВАЕЦЦА"

#. [UA] "Кам’яна сокира"
#. [PL] "Kamienny topór"
#. [RU] "Каменный топор"
msgctxt "item_axe_stone"
msgid "Stone Axe"
msgstr "Каменная сякера"

#. [UA] "Груба сокира для зрубування дерев."
#. [PL] "Prymitywny topór do ścinki drzew."
#. [RU] "Простенький топор для рубки дерева."
msgctxt "item_axe_stone_description"
msgid "A crude axe for tree-felling."
msgstr "Грубая сякера для ссякання дрэў."

#. [UA] "Дерев’яна сокира"
#. [PL] "Drewniany Topór"
#. [RU] "Деревянный топор"
msgctxt "item_axe_wood"
msgid "Wooden Axe"
msgstr "Драўляная сякера"

#. [UA] "Хіба не було б дивним, якби ця сокира могла рубати деревину?"
#. [PL] "Gdyby ten topór mógł rąbać drewno, nie było by to dziwne?"
#. [RU] "Было бы странно, если бы этот топор действительно рубил дрова, не так
#. ли?"
msgctxt "item_axe_wood_description"
msgid "If this axe could chop wood, wouldn't that be strange?"
msgstr "Калі б гэтай сякерай далося сячы дрэвы, хіба гэта не было б дзіўна?"

#. [UA] "Цікава голова сокири"
#. [PL] "Osobliwa głowica topora"
#. [RU] "Необычное лезвие топора"
msgctxt "item_axehead1"
msgid "Curious Axe Head"
msgstr "Нязвыклая наверша сякеры"

#. [UA] "Метал дивно виблискує на сонці. Звідкись ви розумієте, що сама себе
#. вона не складе…"
#. [PL] "Jej metal osobliwie lśni w blasku słońca. Z jakiegoś powodu wiesz, że
#. w pojedynkę nigdy nie będzie ukończona..."
#. [RU] "Металл странно отливает на солнце. Интуиция подсказывает: в одиночку
#. ему не обрести завершенности..."
msgctxt "item_axehead1_description"
msgid "The metal glints oddly in the sunlight. Somehow, you know that it can never be complete on its own..."
msgstr "Метал дзіўна паблісквае на сонца. З нейкай прычыны вы ведаеце, што адна гэта сякера ніколі не будзе цэльнай..."

#. [UA] "Загадкова голова сокири"
#. [PL] "Tajemnicza głowica topora"
#. [RU] "Загадочное лезвие топора"
msgctxt "item_axehead2"
msgid "Mysterious Axe Head"
msgstr "Таямнічае наверша сякеры"

#. [UA] "У яких битвах ця зброя мала участь? Минуле ви не побачите, а от
#. заготувати її майбутнє…"
#. [PL] "Jakie bitwy ujrzała ta broń? Nie potrafisz spojrzeć w jej przeszłość,
#. możesz tylko ukształtować jej przyszłość..."
#. [RU] "Какие битвы помнит это оружие? Его история утрачена, но судьба еще не
#. решена..."
msgctxt "item_axehead2_description"
msgid "What battles has this weapon borne witness to? You cannot see its past, only shape its future..."
msgstr "Сведкам якіх бітваў была гэта зброя? Вы не можаце ўбачыць ейнае мінулае, але ў стане вызначыць будучыню..."

#. [UA] "Удар у спину"
#. [PL] "Dźgnięcie w plecy"
#. [RU] "Удар в спину"
msgctxt "item_backstab"
msgid "Backstab"
msgstr "Удар у спіну"

#. [UA] "Запечений бульбейтир."
#. [PL] "Pieczony poteitr"
#. [RU] "Запеченный картофэйтр"
msgctxt "item_bakedpoteitr"
msgid "Baked Poteitr"
msgstr "Печаная бульба"

#. [UA] "Не варене, не товчене й не в рагу. Однак досі доволі смачно!"
#. [PL] "Ani gotowany, ani tłuczony, ani w gulaszu, ale nadal przepyszny!"
#. [RU] "Не вареный, не мятый и не покрошенный в похлебку. Но все равно
#. вкусный!"
msgctxt "item_bakedpoteitr_description"
msgid "Neither boiled nor mashed nor in a stew. Still delicious though!"
msgstr "Ні звараная, ні мятая, ні ў тушаная. Ды ўсё адно смаката!"

#. [UA] "Сирий бульбейтир."
#. [PL] "Nieupieczony poteitr"
#. [RU] "Сырой картофейтр"
msgctxt "item_bakedpoteitr_uncooked"
msgid "Unbaked Poteitr"
msgstr "Сырая бульба"

#. [UA] "Можна випікати."
#. [PL] "Czeka na upieczenie w piekarniku."
#. [RU] "Готов к запеканию."
#| msgctxt "item_breaddough_description"
#| msgid "Ready for the oven."
msgctxt "item_bakedpoteitr_uncooked_description"
msgid "Ready for the oven."
msgstr "Гатова да запякання."

#. [UA] "Набір цирюльників"
#. [PL] "Zestaw golibrody"
#. [RU] "Набор цирюльника"
msgctxt "item_barberkit"
msgid "Barber Kit"
msgstr "Набор цырульніка"

#. [UA] "Набір для майстрів-цирюльників."
#. [PL] "Zestaw dla najlepszych golibrodów."
#. [RU] "Рабочие инструменты искусного брадобрея."
msgctxt "item_barberkit_description"
msgid "A kit fit for the finest of barbers."
msgstr "Набор, варты найлепшага з цырульнікаў."

#. [UA] "Замерзла гілка"
#. [PL] "Zamrożona gałąź"
#. [RU] "Замерзшая ветвь"
msgctxt "item_barkabranch"
msgid "Frozen Branch"
msgstr "Змёрзлая галіна"

#. [UA] "Цей шматок деревини колись був сповненим життя та енергії. А зараз
#. лише дивні чари досі оточують його."
#. [PL] "Ten kawałek drewna został niegdyś powołany do życia. Nadal spowija je
#. przedziwne, magiczne powietrze."
#. [RU] "Этот кусок дерева когда-то был живым и полным энергии. До сих пор
#. вокруг него витает странная магия."
#, fuzzy
msgctxt "item_barkabranch_description"
msgid "This piece of wood was once animated and alive. Still a strange, magical air clings to it."
msgstr "Гэты кавалак дрэва некалі рухаўся і быў жывы. Да яго ўсё яшчэ ліпне дзіўная магічная атмасфера."

#. [UA] "Ячмінь"
#. [PL] "Jęczmień"
#. [RU] "Ячмень"
msgctxt "item_barley"
msgid "Barley"
msgstr "Ячмень"

#. [UA] "Жмут ячменю."
#. [PL] "Wiązka jęczmienia."
#. [RU] "Горсть ячменя."
msgctxt "item_barley_description"
msgid "A bundle of barley."
msgstr "Пучок ячменю."

#. [UA] "Ячмінне борошно"
#. [PL] "Maka jęczmienna"
#. [RU] "Ячменная мука"
msgctxt "item_barleyflour"
msgid "Barley Flour"
msgstr "Ячменная мука"

#. [UA] "Підходить для випікання хліба."
#. [PL] "Doskonale nadaje się do wypiekania chleba."
#. [RU] "Подходит для выпечки хлеба."
msgctxt "item_barleyflour_description"
msgid "Great for baking bread."
msgstr "З яе пячэцца цудоўны хлеб."

#. [UA] "Ячмінне вино опору вогню"
#. [PL] "Wino jęczmienne ognioodporności"
#. [RU] "Огненное ячменное вино"
msgctxt "item_barleywine"
msgid "Fire Resistance Barley Wine"
msgstr "Вогнеўстойлівае ячменнае віно"

#. [UA] "Не дає вам згоріти живцем."
#. [PL] "Sprawia cię odpornym na ogień."
#. [RU] "Защищает от огня."
msgctxt "item_barleywine_description"
msgid "Fortifies you against fire."
msgstr "Ахоўвае вас ад агню."

#. [UA] "Основа ячмінного вина: опір вогню"
#. [PL] "Zacier wina jęczmiennego: Ognioodporność"
#. [RU] "Основа ячменного вина: огнестойкость"
msgctxt "item_barleywinebase"
msgid "Barley Wine Base: Fire Resistance"
msgstr "Аснова ячменнага віна: Вогнеўстойлівасць"

#. [UA] "Обручі для діжки"
#. [PL] "Obręcze beczek"
#. [RU] "Обручи для бочек"
msgctxt "item_barrelrings"
msgid "Barrel Hoops"
msgstr "Бочкавыя абручы"

#. [UA] "Ці металеві вироби мають форму ідеального кільця. Чудово підійдуть
#. для скріплення діжки. Лише деревину додайте!"
#. [PL] "Te metalowe obręcze są idealnie okrągłe i służą do łączenia beczek.
#. Wystarczy dodać drewno!"
#. [RU] "Эти идеально круглые обручи отлично подходят для бочек. Просто
#. приколотите к ним доски!"
msgctxt "item_barrelrings_description"
msgid "These metal rings are perfectly round, suitable for holding a barrel together. Just add wood!"
msgstr "Гэтыя ідэальна круглыя абручы выдатна пасуюць, каб змацаваць бочку. Проста дадайце дрэва!"

#. [UA] "Бойова сокира"
#. [PL] "Topór bitewny"
#. [RU] "Боевой топор"
msgctxt "item_battleaxe"
msgid "Battleaxe"
msgstr "Баявая сякера"

#. [UA] "Чорнометалева бойова сокира"
#. [PL] "Topór bitewny z czarnego metalu"
#. [RU] "Боевой топор из черного металла"
msgctxt "item_battleaxe_blackmetal"
msgid "Black Metal Battleaxe"
msgstr "Баявая сякера з чорнага металу"

#. [UA] "Зелений відтінок має стати останнім, що побачать вороги, перш ніж ви
#. розрубаєте їх навпіл."
#. [PL] "Zieleń będzie ostatnią rzeczą ujrzaną przez twych wrogów, zanim
#. rozetniesz ich na pół."
#. [RU] "Зеленый — последнее, что увидят ваши враги, прежде чем их разрубят на
#. части."
msgctxt "item_battleaxe_blackmetal_description"
msgid "Green shall be the last thing your foes see before you cleave them in half."
msgstr "Зелень металу будзе апошнім, што ўбачаць ворагі, перш чым іх рассякуць напалову."

#. [UA] "Кришталева бойова сокира"
#. [PL] "Kryształowy topór bitewny"
#. [RU] "Кристальный боевой топор"
msgctxt "item_battleaxe_crystal"
msgid "Crystal Battleaxe"
msgstr "Крышталёвая баявая сякера"

#. [UA] "Дивишся крізь неї, а потім нею ж і розрубуєш навпіл."
#. [PL] "Przezroczysta, przebijająca ciało broń."
#. [RU] "Столь прозрачный, что сквозь него видны слезы жертвы."
msgctxt "item_battleaxe_crystal_description"
msgid "It's see-through and tears through."
msgstr "Скрозь лязо можна пабачыць слёзы тых, каго працінаеш наскрозь."

#. [UA] "Розколює черепи на раз — усім воїнам на втіху."
#. [PL] "Łamacz czaszek stanowiący dumę wojownika."
#. [RU] "Разрушитель черепов, радость воина."
msgctxt "item_battleaxe_description"
msgid "Skull-splitter, a warrior's joy."
msgstr "Расколвае чарапы на радасць ваярам."

#. [UA] "Заготовина: Нордичний топір"
#. [PL] "Odlew: nordycki topór dwuręczny"
#. [RU] "Заготовка: нордская секира"
msgctxt "item_battleaxe_gold_uncooked"
msgid "Cast: Nord Greataxe"
msgstr "Загатоўка: Нардычная аберучная сякера"

#. [UA] "Зброю потрібно загартувати морозом."
#. [PL] "Tę broń należy zahartować mrozem."
#. [RU] "Это оружие нужно закалить морозом."
msgctxt "item_battleaxe_gold_uncooked_description"
msgid "This weapon needs to be hardened with frost."
msgstr "Гэтую зброю трэба загартоўваць марозам."

#. [UA] "Череполам"
#. [PL] "Łamiczerep"
#. [RU] "Крушитель черепов"
msgctxt "item_battleaxe_skullsplittur"
msgid "Skull Splittur"
msgstr "Чарапакол"

#. [UA] "У найгустішій імлі знайде черепи, які можна проломити."
#. [PL] "Znajdzie czaszki do rozłupania nawet w najgęstszej mgle."
#. [RU] "Способен разрубать черепа даже в самых густых туманах."
msgctxt "item_battleaxe_skullsplittur_description"
msgid "Will find skulls to split even in the thickest of mists."
msgstr "Знойдзе, якія чарапы раскалоць, нават у найгусцейшым з туманаў."

#. [UA] "Дерев’яна бойова сокира"
#. [PL] "Drewniany Topór Bitewny"
#. [RU] "Деревянный боевой топор"
msgctxt "item_battleaxe_wood"
msgid "Wooden Battleaxe"
msgstr "Драўляная баявая сякера"

#. [UA] "Справляє враження, але не таке, як справжня зброя."
#. [PL] "Wygląda groźnie, ale nie tak groźnie jak prawdziwy."
#. [RU] "Пугает, но не так, как настоящий."
msgctxt "item_battleaxe_wood_description"
msgid "Intimidating, but not as intimidating as the real thing."
msgstr "Палохае, але зусім не так, як сапраўдная."

#. [UA] "Насіння бука"
#. [PL] "Nasiona buka"
#. [RU] "Семена бука"
msgctxt "item_beechseeds"
msgid "Beech Seeds"
msgstr "Насенне бука"

#. [UA] "Посадіть, щоби виростити бук."
#. [PL] "Zasadź je, aby wyrósł z nich buk."
#. [RU] "Посадите в землю, чтобы вырастить бук."
msgctxt "item_beechseeds_description"
msgid "Plant them to grow a beech tree."
msgstr "Пасадзіце, каб з яго вырас бук."

#. [UA] "Дзвін"
#. [PL] "Dzwon"
#. [RU] "Колокол"
msgctxt "item_bell"
msgid "Bell"
msgstr "Звон"

#. [UA] "По кому подзвін?"
#. [PL] "Komu bije ten dzwon?"
#. [RU] "По ком звонит колокол?"
msgctxt "item_bell_description"
msgid "For whom does the bell toll?"
msgstr "Па кім звоніць звон?"

#. [UA] "Уламок дзвону"
#. [PL] "Fragment dzwonu"
#. [RU] "Фрагмент колокола"
msgctxt "item_bellfragment"
msgid "Bell Fragment"
msgstr "Фрагмент звона"

#. [UA] "Прадавній уламок. Може бути частиною розбитого дзвона…"
#. [PL] "Pradawny fragment był chyba częścią rozbitego dzwonu..."
#. [RU] "Древний осколок когда-то был частью колокола..."
msgctxt "item_bellfragment_description"
msgid "This ancient fragment appears to be a piece of a broken bell..."
msgstr "Старажытны аскепак, які, відаць, ёсць фрагментам разбітага звона..."

#. [UA] "Меґінґйорд"
#. [PL] "Megingjord"
#. [RU] "Мегингьорд"
msgctxt "item_beltstrength"
msgid "Megingjord"
msgstr "Mэгінг’ёрд"

#. [UA] "Надає власникові надлюдську силу."
#. [PL] "Nałożony zapewnia nadludzką siłę."
#. [RU] "Дает владельцу нечеловеческую силу."
msgctxt "item_beltstrength_description"
msgid "Gives the wearer superhuman strength."
msgstr "Надае ўладальніку звышчалавечую сілу."

#. [UA] "Жовчний міхур"
#. [PL] "Worek żółciowy"
#. [RU] "Желчный мешок"
msgctxt "item_bilebag"
msgid "Bilebag"
msgstr "Жоўцевы мяшочак"

#. [UA] "Їдка жовч, витягнута з тіла ґьялла."
#. [PL] "Żrąca żółć zaczerpnięta z truchła gjalla."
#. [RU] "Едкая желчь, извлеченная из трупа гьялля."
msgctxt "item_bilebag_description"
msgid "Caustic bile drawn from the corpse of a gjall."
msgstr "Едкая жоўць, выцягнутая з трупа г’яля."

#. [UA] "Жовчна бомба"
#. [PL] "Żrąca bomba"
#. [RU] "Желчная бомба"
msgctxt "item_bilebomb"
msgid "Bile Bomb"
msgstr "Жоўцевая бомба"

#. [UA] "Поводьтеся обережно."
#. [PL] "Trzymaj uważnie."
#. [RU] "Обращаться осторожно."
msgctxt "item_bilebomb_description"
msgid "Handle with care."
msgstr "Карыстайцеся з асцярожнасцю."

#. [UA] "Насіння берези"
#. [PL] "Nasiona brzozy"
#. [RU] "Семена березы"
msgctxt "item_birchseeds"
msgid "Birch Seeds"
msgstr "Насенне бярозы"

#. [UA] "Посадіть, щоби виростити березу."
#. [PL] "Zasadź je, aby wyrosła z nich brzoza."
#. [RU] "Посадите в землю, чтобы вырастить березу."
msgctxt "item_birchseeds_description"
msgid "Plant them to grow a birch tree."
msgstr "Пасадзіце, каб з яго вырасла бяроза."

#. [UA] "М’ясо ведмедя"
#. [PL] "Mięso Niedźwiedzia"
#. [RU] "Медвежье мясо"
msgctxt "item_bjorn_meat"
msgid "Bear Meat"
msgstr "Мядзведзіна"

#. [UA] "Смажене м’ясо ведмедя"
#. [PL] "Pieczone Mięso Niedźwiedzia"
#. [RU] "Приготовленное медвежье мясо"
msgctxt "item_bjorn_meat_cooked"
msgid "Cooked Bear Meat"
msgstr "Печаная мядзведзіна"

#. [UA] "Смак перемоги."
#. [PL] "Smakuje jak zwycięstwo."
#. [RU] "Вкус победы."
msgctxt "item_bjorn_meat_cooked_description"
msgid "Tastes like victory."
msgstr "Смак перамогі."

#. [UA] "Жир у цьому м’ясі мав допомогти тілу витримати тривалу сплячку."
#. [PL] "To tłuste mięso miało kiedyś odżywiać ciało podczas hibernacji."
#. [RU] "Когда-то это жирное мясо позволяло зверю всю зиму провести в спячке."
msgctxt "item_bjorn_meat_description"
msgid "This fatty meat was once meant to sustain a body through hibernation."
msgstr "Тлустае мяса, якое калісь дазваляла ператрываць зімнюю спячку."

#. [UA] "Ведмежа шкура"
#. [PL] "Skóra Niedźwiedzia"
#. [RU] "Медвежья шкура"
msgctxt "item_bjornhide"
msgid "Bear Hide"
msgstr "Мядзведжая шкура"

#. [UA] "Товста й кудлата шкура. Груба, однак водночас і надзвичайно м’яка."
#. [PL] "Grube i kosmate futro. Szorstkie, a jednak niesamowicie miękkie."
#. [RU] "Плотная шкура с грубым, но удивительно мягким мехом."
msgctxt "item_bjornhide_description"
msgid "A thick and furry hide, coarse yet incredibly soft."
msgstr "Тоўстая і пухнатая скура. Грубая, але неверагодна мяккая."

#. [UA] "Ведмежа лапа"
#. [PL] "Łapa Niedźwiedzia"
#. [RU] "Медвежья лапа"
msgctxt "item_bjornpaw"
msgid "Bear Paw"
msgstr "Мядзведжая лапа"

#. [UA] "Гострі пазурі підійдуть для збору ягід… або відривання кінцівок."
#. [PL] "Ostre pazury odpowiednie do zbierania jagód – lub rozczłonkowywania."
#. [RU] "Острыми когтями удобно собирать ягоды — или вспарывать врагов."
msgctxt "item_bjornpaw_description"
msgid "Sharp claws suitable for picking berries – or for dismembering."
msgstr "Вострыя пазуры, прыдатныя або для збору ягад, або для расчлянення."

#. [UA] "Чорне ядро"
#. [PL] "Czarny rdzeń"
#. [RU] "Черное ядро"
msgctxt "item_blackcore"
msgid "Black Core"
msgstr "Чорнае ядро"

#. [UA] "Вщерть сповнене прадавньою силою."
#. [PL] "Wypełniony po brzegi starożytną mocą."
#. [RU] "Сочится древней магией."
msgctxt "item_blackcore_description"
msgid "Filled to the brim with ancient power."
msgstr "Да краёў напоўнена старажытнай моцай."

#. [UA] "Чорний мармур"
#. [PL] "Czarny marmur"
#. [RU] "Черный мрамор"
msgctxt "item_blackmarble"
msgid "Black Marble"
msgstr "Чорны мармур"

#. [UA] "Блок міцного каменю, пронизаного мереживом із жилок, що змінюють
#. колір."
#. [PL] "Blok solidnego kamienia, zabliźniony mieniącymi się kolorami."
#. [RU] "Блок твердого камня, прошитый меняющимися цветами."
msgctxt "item_blackmarble_description"
msgid "A block of solid stone, seamed with shifting colors."
msgstr "Блок цвёрдага каменя, кожны з пластоў якога мае адметнае адценне."

#. [UA] "Чорний метал"
#. [PL] "Czarny metal"
#. [RU] "Черный металл"
msgctxt "item_blackmetal"
msgid "Black Metal"
msgstr "Чорны метал"

#. [UA] "Важкий зливок темного металу."
#. [PL] "Ciężka sztabka ciemnego metalu."
#. [RU] "Тяжелый слиток черного металла."
msgctxt "item_blackmetal_description"
msgid "A heavy bar of dark metal."
msgstr "Цяжкі злітак цёмнага металу."

#. [UA] "Чорнометалевий брухт"
#. [PL] "Złom z czarnego metalu"
#. [RU] "Кусок черного металла"
msgctxt "item_blackmetalscrap"
msgid "Black Metal Scrap"
msgstr "Абломак чорнага металу"

#. [UA] "Покручені шматки чорного металу."
#. [PL] "Skręcony kawałek ciemnego metalu."
#. [RU] "Искривленный кусок темного металла."
msgctxt "item_blackmetalscrap_description"
msgid "A twisted hunk of dark metal."
msgstr "Скрыўлены кавалак цёмнага металу."

#. [UA] "Чорна юшка"
#. [PL] "Czarna zupa"
#. [RU] "Черный суп"
msgctxt "item_blacksoup"
msgid "Black Soup"
msgstr "Чорны суп"

#. [UA] "Ідеальна рівновага солодкого та кислого."
#. [PL] "Idealne połączenie słodkiego i kwaśnego smaku."
#. [RU] "Кислота и сладость. Идеальное сочетание!"
msgctxt "item_blacksoup_description"
msgid "A perfect balance of sweetness and acidity."
msgstr "Ідэальны баланс слодычы і кіслотнасці."

#. [UA] "Попелиста деревина"
#. [PL] "Zgliszczak"
#. [RU] "Пепельная древесина"
msgctxt "item_blackwood"
msgid "Ashwood"
msgstr "Попельная драўніна"

#. [UA] "Деревина, зміцнена вогнем та попелом."
#. [PL] "Drewno utwardzone przez ogień i popiół."
#. [RU] "Древесина, закаленная огнем и пеплом."
msgctxt "item_blackwood_description"
msgid "Wood hardened by fire and ash."
msgstr "Драўніна, загартаваная агнём і попелам."

#. [UA] "Закорокований флакон"
#. [PL] "Zatkana Fiolka"
#. [RU] "Флакон с пробкой"
msgctxt "item_blobvial"
msgid "Corked Vial"
msgstr "Закаркаваны флакон"

#. [UA] "Достатньо міцний для вмісту чогось леткого, але достатньо легко
#. розбивається."
#. [PL] "Wystarczająco gruba, by uwięzić coś szkodliwego, a jednak na tyle
#. krucha, by ją rozbić."
#. [RU] "Прочный сосуд для бурной силы, и в то же время стекло, готовое
#. расколоться."
msgctxt "item_blobvial_description"
msgid "Thick enough to contain something volatile, yet fragile enough to be shattered."
msgstr "З сценкамі дастаткова тоўстымі, каб змясціць нешта шкадлівае, але і дастаткова далікатнымі, каб яго можна было разбіць."

#. [UA] "Блокування шкоди"
#. [PL] "Siła pancerza"
#. [RU] "Сопротивление урону"
msgctxt "item_blockarmor"
msgid "Block armour"
msgstr "Блакаванне пашкоджання"

#. [UA] "Сила відкидання"
#. [PL] "Siła bloku"
#. [RU] "Сопротивление силе"
msgctxt "item_blockforce"
msgid "Block force"
msgstr "Моц блакавання"

#. [UA] "Сила блокування"
#. [PL] "Siła blokowania"
#. [RU] "Сила блокирования"
msgctxt "item_blockpower"
msgid "Block power"
msgstr "Сіла блакавання"

#. [UA] "Мішечок крові"
#. [PL] "Worek krwi"
#. [RU] "Туша"
msgctxt "item_bloodbag"
msgid "Bloodbag"
msgstr "Мяшочак крыві"

#. [UA] "Нутрощі п’явки. Тьху!"
#. [PL] "Wnętrzności pijawki. Fuj!"
#. [RU] "Кровавое месиво. Фу!"
msgctxt "item_bloodbag_description"
msgid "The contents of a leech. Ick!"
msgstr "Вантробы п'яўкі. Фу!"

#. [UA] "Тромб"
#. [PL] "Zakrzep"
#. [RU] "Кровавый сгусток"
msgctxt "item_bloodclot"
msgid "Blood Clot"
msgstr "Згустак крыві"

#. [UA] "Обережно, не пробийте, поки нестимете…"
#. [PL] "Uważaj, by tego nie przebić podczas przenoszenia..."
#. [RU] "Будьте осторожны, чтобы не проколоть его, пока вы его носите..."
msgctxt "item_bloodclot_description"
msgid "Be careful not to puncture this while you carry it..."
msgstr "Асцярожна, не пракаліце яго падчас пераноскі..."

#. [UA] "Хитромудрий ключ"
#. [PL] "Misterny klucz"
#. [RU] "Сложный ключ"
msgctxt "item_bloodgoldkey"
msgid "Intricate Key"
msgstr "Мудрагелісты ключ"

#. [UA] "Якщо є ключ, то десь точно має бути замок."
#. [PL] "Jeśli jest klucz, to na pewno jest też i zamek."
#. [RU] "Если есть ключ, значит, где-то есть и замок."
msgctxt "item_bloodgoldkey_description"
msgid "If there's a key, then surely there must be a lock."
msgstr "Калі ёсць ключ, значыць, мусіць быць і замок."

#. [UA] "Кров’янка"
#. [PL] "Kaszanka"
#. [RU] "Кровяная колбаса"
msgctxt "item_bloodpudding"
msgid "Blood Pudding"
msgstr "Крывянка"

#. [UA] "Смачно, що аж кров із пальчиків оближеш."
#. [PL] "Krwisty kąsek."
#. [RU] "Чертовски вкусная."
msgctxt "item_bloodpudding_description"
msgid "It's bloody tasty."
msgstr "Ад яе смаку аж кроў бурліць."

#. [UA] "Жир ластонога"
#. [PL] "Słonina z foki"
#. [RU] "Жир тюленя"
msgctxt "item_blubber"
msgid "Seal Blubber"
msgstr "Цюленевы тлушч"

#. [UA] "Витоплений жир ластонога"
#. [PL] "Pieczona słonina z foki"
#. [RU] "Приготовленный тюлений жир"
msgctxt "item_blubber_cooked"
msgid "Cooked Seal Blubber"
msgstr "Печаны цюленевы тлушч"

#. [UA] "Жорстке для жування м’ясо, має посмак каяття."
#. [PL] "Żylaste mięso o posmaku skruchy."
#. [RU] "Жесткое мясо с привкусом сожаления."
#, fuzzy
msgctxt "item_blubber_cooked_description"
msgid "A chewy meat, with an aftertaste of remorse."
msgstr "Даўкае мяса з прысмакам каяння."

#. [UA] "Жирова зігрівальна тканина істоти, яка адаптувалася до північних
#. холодних вод."
#. [PL] "Izolacyjny tłuszcz stworzenia przystosowanego do północnych wód."
#. [RU] "Утепляющий жир животного, приспособленного к северным водам."
#, fuzzy
msgctxt "item_blubber_description"
msgid "The insulating fat of a creature adapted to the northern waters."
msgstr "Уцяпляльны тлушч істоты, прыстасаванай да паўночных водаў."

#. [UA] "Чорниця"
#. [PL] "Jagody"
#. [RU] "Черника"
msgctxt "item_blueberries"
msgid "Blueberries"
msgstr "Чарніцы"

#. [UA] "Маленька і смачненька."
#. [PL] "Niewielkie, lecz smaczne."
#. [RU] "Маленькие вкусные ягодки."
msgctxt "item_blueberries_description"
msgid "Tiny but tasty."
msgstr "Маленькія, затое смачныя."

#. [UA] "М’ясо вепра"
#. [PL] "Mięso dzika"
#. [RU] "Кабанина"
msgctxt "item_boar_meat"
msgid "Boar Meat"
msgstr "Дзічына"

#. [UA] "Смажене м’ясо вепра"
#. [PL] "Pieczone mięso dzika"
#. [RU] "Приготовленная кабанина"
msgctxt "item_boar_meat_cooked"
msgid "Cooked Boar Meat"
msgstr "Печаная дзічына"

#. [UA] "Землистий смак."
#. [PL] "Ziemisty posmak."
#. [RU] "С привкусом земли."
msgctxt "item_boar_meat_cooked_description"
msgid "An earthly taste."
msgstr "Мае зямлісты посмак."

#. [UA] "В’ялена вепрятина"
#. [PL] "Suszone mięso dzika"
#. [RU] "Вяленая кабанина"
msgctxt "item_boarjerky"
msgid "Boar Jerky"
msgstr "Вэнджаная дзічына"

#. [UA] "Суха й солона."
#. [PL] "Chude i słone."
#. [RU] "Постный и соленый."
msgctxt "item_boarjerky_description"
msgid "Lean and salty."
msgstr "Салёная і нятлустая."

#. [UA] "Чорнометалевий болт"
#. [PL] "Bełt z czarnego metalu"
#. [RU] "Болт из черного металла"
msgctxt "item_bolt_blackmetal"
msgid "Black Metal Bolt"
msgstr "Болт з чорнага металу"

#. [UA] "Гладкий болт із темного металу."
#. [PL] "Lśniący bełt z ciemnego metalu."
#. [RU] "Гладкий болт из черного металла."
msgctxt "item_bolt_blackmetal_description"
msgid "A sleek bolt of dark metal."
msgstr "Гладкі болт з цёмнага металу."

#. [UA] "Кровозлотний болт"
#. [PL] "Bełt z krwawego złota"
#. [RU] "Болт из кровавого золота"
#, fuzzy
#| msgctxt "item_bloodclot"
#| msgid "Blood Clot"
msgctxt "item_bolt_bloodgold"
msgid "Bloodgold Bolt"
msgstr "Крывазолаты болт"

#. [UA] "Болт, викуваний либонь із найтвердіших матеріалів у цьому світі…"
#. [PL] "Bełt wykuty z prawdopodobnie najtwardszego materiału na świecie..."
#. [RU] "Болт, выкованный, быть может, из самых твердых материалов в этом
#. мире..."
#, fuzzy
msgctxt "item_bolt_bloodgold_description"
msgid "A bolt forged of perhaps the hardest materials in this world..."
msgstr "Болт, скаваны з, магчыма, найцвярдзейшых матэрыялаў гэтага свету..."

#. [UA] "Кістяний болт"
#. [PL] "Kościany bełt"
#. [RU] "Костяной болт"
msgctxt "item_bolt_bone"
msgid "Bone Bolt"
msgstr "Касцяны болт"

#. [UA] "Грубий болт із жовтуватої кістки."
#. [PL] "Toporny bełt z pożółkłej kości."
#. [RU] "Грубый болт из пожелтевшей кости."
msgctxt "item_bolt_bone_description"
msgid "A crude bolt of yellowed bone."
msgstr "Грубы болт з пажоўклай косткі."

#. [UA] "Хітиновий болт"
#. [PL] "Bełt z pancerza"
#. [RU] "Панцирный болт"
msgctxt "item_bolt_carapace"
msgid "Carapace Bolt"
msgstr "Хіцінавы болт"

#. [UA] "Важкий і міцний болт."
#. [PL] "Ciężki i solidny bełt."
#. [RU] "Тяжелый и прочный болт."
msgctxt "item_bolt_carapace_description"
msgid "A heavy and solid bolt."
msgstr "Цяжкі і трывалы болт."

#. [UA] "Обвуглений болт"
#. [PL] "Zwęglony bełt"
#. [RU] "Обугленный болт"
msgctxt "item_bolt_charred"
msgid "Charred Bolt"
msgstr "Абвуглены болт"

#. [UA] "Твердій кістці з передпліччя надали форму смертоносного болта."
#. [PL] "Solidna kość przedramienia przerobiona na śmiercionośny bełt."
#. [RU] "Твердая локтевая кость обточена и превращена в смертоносный болт."
msgctxt "item_bolt_charred_description"
msgid "A sturdy bone from a forearm, shaped into a deadly bolt."
msgstr "Трывалая лакцявіца, пераробленая ў смертаносны болт."

#. [UA] "Залізний болт"
#. [PL] "Żelazny bełt"
#. [RU] "Железный болт"
msgctxt "item_bolt_iron"
msgid "Iron Bolt"
msgstr "Жалезны болт"

#. [UA] "Міцний залізний снаряд."
#. [PL] "Solidny żelazny pocisk."
#. [RU] "Прочный железный снаряд."
msgctxt "item_bolt_iron_description"
msgid "A sturdy iron missile."
msgstr "Трывалы жалезны снарад."

#. [UA] "Жаринковий заряд"
#. [PL] "Żarowy ładunek"
#. [RU] "Угольный заряд"
#, fuzzy
#| msgctxt "item_amberpearl"
#| msgid "Amber Pearl"
msgctxt "item_bomb_dynamite"
msgid "Ember Charge"
msgstr "Жаравы зарад"

#. [UA] "Замкнене скупчення жаринок, які готові розірватися іскрами.
#. Поводитися з обачністю."
#. [PL] "Gotowy do wybuchu uwięziony żar. Zaleca się ostrożność."
#. [RU] "Заключенные внутри угли вот-вот взорвутся. Будьте осторожны."
#, fuzzy
msgctxt "item_bomb_dynamite_description"
msgid "Trapped embers, ready to burst. Caution is advised."
msgstr "Зняволены жар, гатовы выбухнуць. Рэкамендуецца асцярожнасць."

#. [UA] "Флакон із кригою"
#. [PL] "Szlambomba: Mróz"
#. [RU] "Сгустень-бомба: Лед"
msgctxt "item_bombblob_frost"
msgid "Blob Bomb: Frost"
msgstr "Кроплебомба: Мароз"

#. [UA] "Якщо тримати занадто довго, то можна відморозити руки."
#. [PL] "Jak potrzymasz ją za długo, to przymarznie ci dłoń."
#. [RU] "Если слишком долго держать этот флакон, рука превратится в ледышку."
msgctxt "item_bombblob_frost_description"
msgid "If you hold it for too long your hand might just freeze in place."
msgstr "Калі трымаць яе задоўга, рука можа прымерзнуць."

#. [UA] "Флакон із лавою"
#. [PL] "Szlambomba: Lawa"
#. [RU] "Сгустень-бомба: Лава"
msgctxt "item_bombblob_lava"
msgid "Blob Bomb: Lava"
msgstr "Кроплебомба: Лава"

#. [UA] "Відчувається жар, який може породити руйнівний вогневир."
#. [PL] "Fiolka pali w dłonie, obiecując ognistą zagładę."
#. [RU] "Флакон жжет ладонь, суля огненное разрушение."
msgctxt "item_bombblob_lava_description"
msgid "The vial is hot in your hand, promising fiery destruction."
msgstr "Флакон награваецца ў руцэ, абяцаючы палымянае вынішчэнне."

#. [UA] "Флакон із пульпаком"
#. [PL] "Śluzobomba: pulpa"
#. [RU] "Сгустень-бомба: масса"
#, fuzzy
#| msgctxt "item_bombblob_tar"
#| msgid "Blob Bomb: Tar"
msgctxt "item_bombblob_morkhalla"
msgid "Blob Bomb: Pulp"
msgstr "Кроплебомба: Мякаць"

#. [UA] "Де є пульпаки, там і підземелля."
#. [PL] "Loch znajduje się tam, gdzie śluz."
#. [RU] "Где сгустень, там и подземелье."
msgctxt "item_bombblob_morkhalla_description"
msgid "A dungeon is where the blob is."
msgstr "Дзе падзямелле, там і кроплі."

#. [UA] "Флакон з отрутою"
#. [PL] "Szlambomba: Trucizna"
#. [RU] "Сгустень-бомба: Яд"
msgctxt "item_bombblob_poison"
msgid "Blob Bomb: Poison"
msgstr "Кроплебомба: Атрута"

#. [UA] "Якщо флакон трісне, то будьте дуже обережні."
#. [PL] "Gdyby pękła, stanowczo wskazana jest ostrożność."
#. [RU] "Если флакон разобьется, лучше отбежать подальше."
msgctxt "item_bombblob_poison_description"
msgid "Should this vial break, caution is strongly advised."
msgstr "Варта гэтаму флакону разбіцца — аніякая тэхніка бяспекі не паможа."

#. [UA] "Флакон із добірною отрутою"
#. [PL] "Szlambomba: Elitarna Trucizna"
#. [RU] "Сгустень-бомба: Элитный яд"
msgctxt "item_bombblob_poisonelite"
msgid "Blob Bomb: Elite Poison"
msgstr "Кроплебомба: Адборная атрута"

#. [UA] "Вдихати пари дуже не рекомендовано."
#. [PL] "Wdychanie oparów jest niewskazane."
#. [RU] "Вдыхать пары крайне не рекомендуется."
msgctxt "item_bombblob_poisonelite_description"
msgid "Breathing in the fumes is not recommended."
msgstr "Удыхаць ейныя выпарэнні не рэкамендуецца."

#. [UA] "Флакон зі смолою"
#. [PL] "Szlambomba: Smoła"
#. [RU] "Сгустень-бомба: Деготь"
msgctxt "item_bombblob_tar"
msgid "Blob Bomb: Tar"
msgstr "Кроплебомба: Дзёгаць"

#. [UA] "Липка речовина пульсує всередині, наче погрожуючи."
#. [PL] "Lepka substancja wewnątrz pulsuje, jakby chciała ci zagrozić."
#. [RU] "Липкая субстанция внутри угрожающе пульсирует."
msgctxt "item_bombblob_tar_description"
msgid "The sticky substance within pulses, as if threatening you."
msgstr "Ліпкая субстанцыя ўнутры пульсуе, быццам камусь пагражаючы."

#. [UA] "Уламки кісток"
#. [PL] "Fragmenty kości"
#. [RU] "Обломки костей"
msgctxt "item_bonefragments"
msgid "Bone Fragments"
msgstr "Кавалкі костак"

#. [UA] "Купа розтрощених кісток."
#. [PL] "Stos połamanych kości."
#. [RU] "Куча раздробленных костей."
msgctxt "item_bonefragments_description"
msgid "A pile of shattered bones."
msgstr "Купа раструшчаных костак."

#. [UA] "М’ясо кісткозмія"
#. [PL] "Mięso gnatogniota"
#. [RU] "Мясо Костепасти"
msgctxt "item_bonemawmeat"
msgid "Bonemaw Meat"
msgstr "Мяса косцепашчы"

#. [UA] "Смажене м’ясо кісткозмія"
#. [PL] "Ugotowane mięso gnatogniota"
#. [RU] "Приготовленное мясо Костепасти"
msgctxt "item_bonemawmeat_cooked"
msgid "Cooked Bonemaw Meat"
msgstr "Печанае мяса косцепашчы"

#. [UA] "Кипляче море нічого з м’ясом не зробило, але запікання над вогнем
#. додає хрусткої смакоти."
#. [PL] "Wrzące morze nie zmieniło tego mięsa, ale opiekanie nad otwartym
#. ogniem nadało mu miłej chrupkości."
#. [RU] "Кипящее море никак не сказалось на мясе рыбы, а вот на огне оно стало
#. удивительно хрустящим."
msgctxt "item_bonemawmeat_cooked_description"
msgid "The boiling sea did nothing to this meat, but grilling it over the fire has given it a delightful crisp."
msgstr "Кіпучае мора аніяк не паўплывала на гэтае мяса, аднак па смажанні на агні яно атрымала хрусткую скарынку."

#. [UA] "Смачне м’ясо, подібне білій рибі. Дуже поживне для кісток!"
#. [PL] "Smaczne, białe rybie mięso. Świetnie wpływa na kości!"
#. [RU] "Вкусная белая рыба. Очень полезно для костей!"
msgctxt "item_bonemawmeat_description"
msgid "A tasty, white fish meat. Very good for your bones!"
msgstr "Смачнае белае мяса рыбы. Надзвычай карыснае для касцей!"

#. [UA] "Луска кісткозмія"
#. [PL] "Łuska gnatogniota"
#. [RU] "Чешуя Костепасти"
msgctxt "item_bonemawscale"
msgid "Bonemaw Scale"
msgstr "Луска косцепашчы"

#. [UA] "Схожа на звичайну кістку… але ліпше довго не мізкувати над будовою
#. цієї істоти…"
#. [PL] "Wygląda jak kość. Lepiej nie zgłębiać anatomii tego stwora..."
#. [RU] "Выглядит ну точно как кость. О деталях анатомии этой твари лучше не
#. задумываться..."
msgctxt "item_bonemawscale_description"
msgid "It looks just like bone. Best not to question the anatomy of this creature too much..."
msgstr "Выглядае, як звычайная косць. Лепш не задавацца пытаннямі пра анатомію гэтых істот..."

#. [UA] "Зуб кісткозмія"
#. [PL] "Ząb gnatogniota"
#. [RU] "Зуб Костепасти"
msgctxt "item_bonemawtooth"
msgid "Bonemaw Tooth"
msgstr "Зуб косцепашчы"

#. [UA] "Від цієї штуки загинуло чимало відважних мореплавців."
#. [PL] "Zgniótł wielu dzielnych żeglarzy."
#. [RU] "Много храбрых моряков загубил этот зуб."
msgctxt "item_bonemawtooth_description"
msgid "This has caused the death of many a brave sailor."
msgstr "Шмат добрых маракоў палягло да гэтых зубоў."

#. [UA] "Грубий лук"
#. [PL] "Krótki łuk"
#. [RU] "Грубый лук"
msgctxt "item_bow"
msgid "Crude Bow"
msgstr "Грубы лук"

#. [UA] "Попелисте Ікло"
#. [PL] "Popielny kieł"
#. [RU] "Пепельный клык"
msgctxt "item_bow_ashlands"
msgid "Ash Fang"
msgstr "Попельны лук"

#. [UA] "Цей лук знайшли серед попелу. Його сила надпотужна."
#. [PL] "Powstały z popiołów łuk ma ogromną siłę."
#. [RU] "Выкован в огне и пламени."
msgctxt "item_bow_ashlands_description"
msgid "Risen again from the ashes, this bow holds unyielding strength."
msgstr "Выкаваны ў агні і полымі."

#. [UA] "Кровоточиве Ікло"
#. [PL] "Krwawy kieł"
#. [RU] "Кровавый клык"
msgctxt "item_bow_ashlandsblood"
msgid "Blood Fang"
msgstr "Крывавы ікол"

#. [UA] "Стріли з цього лука впиваються в плоть із неймовірною люттю."
#. [PL] "Strzały wypuszczone z tego łuku przeszyją ciała wrogów z ogromnym
#. okrucieństwem."
#. [RU] "Выпущенные из этого лука стрелы врезаются в плоть с удивительной
#. жестокостью."
msgctxt "item_bow_ashlandsblood_description"
msgid "Arrows loosed from this bow will tear into flesh with unmatched ferocity."
msgstr "Пушчаныя з гэтага лука стрэла будзе ірваць плоць з непараўнальнай лютасцю."

#. [UA] "Первісне Ікло"
#. [PL] "Korzenny kieł"
#. [RU] "Корневой клык"
msgctxt "item_bow_ashlandsroot"
msgid "Root Fang"
msgstr "Каранёвы ікол"

#. [UA] "Як покручена гілка шукає сонце, так і цей лук створено для пошуків
#. жертви."
#. [PL] "Tak, jak gałęzie naturalnie szukają słońca, ten łuk poszukuje rzezi."
#. [RU] "Извилистая ветвь всегда ищет солнце, а этот лук — бойню."
msgctxt "item_bow_ashlandsroot_description"
msgid "Like the twisting branch was made to seek the sun, this bow was made to seek the slaughter."
msgstr "Як звілістая галіна заўжды шукае сонца, так гэты лук прагне забойства."

#. [UA] "Громовите Ікло"
#. [PL] "Burzowy kieł"
#. [RU] "Штормовой клык"
msgctxt "item_bow_ashlandsstorm"
msgid "Storm Fang"
msgstr "Навальнічны ікол"

#. [UA] "Нехай стріли летять швидко, наче блискавиці."
#. [PL] "Niech twoje strzały mkną niczym piorun."
#. [RU] "Пусть ваши стрелы летят молниеносно."
msgctxt "item_bow_ashlandsstorm_description"
msgid "Let your arrows fly as swift as the lightning strikes."
msgstr "Няхай вашыя стрэлы ляцяць хутка, нібы маланка."

#. [UA] "Грубий, але робочий лук."
#. [PL] "Może i prymitywny ale i użyteczny!"
#. [RU] "Простой лук без излишеств."
msgctxt "item_bow_description"
msgid "A crude but functional bow."
msgstr "Грубы, але прыдатны лук."

#. [UA] "Ікло драуґра"
#. [PL] "Kieł draugra"
#. [RU] "Клык Драугра"
msgctxt "item_bow_draugrfang"
msgid "Draugr Fang"
msgstr "Ікол драўгра"

#. [UA] "Темна деревина, обмотана лискучими сухожиллями — лиховісна штука."
#. [PL] "Ciemne drewno i lśniące ścięgna – straszliwy przedmiot."
#. [RU] "Лук из темного дерева с крепкой блестящей тетивой. Опасная штука."
msgctxt "item_bow_draugrfang_description"
msgid "Dark wood strung with glistening sinew. A vicious thing."
msgstr "Цёмная драўніна, сцягнутая бліскучым сухажыллем. Зласлівая рэч."

#. [UA] "Якісний лук"
#. [PL] "Łuk kompozytowy"
#. [RU] "Хороший лук"
msgctxt "item_bow_finewood"
msgid "Finewood Bow"
msgstr "Якасны лук"

#. [UA] "Простий лук із міцної й гожої деревини."
#. [PL] "Prosty łuk z mocnego i giętkiego drewna."
#. [RU] "Гибкий лук из крепкой, качественной древесины."
msgctxt "item_bow_finewood_description"
msgid "A simple bow of strong and supple wood."
msgstr "Просты лук з моцнай і гнуткай драўніны."

#. [UA] "Нордичний лук"
#. [PL] "Nordycki łuk"
#. [RU] "Нордский лук"
msgctxt "item_bow_gold"
msgid "Nord Bow"
msgstr "Нардычны лук"

#. [UA] "Громокровний лук"
#. [PL] "Grzmotokrwisty łuk"
#. [RU] "Лук громовой крови"
#, fuzzy
#| msgctxt "item_bow_finewood"
#| msgid "Finewood Bow"
msgctxt "item_bow_gold_bloodlightning"
msgid "Thunderblood Bow"
msgstr "Лук Громавай Крыві"

#. [UA] "Чекаючи на вивільнення, тятивою бігає блискавиця."
#. [PL] "Na jego cięciwie tańczą błyskawice, czekając tylko, aż ktoś je
#. uwolni."
#. [RU] "Молния пляшет по тетиве, готовая вырваться наружу."
msgctxt "item_bow_gold_bloodlightning_description"
msgid "Lightning dances along the string, waiting to be unleashed."
msgstr "Па цеціве танцуе маланка, чакаючы вольнага палёту."

#. [UA] "Заготовина: Громокровний лук"
#. [PL] "Odlew: grzmotokrwisty łuk"
#. [RU] "Заготовка: лук громовой крови"
#, fuzzy
msgctxt "item_bow_gold_bloodlightning_uncooked"
msgid "Cast: Thunderblood Bow"
msgstr "Загатоўка: Лук Громавай Крыві"

#. [UA] "Та сама форма, але результат буде набагато видовищнішим… З часом
#. мороз усе викаже."
#. [PL] "Ta sama forma, lecz może wydać coś o wiele bardziej
#. spektakularnego... Z biegiem czasu mróz wszystko ukaże."
#. [RU] "Хоть форма и осталась прежней, истинный потенциал стал куда более
#. впечатляющим... Со временем мороз раскрывает все, что скрыто."
msgctxt "item_bow_gold_bloodlightning_uncooked_description"
msgid "The same mould, yet inclined to yield a more spectacular result... The frost shall reveal all, in time."
msgstr "Тая ж форма, але здольная прынесці значна ашаламляльнейшы плён ... Мароз расставіць усё па месцах, свайго часу."

#. [UA] "Випущені з лука стріли влучатимуть у ціль із золотою точністю."
#. [PL] "Wystrzelone z niego strzały odnajdą swój cel z niezrównaną precyzją."
#. [RU] "Этот лук попадет в цель с золотой точностью."
msgctxt "item_bow_gold_description"
msgid "This bow shall find its target with a golden precision."
msgstr "Трапіць у цэль з ювелірнай дакладнасцю."

#. [UA] "Вогнекрижний лук"
#. [PL] "Mroźnognisty łuk"
#. [RU] "Лук льда и огня"
#, fuzzy
#| msgctxt "enemy_blobfrost"
#| msgid "Frost Blob"
msgctxt "item_bow_gold_frostfire"
msgid "Frostfire Bow"
msgstr "Лук Зімняга Полымя"

#. [UA] "Не гарячкуйте, коли натягуєте тятиву, а потім випустіть лють разом зі
#. стрілою."
#. [PL] "Podczas naciągania pohamuj swój ognisty temperament, a następnie
#. razem ze strzałami uwolnij swoją furię."
#. [RU] "Натягивайте тетиву хладнокровно, выпускайте стрелу яростно."
#, fuzzy
msgctxt "item_bow_gold_frostfire_description"
msgid "Keep your head cool as you draw, and then let your fury loose with your arrows."
msgstr "Трымай галаву халоднай, нацягваючы цеціву, і адпусці сваю лютасць разам са страламі."

#. [UA] "Заготовина: Вогнекрижний лук"
#. [PL] "Odlew: mroźnognisty łuk"
#. [RU] "Заготовка: лук льда и огня"
#, fuzzy
msgctxt "item_bow_gold_frostfire_uncooked"
msgid "Cast: Frostfire Bow"
msgstr "Загатоўка: Лук Зімняга Полымя"

#. [UA] "Та сама форма, але результат буде набагато видовищнішим… З часом
#. мороз усе викаже."
#. [PL] "Ta sama forma, lecz może wydać coś o wiele bardziej
#. spektakularnego... Z biegiem czasu mróz wszystko ukaże."
#. [RU] "Хоть форма и осталась прежней, истинный потенциал стал куда более
#. впечатляющим... Со временем мороз раскрывает все, что скрыто."
msgctxt "item_bow_gold_frostfire_uncooked_description"
msgid "The same mould, yet inclined to yield a more spectacular result... The frost shall reveal all, in time."
msgstr "Тая ж форма, але здольная прынесці значна ашаламляльнейшы плён ... Мароз расставіць усё па месцах, свайго часу."

#. [UA] "Заготовина: Нордичний лук"
#. [PL] "Odlew: nordycki łuk"
#. [RU] "Заготовка: нордский лук"
#, fuzzy
#| msgctxt "item_bow"
#| msgid "Crude Bow"
msgctxt "item_bow_gold_uncooked"
msgid "Cast: Nord Bow"
msgstr "Загатоўка: Нардычны лук"

#. [UA] "Зброю потрібно загартувати морозом."
#. [PL] "Tę broń należy zahartować mrozem."
#. [RU] "Это оружие нужно закалить морозом."
msgctxt "item_bow_gold_uncooked_description"
msgid "This weapon needs to be hardened with frost."
msgstr "Гэтую зброю трэба загартоўваць марозам."

#. [UA] "Мисливський лук"
#. [PL] "Łuk myśliwego"
#. [RU] "Охотничий лук"
msgctxt "item_bow_huntsman"
msgid "Huntsman Bow"
msgstr "Паляўнічы лук"

#. [UA] "Добре змайстрований і посилений лук — утіха для мисливців."
#. [PL] "Ten misternie wykonany łuk stanowi dumę myśliwego."
#. [RU] "Прекрасный лук с прочной тетивой. Порадует любого охотника."
msgctxt "item_bow_huntsman_description"
msgid "Finely worked and strung. A huntsman's joy."
msgstr "Дыхтоўна выраблены і сцягнуты. Асалода для паляўнічага."

#. [UA] "Хребтолам"
#. [PL] "Kręgopruj"
#. [RU] "Хребтолом"
msgctxt "item_bow_snipesnap"
msgid "Spinesnap"
msgstr "Хрыбталом"

#. [UA] "Використання цього лука навантажує спину, але воно того варте."
#. [PL] "Używanie tego łuku wymaga silnych pleców, ale i tak warto."
#. [RU] "Использование этого лука — непосильная работа, но оно того стоит."
msgctxt "item_bow_snipesnap_description"
msgid "Using this bow is backbreaking work but so worth it."
msgstr "Карыстацца гэтым лукам — спіны потым не разагнуць, але яно таго варта."

#. [UA] "Хліб"
#. [PL] "Bochen chleba"
#. [RU] "Хлеб"
msgctxt "item_bread"
msgid "Bread"
msgstr "Хлеб"

#. [UA] "Смачний кусень хліба."
#. [PL] "Smaczny bochenek chleba."
#. [RU] "Вкусный ломоть хлеба."
msgctxt "item_bread_description"
msgid "A tasty loaf of bread."
msgstr "Смачны бохан хлеба."

#. [UA] "Тісто для хліба"
#. [PL] "Ciasto na chleb"
#. [RU] "Тесто для хлеба"
msgctxt "item_breaddough"
msgid "Bread Dough"
msgstr "Хлебнае цеста"

#. [UA] "Можна випікати."
#. [PL] "Można włożyć do pieca."
#. [RU] "Готово к запеканию."
msgctxt "item_breaddough_description"
msgid "Ready for the oven."
msgstr "Гатова да запякання."

#. [UA] "Бронза"
#. [PL] "Brąz"
#. [RU] "Бронза"
msgctxt "item_bronze"
msgid "Bronze"
msgstr "Бронза"

#. [UA] "Міцний сплав міді й олова."
#. [PL] "Mocny stop miedzi i cyny."
#. [RU] "Прочный сплав меди и олова."
msgctxt "item_bronze_description"
msgid "A strong alloy of copper and tin."
msgstr "Трывалы сплаў медзі і волава."

#. [UA] "Бронзові цвяхи"
#. [PL] "Gwoździe z brązu"
#. [RU] "Бронзовые гвозди"
msgctxt "item_bronzenails"
msgid "Bronze Nails"
msgstr "Бронзавыя цвікі"

#. [UA] "Використовуються для майстрування меблів і кораблів."
#. [PL] "Stosowane do budowy statków i mebli."
#. [RU] "Используются в строительстве кораблей и мебели."
msgctxt "item_bronzenails_description"
msgid "Used in construction of ships and furniture."
msgstr "Выкарыстоўваюцца ў будаўніцтве караблёў і мэблі."

#. [UA] "Брухт бронзи"
#. [PL] "Złom z brązu"
#. [RU] "Бронзовый металлолом"
msgctxt "item_bronzescrap"
msgid "Scrap Bronze"
msgstr "Бронзавы лом"

#. [UA] "Старий і окиснений, та його можна переплавити й знову десь
#. використати."
#. [PL] "Stary i zaśniedziały, ale można go przetopić i ponownie wykorzystać."
#. [RU] "Старый и окисленный, но его можно переплавить и использовать снова."
msgctxt "item_bronzescrap_description"
msgid "It's old and oxidized but can be smelted and used again."
msgstr "Стары і акіслены, але можна пераплавіць і выкарыстоўваць яшчэ раз."

#. [UA] "М’ясо шукача"
#. [PL] "Mięso szperacza"
#. [RU] "Мясо искателя"
msgctxt "item_bug_meat"
msgid "Seeker Meat"
msgstr "Мяса цікуна"

#. [UA] "Смажене м’ясо шукача"
#. [PL] "Pieczone mięso szperacza"
#. [RU] "Приготовленное мясо искателя"
msgctxt "item_bug_meat_cooked"
msgid "Cooked Seeker Meat"
msgstr "Печанае мяса цікуна"

#. [UA] "Соковите біле м’ясо — істинний делікатес."
#. [PL] "Soczyste białe mięso, prawdziwy przysmak."
#. [RU] "Сочное белое мясо, настоящее лакомство."
msgctxt "item_bug_meat_cooked_description"
msgid "Succulent white meat. A true delicacy."
msgstr "Сакавітае белае мяса. Сапраўдны далікатэс."

#. [UA] "Розколовши оболонку, можна знайти ніжне й соковите м’ясо."
#. [PL] "Gdy rozłupiesz ich skorupę, mięso we wnętrzu jest delikatne i
#. soczyste."
#. [RU] "Под их панцирями можно найти нежное и сочное мясо."
msgctxt "item_bug_meat_description"
msgid "When you crack open their shells, the meat within is tender and succulent."
msgstr "Калі раструшчыць іхныя панцыры, можна знайсці далікатнае і сакавітае мяса."

#. [UA] "Свічковий гніт"
#. [PL] "Knot"
#. [RU] "Свечной фитиль"
msgctxt "item_candlewick"
msgid "Candle Wick"
msgstr "Свечкавы кнот"

#. [UA] "Вимочіть це в чомусь легкозаймистому, щоби мати тривале й затишне
#. освітлення."
#. [PL] "Zamocz w czymś łatwopalnym, aby uzyskać długotrwałe i przytulne
#. źródło światła."
#. [RU] "Пропитайте фитиль чем-нибудь горючим, чтобы получился долговечный и
#. уютный светильник."
msgctxt "item_candlewick_description"
msgid "Steep these in something flammable for a long lasting and cosy light source."
msgstr "Вымачыце яго чымсьці гаручым, каб атрымаць даўгавечнае і ўтульнае асвятленне."

#. [UA] "Попелиста накидка"
#. [PL] "Popielna peleryna"
#. [RU] "Пепельный плащ"
msgctxt "item_cape_ash"
msgid "Ashen Cape"
msgstr "Попельная накідка"

#. [UA] "Металеві нитки, вплетені в тканину накидки, створюють хитромудрий
#. візерунок, наче це плели самі норни."
#. [PL] "W pelerynę wpleciono delikatne metaliczne włókno, które tworzy wzór
#. delikatny niczym przeznaczenie uplecione przez samych Nornów."
#. [RU] "Металлические нити в материи плаща образуют переплетенный узор, прямо
#. как сотканные норнами нити судьбы."
msgctxt "item_cape_ash_description"
msgid "Thin metal threads are woven into this cape to create an intricate pattern, like a destiny woven by the Norns themselves."
msgstr "Уплеценыя ў накідку тонкія металічныя ніткі ствараюць мудрагелісты ўзор, нібы гэта ніці лёсу, сатканыя самімі норнамі."

#. [UA] "Накидка зі шкури попелозавра"
#. [PL] "Peleryna z szarowieprza"
#. [RU] "Плащ из шкуры пеплозавра"
msgctxt "item_cape_asksvin"
msgid "Asksvin Cloak"
msgstr "Плашч з скуры тленнавепра"

#. [UA] "Товста накидка ловить вітер, наче корабельне вітрило."
#. [PL] "Ta gruba peleryna łapie wiatr niczym żagiel."
#. [RU] "Толстый плащ надувается на ветру, прямо как парус."
msgctxt "item_cape_asksvin_description"
msgid "This thick cape catches the wind, not unlike the sail of a ship."
msgstr "Тоўстая накідка ловіць вецер, нібы ветразь."

#. [UA] "Накидка зі шкури лося"
#. [PL] "Peleryna ze skóry łosia"
#. [RU] "Плащ из шкуры лося"
#, fuzzy
#| msgctxt "item_cape_deerhide"
#| msgid "Deer Hide Cape"
msgctxt "item_cape_deepnorth"
msgid "Moose Hide Cape"
msgstr "Накідка з шкуры лася"

#. [UA] "Тепла накидка з майстерним золотим шиттям."
#. [PL] "Ciepła peleryna z misternymi, pozłacanymi detalami."
#. [RU] "Теплый плащ с изящной отделкой из золотой нити."
#, fuzzy
msgctxt "item_cape_deepnorth_description"
msgid "A warm cape with fine details of spun gold."
msgstr "Цёплая накідка з вытанчанымі дэталямі з прадзенага золата."

#. [UA] "Накидка заклиначів"
#. [PL] "Peleryna przywoływacza"
#. [RU] "Плащ призывателя"
#, fuzzy
#| msgctxt "item_fistweapon_bjorn"
#| msgid "Paws of the Bear"
msgctxt "item_cape_deepnorth_mage"
msgid "Cape of the Caller"
msgstr "Накідка Заклінальніка"

#. [UA] "У цю накидку вплетені дивні чари, що роблять її водночас легкою й
#. теплою."
#. [PL] "W tę pelerynę wpleciono przedziwną magię, dzięki której jest
#. jednocześnie lekka i ciepła."
#. [RU] "В этот плащ вплетена причудливая магия, которая делает его легким и
#. одновременно теплым."
#, fuzzy
msgctxt "item_cape_deepnorth_mage_description"
msgid "A strange magic is woven into this cape, making it both light and warm."
msgstr "У гэтую накідку ўплецена дзіўная магія, што робіць яе адначасова і лёгкай, і цёплай."

#. [UA] "Накидка з оленячої шкури"
#. [PL] "Peleryna ze skóry jelenia"
#. [RU] "Плащ из шкуры оленя"
msgctxt "item_cape_deerhide"
msgid "Deer Hide Cape"
msgstr "Накідка з шкуры аленя"

#. [UA] "Просто, але зі смаком."
#. [PL] "Rustykalna elegancja."
#. [RU] "Деревенский шик."
msgctxt "item_cape_deerhide_description"
msgid "Rustic chic."
msgstr "Вясковы шык."

#. [UA] "Накидка з пір’я"
#. [PL] "Peleryna z piór"
#. [RU] "Накидка из перьев"
msgctxt "item_cape_feather"
msgid "Feather Cape"
msgstr "Накідка з пер'яў"

#. [UA] "Загорнувшись у накидку ви відчуваєте легкість, неначе можете літати!"
#. [PL] "Przywdzianie tej peleryny powoduje uczucie lekkości, prawie jak byś
#. mógł latać!"
#. [RU] "Надев эту накидку, вы почувствуете себя легче, как если бы вы могли
#. летать!"
msgctxt "item_cape_feather_description"
msgid "Donning this cape makes you feel lighter, almost as if you could fly!"
msgstr "Апрануўшы гэтую накідку, вы адчуеце небывалую лёгкасць, быццам навучыліся лятаць!"

#. [UA] "Лляна накидка"
#. [PL] "Lniana peleryna"
#. [RU] "Льняной плащ"
msgctxt "item_cape_linen"
msgid "Linen Cape"
msgstr "Ільняная накідка"

#. [UA] "Проста накидка мандрівників."
#. [PL] "Prosta peleryna podróżnicza."
#. [RU] "Простой плащ путешественника."
msgctxt "item_cape_linen_description"
msgid "A simple traveler's cape."
msgstr "Простая накідка падарожніка."

#. [UA] "Накидка зі шкури бикоящура"
#. [PL] "Peleryna z Lox'a"
#. [RU] "Плащ из шкуры быкоящера"
msgctxt "item_cape_lox"
msgid "Lox Cape"
msgstr "Накідка з быкаяшчара"

#. [UA] "Шкура величного звіра товста й тепла."
#. [PL] "Grube i ciepłe futro z ogromnej bestii."
#. [RU] "Шкура величественного зверя, толстая и теплая."
msgctxt "item_cape_lox_description"
msgid "A pelt from one of the great beasts, thick and warm."
msgstr "Шкура аднаго з тых вялікіх звяроў, тоўстая і цёплая."

#. [UA] "Накидка Одіна"
#. [PL] "Peleryna Odyna"
#. [RU] "Плащ Одина"
#, fuzzy
#| msgctxt "item_cape_odin"
#| msgid "Cape of Odin"
msgctxt "item_cape_odin"
msgid "Cape of Oden"
msgstr "Накідка Одзіна"

#. [UA] "Добірним воїнам Одіна личить носити добірне вбрання."
#. [PL] "Najznamienitsi wojownicy Odyna zasługują na najszlachetniejsze
#. tkaniny."
#. [RU] "Лучшие воины Одина заслуживают самых лучших одеяний."
msgctxt "item_cape_odin_description"
msgid "Oden's finest warriors deserve the finest cloth."
msgstr "Найлепшыя ваяры Одзіна маюць права на найлепшую вопратку"

#. [UA] "Накидка зі шкури троля"
#. [PL] "Peleryna ze skóry trolla"
#. [RU] "Плащ из шкуры тролля"
msgctxt "item_cape_trollhide"
msgid "Troll Hide Cape"
msgstr "Накідка з скуры троля"

#. [UA] "Шкіра троля жорстка, але розтягується."
#. [PL] "Skóra z trolla jest gruba, lecz elastyczna."
#. [RU] "Кожа тролля плотная и упругая."
msgctxt "item_cape_trollhide_description"
msgid "Trollskin is tough and supple."
msgstr "Скура троля, жорсткая і пругкая."

#. [UA] "Накидка з вовчої шкури"
#. [PL] "Peleryna z wilczego futra"
#. [RU] "Плащ из шкуры волка"
msgctxt "item_cape_wolf"
msgid "Wolf Fur Cape"
msgstr "Накідка з воўчага футра"

#. [UA] "Вовки за природою живучі. А от цьому не пощастило. Тепер його хутро
#. зігріє вас у хуртовині."
#. [PL] "Wilki potrafią przeżyć w każdych warunkach. Ten miał po prostu pecha.
#. Teraz jego futro ogrzeje cię na mrozie."
#. [RU] "Волки умеют выживать. Этому просто не повезло. Теперь его шкура
#. согреет вас в холода."
msgctxt "item_cape_wolf_description"
msgid "Wolves are natural survivors. This one was just unlucky. Now its pelt will warm you in the snow."
msgstr "Ваўкі — жывучыя ад прыроды. Гэтаму проста не пашчасціла. Цяпер ягоная шкура сагрэе вас у маразы."

#. [UA] "Панцир"
#. [PL] "Pancerz"
#. [RU] "Панцирь"
msgctxt "item_carapace"
msgid "Carapace"
msgstr "Панцыр"

#. [UA] "Пластина хітинової броні."
#. [PL] "Płyta chitynowej zbroi."
#. [RU] "Пластина из хитинового панциря."
msgctxt "item_carapace_description"
msgid "A plate of chitinous armour."
msgstr "Пласціна хіцінавай брані."

#. [UA] "Морква"
#. [PL] "Marchew"
#. [RU] "Морковь"
msgctxt "item_carrot"
msgid "Carrot"
msgstr "Морква"

#. [UA] "Помаранчева смакота."
#. [PL] "Pomarańczowy rarytas."
#. [RU] "Оранжевая вкуснятина."
msgctxt "item_carrot_description"
msgid "An orange treat."
msgstr "Аранжавы ласунак."

#. [UA] "Насіння моркви"
#. [PL] "Nasiona marchwi"
#. [RU] "Семена моркови"
msgctxt "item_carrotseeds"
msgid "Carrot Seeds"
msgstr "Насенне морквы"

#. [UA] "Якщо хочеться моркви, то треба посадити це насіння."
#. [PL] "Zasadź je, jeśli lubisz marchewki..."
#. [RU] "Посадите их, если любите морковь..."
msgctxt "item_carrotseeds_description"
msgid "Plant these if you like carrots..."
msgstr "Пасадзіце яго, калі любіце моркву..."

#. [UA] "Морквяний суп"
#. [PL] "Zupa marchewkowa"
#. [RU] "Морковный суп"
msgctxt "item_carrotsoup"
msgid "Carrot Soup"
msgstr "Маркоўны суп"

#. [UA] "Теплий смачнючий супчик із моркви."
#. [PL] "Ciepła i smaczna zupa jarzynowa składająca się głównie z marchwi."
#. [RU] "Теплый и вкусный суп, главный ингредиент которого - морковь."
msgctxt "item_carrotsoup_description"
msgid "A warm tasty soup made of mostly carrots."
msgstr "Цёплы і смачны суп, прыгатаваны пераважна з морквы."

#. [UA] "Вибуховий катапультний снаряд"
#. [PL] "Ładunek wybuchowy"
#. [RU] "Взрывной снаряд"
msgctxt "item_catapult_ammo"
msgid "Explosive Payload"
msgstr "Выбухны набой"

#. [UA] "Найліпше використовувати з катапультою. Поводьтеся обережно."
#. [PL] "Najlepiej nadaje się do katapulty. Zachowaj ostrożność."
#. [RU] "Лучше использовать с катапультой. Обращаться осторожно."
msgctxt "item_catapult_ammo_description"
msgid "Best used with a catapult. Handle with care."
msgstr "Найлепей ужываць разам з катапультай. Карыстайцеся з асцярожнасцю."

#. [UA] "Кровозлотний катапультний снаряд"
#. [PL] "Ładunek z krwawego złota"
#. [RU] "Катапультный снаряд из кровавого золота"
#, fuzzy
msgctxt "item_catapult_bloodgold_ammo"
msgid "Bloodgold Payload"
msgstr "Крывазолаты зарад"

#. [UA] "Бийте сильно і до крові."
#. [PL] "Nieś ze sobą moc i rzeź."
#. [RU] "Устройте врагам кровавую бойню."
#, fuzzy
msgctxt "item_catapult_bloodgold_ammo_description"
msgid "Hit 'em hard and hit 'em bloody."
msgstr "Бі моцна і бі да крыві."

#. [UA] "Сірокам’яний катапультний снаряд"
#. [PL] "Ładunek z graustenu"
#. [RU] "Снаряд из серокамня"
msgctxt "item_catapult_training_ammo"
msgid "Grausten Payload"
msgstr "Граўстэнавы снарад"

#. [UA] "Найліпше використовувати з катапультою. Попіклуйтеся, щоби нічого
#. крихкого не було на шляху."
#. [PL] "Najlepiej nadaje się do katapulty. Nie ustawiaj na jego drodze nic
#. delikatnego."
#. [RU] "Лучше использовать с катапультой. Убедитесь, что на вашем пути нет
#. ничего хрупкого."
msgctxt "item_catapult_training_ammo_description"
msgid "Best used with a catapult. Make sure nothing fragile is in the way."
msgstr "Лепш ужываць у звязцы з катапультай. Праверце, каб па дарозе не сустрэлася нічога крохкага."

#. [UA] "Небесна пір’їна"
#. [PL] "Niebiańskie pióro"
#. [RU] "Небесное перо"
msgctxt "item_celestialfeather"
msgid "Celestial Feather"
msgstr "Нябеснае пер'е"

#. [UA] "Єдине, що лишилося на згадку про колишню валькірію."
#. [PL] "Jedyna pozostałość po poległej walkirii."
#. [RU] "Единственно оставшееся свидетельство истинной сущности валькирии."
msgctxt "item_celestialfeather_description"
msgid "The only remnant of the fallen valkyrie's former self."
msgstr "Адзіны напамін пра былую славу заняпалай валькірыі."

#. [UA] "Керамічна пластина"
#. [PL] "Ceramiczna płyta"
#. [RU] "Керамическая пластина"
msgctxt "item_ceramicplate"
msgid "Ceramic Plate"
msgstr "Керамічная пласціна"

#. [UA] "Байдуже, наскільки сильно ви розігрієте один бік — інший буде
#. напрочуд холодним."
#. [PL] "Niezależnie od temperatury druga strona plyty pozostaje chłodna."
#. [RU] "Как бы ни раскалялась одна сторона, оборотная странным образом
#. остается прохладной."
msgctxt "item_ceramicplate_description"
msgid "No matter how hot this gets, the other side of it remains strangely cool."
msgstr "Наколькі б яна не награвалася з аднаго боку, другі застанецца на дзіўна прахалодным."

#. [UA] "Ланцюг"
#. [PL] "Łańcuch"
#. [RU] "Цепь"
msgctxt "item_chain"
msgid "Chain"
msgstr "Ланцуг"

#. [UA] "Ланка залізного ланцюга."
#. [PL] "Ogniwa żelaznego łańcucha."
#. [RU] "Железная цепь."
msgctxt "item_chain_description"
msgid "A link of iron chain."
msgstr "Звяно жалезнага ланцуга."

#. [UA] "Імовірність застосувати ефект:"
#. [PL] "Szansa na wywołanie efektu:"
#. [RU] "Шанс наложить эффект:"
msgctxt "item_chancetoapplyse"
msgid "Chance to apply effect:"
msgstr "Шанс накласці эфект:"

#. [UA] "Обвуглена живиця"
#. [PL] "Zwęglona żywica"
#. [RU] "Угольная смола"
msgctxt "item_charcoalresin"
msgid "Charcoal Resin"
msgstr "Вугальная жывіца"

#. [UA] "Живиця з дерева, що дуже давно згоріло. Однак вона й досі готова
#. знову запалити багаття."
#. [PL] "Żywica dawno spalonego drzewa. Wciąż łatwopalna."
#. [RU] "Смола давным-давно сгоревшего дерева. Может погореть еще немного."
msgctxt "item_charcoalresin_description"
msgid "The resin from a tree that was set ablaze a long time ago. It's still ready to burn some more."
msgstr "Жывіца з даўным-даўно падпаленага дрэва. Гатовая яшчэ крыху папалаць."

#. [UA] "Обвуглена кістка"
#. [PL] "Zwęglona kość"
#. [RU] "Обугленная кость"
msgctxt "item_charredbone"
msgid "Charred Bone"
msgstr "Абвугленая костка"

#. [UA] "Кістка з чітко вираженим запахом згорілого м’яса."
#. [PL] "Towarzyszy jej fetor spalonego mięsa."
#. [RU] "Источает характерный запах горелого мяса."
msgctxt "item_charredbone_description"
msgid "Followed by the distinct smell of burnt meat."
msgstr "Нясе з сабою выразны пах гарэлага мяса."

#. [UA] "Обвуглена шестерня"
#. [PL] "Zwęglone koło zębate"
#. [RU] "Обгорелая шестерня"
msgctxt "item_charredcogwheel"
msgid "Charred Cogwheel"
msgstr "Абвугленая шасцярня"

#. [UA] "Це можна використати для якоїсь хитромудрої машинерії…"
#. [PL] "Może się przydać w jakiejś sprytnej maszynie..."
#. [RU] "Возможно, пригодится для какого-нибудь хитроумного механизма..."
msgctxt "item_charredcogwheel_description"
msgid "This could be used for some clever machinery..."
msgstr "Гэта можна выкарыстаць у спрытна зробленым механізме..."

#. [UA] "Обвуглений череп"
#. [PL] "Zwęglona czaszka"
#. [RU] "Обугленный череп"
msgctxt "item_charredskull"
msgid "Charred Skull"
msgstr "Абвуглены чэрап"

#. [UA] "Чорний череп давно полеглого воїна. Навряд чи будь-яке поховання
#. впокоїть його."
#. [PL] "Poczerniały czerep dawno poległego wojownika. Wątpliwe, by pochówek
#. przyniósł mu ukojenie."
#. [RU] "Почерневший череп давно погибшего воина. Вряд ли достойное
#. захоронение принесет ему покой."
msgctxt "item_charredskull_description"
msgid "The blackened skull of a long-dead warrior. It's unlikely that a proper burial would grant them any peace."
msgstr "Счарнелы чэрап даўно памерлага ваяра. Наўрад ці належныя хаўтуры далі б яму спакой."

#. [UA] "Ведмежий візерунок"
#. [PL] "Wzory Niedźwiedzia"
#. [RU] "Медвежьи узоры"
msgctxt "item_chest_berserker"
msgid "Patterns of the Bear"
msgstr "Мядзведжыя ўзоры"

#. [UA] "Якщо ці химерні малюнки можуть захистити воїнів з далеких земель, то
#. вас і поготів."
#. [PL] "Jeśli te zawiłe malowidła mogą chronić wojów z odległych krain, z
#. pewnością mogą chronić i ciebie."
#. [RU] "Если эти сложные узоры защищают воинов из далеких земель, то и вас
#. смогут защитить."
msgctxt "item_chest_berserker_description"
msgid "If these intricate designs can protect warriors from distant lands, they can surely protect you too."
msgstr "Раз гэтыя мудрагелістыя ўзоры ахоўваюць ваяроў з далёкіх краін, то і цябе, напэўна, абароняць."

#. [UA] "Дикокістяний нагрудник"
#. [PL] "Podła Klatka"
#. [RU] "Гнилокостная нагрудная клетка"
msgctxt "item_chest_berserker_undead"
msgid "Vilebone Cage"
msgstr "Паганыя рэбры"

#. [UA] "Виготовлено з розтрощеного скелета закатованого ведмедя."
#. [PL] "Stworzona ze strzaskanych kości udręczonego niedźwiedzia."
#. [RU] "Изготовлена из раздробленных костей измученного медведя."
msgctxt "item_chest_berserker_undead_description"
msgid "Crafted from the shattered bones of a tormented bear."
msgstr "Выраблена з раструшчаных костак змучанага мядзведзя."

#. [UA] "Бронзовий латний панцир"
#. [PL] "Ćwiekowana zbroja"
#. [RU] "Бронзовая кираса"
msgctxt "item_chest_bronze"
msgid "Bronze Plate Tunic"
msgstr "Бронзавы латны панцыр"

#. [UA] "Нагрудник із кованої бронзи."
#. [PL] "Napierśnik z młotkowanego brązu."
#. [RU] "Нагрудник из чеканной бронзы."
msgctxt "item_chest_bronze_description"
msgid "A breastplate of hammered bronze."
msgstr "Нагруднік з каванай бронзы."

#. [UA] "Хітиновий нагрудник"
#. [PL] "Napierśnik z pancerza"
#. [RU] "Панцирный нагрудник"
msgctxt "item_chest_carapace"
msgid "Carapace Breastplate"
msgstr "Хіцінавы нагруднік"

#. [UA] "Нагрудник, виготовлений з обпаленого панцира велетенської комахи."
#. [PL] "Napierśnik wykonany z wypolerowanego pancerza gigantycznego owada."
#. [RU] "Нагрудник, изготовленный из полированного панциря гигантского
#. насекомого."
msgctxt "item_chest_carapace_description"
msgid "A breastplate crafted from the burnished carapace of a giant insect."
msgstr "Нагруднік, выраблены з паліраванага панцыра гіганцкай казуркі."

#. [UA] "Просте коричневе вбрання"
#. [PL] "Prosta brązowa suknia"
#. [RU] "Простое коричневое платье"
msgctxt "item_chest_dress1"
msgid "Plain Brown Dress"
msgstr "Простая карычневая сукенка"

#. [UA] "Просте вбрання"
#. [PL] "Prosta naturalna suknia"
#. [RU] "Простое платье"
msgctxt "item_chest_dress10"
msgid "Simple Undyed Dress"
msgstr "Простая непафарбаваная сукенка"

#. [UA] "Дуже просте вбрання."
#. [PL] "Prosta suknia do codziennego noszenia."
#. [RU] "Обычное платье."
msgctxt "item_chest_dress10_description"
msgid "A simple dress for everyday wear."
msgstr "Простая сукенка, можна хоць штодзень насіць."

#. [UA] "Дуже просте коричневе вбрання."
#. [PL] "Prosta brązowa suknia, noszona na niebieskiej halce."
#. [RU] "Обычное коричневое платье."
msgctxt "item_chest_dress1_description"
msgid "A plain brown dress, worn over a blue underdress."
msgstr "Простая карычневая сукенка."

#. [UA] "Коричневе вбрання із хусткою"
#. [PL] "Brązowa suknia z szalem"
#. [RU] "Коричневое платье с шалью"
msgctxt "item_chest_dress2"
msgid "Brown Dress with Shawl"
msgstr "Карычневая сукенка з хусткай"

#. [UA] "Коричневе вбрання з теплою хусткою."
#. [PL] "Brązowa suknia, z pasującym szalem przy ramionach. Ciepła i stylowa!"
#. [RU] "Коричневое платье с теплой шалью."
msgctxt "item_chest_dress2_description"
msgid "A brown dress, with a matching shawl around the shoulders. Warm and stylish!"
msgstr "Карычневая сукенка з хусткай на плячах. Цёплая і стылёвая!"

#. [UA] "Коричневе вбрання з намистинами"
#. [PL] "Brązowa suknia z Guzami"
#. [RU] "Коричневое платье в бусинах"
msgctxt "item_chest_dress3"
msgid "Brown Dress with Beads"
msgstr "Карычневая сукенка з пацеркамі"

#. [UA] "Коричневе вбрання, оздоблене намистинами та сріблом."
#. [PL] "Ozdobna brązowa suknia, z guzami i srebrnymi broszkami strzałkowymi.
#. Doskonała na ucztę!"
#. [RU] "Коричневое платье, расшитое бусинами и серебром."
msgctxt "item_chest_dress3_description"
msgid "A fancy brown dress, with beads and silver fibula brooches. Excellent for a feast!"
msgstr "Модная карычневая сукенка з пацеркамі і срэбнымі брошкамі. Выдатна пасуе для бяседы!"

#. [UA] "Просте блакитне вбрання"
#. [PL] "Prosta niebieska suknia"
#. [RU] "Простое синее платье"
msgctxt "item_chest_dress4"
msgid "Plain Blue Dress"
msgstr "Простая блакітная сукенка"

#. [UA] "Дуже просте блакитне вбрання."
#. [PL] "Prosta niebieska suknia, noszona na czerwonej halce."
#. [RU] "Обычное синее платье."
msgctxt "item_chest_dress4_description"
msgid "A plain blue dress, worn over a red underdress."
msgstr "Простая блакітная сукенка."

#. [UA] "Блакитне вбрання із хусткою"
#. [PL] "Niebieska suknia z szalem"
#. [RU] "Синее платье с шалью"
msgctxt "item_chest_dress5"
msgid "Blue Dress with Shawl"
msgstr "Блакітная сукенка з хусткай"

#. [UA] "Блакитне вбрання з теплою хусткою."
#. [PL] "Niebieska suknia, z zielonym szalem przy ramionach. Ciepła i
#. stylowa!"
#. [RU] "Синее платье с теплой шалью."
msgctxt "item_chest_dress5_description"
msgid "A blue dress, with a green shawl around the shoulders. Warm and stylish!"
msgstr "Блакітная сукенка з зялёнай хусткай на плячах. Цёплая і стылёвая!"

#. [UA] "Блакитне вбрання з намистинами"
#. [PL] "Niebieska suknia z Guzami"
#. [RU] "Синее платье в бусинах"
msgctxt "item_chest_dress6"
msgid "Blue Dress with Beads"
msgstr "Блакітная сукенка з пацеркамі"

#. [UA] "Блакитне вбрання, оздоблене намистинами та сріблом."
#. [PL] "Ozdobna niebieska suknia, z guzami i broszkami strzałkowymi z brązu.
#. Doskonała na ucztę!"
#. [RU] "Синее платье, расшитое бусинами и бронзой."
msgctxt "item_chest_dress6_description"
msgid "A fancy blue dress, with beads and bronze fibula brooches. Excellent for a feast!"
msgstr "Модная блакітная сукенка з пацеркамі і бронзавымі брошкамі. Выдатна пасуе для бяседы!"

#. [UA] "Просте жовте вбрання"
#. [PL] "Prosta żółta suknia"
#. [RU] "Простое желтое платье"
msgctxt "item_chest_dress7"
msgid "Plain Yellow Dress"
msgstr "Простая жоўтая сукенка"

#. [UA] "Дуже просте жовте вбрання."
#. [PL] "Prosta żółta suknia, noszona na zielonej halce."
#. [RU] "Обычное желтое платье."
msgctxt "item_chest_dress7_description"
msgid "A plain yellow dress, worn over a green underdress."
msgstr "Простая жоўтая сукенка."

#. [UA] "Жовте вбрання із хусткою"
#. [PL] "Żółta suknia z szalem"
#. [RU] "Желтое платье с шалью"
msgctxt "item_chest_dress8"
msgid "Yellow Dress with Shawl"
msgstr "Жоўтая сукенка з хусткай"

#. [UA] "Жовте вбрання з теплою хусткою."
#. [PL] "Żółta suknia, z fioletowym szalem przy ramionach. Ciepła i stylowa!"
#. [RU] "Желтое платье с теплой шалью."
msgctxt "item_chest_dress8_description"
msgid "A yellow dress, with a purple shawl around the shoulders. Warm and stylish!"
msgstr "Жоўтая сукенка з фіялетавай хусткай на плячах. Цёплая і стылёвая!"

#. [UA] "Жовте вбрання з намистинами"
#. [PL] "Żółta suknia z Guzami"
#. [RU] "Желтое платье в бусинах"
msgctxt "item_chest_dress9"
msgid "Yellow Dress with Beads"
msgstr "Жоўтая сукенка з пацеркамі"

#. [UA] "Жовте вбрання, оздоблене намистинами та сріблом."
#. [PL] "Ozdobna żółta suknia, z guzami i srebrnymi broszkami strzałkowymi.
#. Doskonała na ucztę!"
#. [RU] "Желтое платье, расшитое бусинами и серебром."
msgctxt "item_chest_dress9_description"
msgid "A fancy yellow dress, with beads and silver fibula brooches. Excellent for a feast!"
msgstr "Модная жоўтая сукенка з пацеркамі і срэбнымі брошкамі. Выдатна пасуе для бяседы!"

#. [UA] "Плащ Фенріра"
#. [PL] "Płaszcz z Fenrisa"
#. [RU] "Облачение Фенриса"
msgctxt "item_chest_fenris"
msgid "Fenris Coat"
msgstr "Паліто Фэнрыра"

#. [UA] "Звір робив настільки глибокі вдихи, що виття було чутно по всіх
#. усюдах."
#. [PL] "Bestia mogła robić głębokie wdechy, by jej wycie było słyszalne w
#. całej krainie."
#. [RU] "У зверя было настолько глубокое дыхание, что его вой был слышен
#. далеко по всей земле."
msgctxt "item_chest_fenris_description"
msgid "The beast could draw deep breaths, so that its howl could be heard far across the land."
msgstr "Звер дыхаў вельмі глыбока, так што вой яго было чуваць ва ўсіх краях."

#. [UA] "Вогнеметалевий нагрудник"
#. [PL] "Napierśnik z ogniometalu"
#. [RU] "Огнеметаллическая кираса"
msgctxt "item_chest_flametal"
msgid "Flametal Breastplate"
msgstr "Полыметалёвая кіраса"

#. [UA] "Цей сплав загадкового вогняного металу та обвуглених кісток
#. забезпечує найліпший захист з усіх у Мідґарді."
#. [PL] "Z połączenia tajemniczego ogniometalu i zwęglonych kości powstaje
#. ochronna powłoka o odporności większej niż cokolwiek innego w Midgardzie."
#. [RU] "Огнеметалл и обугленные кости соединяются в прочнейший защитный
#. покров, равный которому не сыскать во всем Мидгарде."
msgctxt "item_chest_flametal_description"
msgid "This fusion of mysterious flametal and charred bones serves as a protective layer more resilient than anything you could ever find in Midgard."
msgstr "З гэтага сплаву таямнічага полыметалу і абвугленых костак атрымліваецца найтрывалейшая ахова, якую толькі можна пашукаць у Мідгардзе."

#. [UA] "Обладунки потрібно загартувати морозом."
#. [PL] "Ten element zbroi należy zahartować mrozem."
#. [RU] "Этот предмет брони нужно закалить морозом."
msgctxt "item_chest_gold_uncooked_description"
msgid "This armour needs to be hardened with frost."
msgstr "Гэтую браню трэба загартоўваць марозам."

#. [UA] "Туніка збиральника"
#. [PL] "Tunika żniwiarza"
#. [RU] "Туника урожая"
msgctxt "item_chest_harvester1"
msgid "Harvest Tunic"
msgstr "Урадлівая барва"

#. [UA] "Під час роботи в полі дуже важливим є відповідний одяг. Коротка
#. туніка дозволить прохолодному вітру освіжити вас."
#. [PL] "Do pracy w polu należy odpowiednio się ubrać. Przewiewna krótka
#. tunika dobrze schładza ciało."
#. [RU] "Для работы в полях нужна подходящая одежда. В укороченной тунике не
#. так жарко."
msgctxt "item_chest_harvester1_description"
msgid "When working the fields, it's important to dress accordingly. A shorter tunic lets in a cool breeze."
msgstr "Працуючы ў полі, важна адпаведна апранацца. Падкарочаная барва прапускае прахалодны ветрык."

#. [UA] "Сукня збиральниці"
#. [PL] "Suknia żniwiarki"
#. [RU] "Одежда урожая"
msgctxt "item_chest_harvester2"
msgid "Harvest Dress"
msgstr "Урадлівая сукенка"

#. [UA] "Під час роботи в полі дуже важливим є відповідний одяг. Довга сукня
#. прикриє коліна."
#. [PL] "Do pracy w polu należy odpowiednio się ubrać. Dłuższa suknia chroni
#. kolana w trakcie pracy."
#. [RU] "Для работы в полях нужна подходящая одежда. Эта длиннополая одежда
#. покрывает колени, пока вы трудитесь."
msgctxt "item_chest_harvester2_description"
msgid "When working the fields, it's important to dress accordingly. This long dress keeps your knees covered while you work."
msgstr "Працуючы ў полі, важна адпаведна апранацца. Гэтая даўгая сукенка прыкрые вашыя калені."

#. [UA] "Нагрудник захисників"
#. [PL] "Napierśnik obrońcy"
#. [RU] "Нагрудник защитника"
#, fuzzy
#| msgctxt "item_chest_bronze_description"
#| msgid "A breastplate of hammered bronze."
msgctxt "item_chest_heavy_deepnorth"
msgid "Breastplate of the Protector"
msgstr "Нагруднік Ахоўніка"

#. [UA] "Хутро, шкура, метал — усі разом захистять від ворожих ударів."
#. [PL] "Futro, skóra i metal współpracują, aby odeprzeć ciosy wroga."
#. [RU] "Мех, кожа и металл вместе защищают от ударов противника."
msgctxt "item_chest_heavy_deepnorth_description"
msgid "Fur and hide and metal all work in tandem to ward off an enemy's blows."
msgstr "Поўсць, шкура і метал дзейнічаюць разам, каб адбіваць удары."

#. [UA] "Заготовина: Нагрудник захисників"
#. [PL] "Odlew: napierśnik obrońcy"
#. [RU] "Заготовка: нагрудник защитника"
#, fuzzy
#| msgctxt "item_chest_bronze_description"
#| msgid "A breastplate of hammered bronze."
msgctxt "item_chest_heavy_gold_uncooked"
msgid "Cast: Breastplate of the Protector"
msgstr "Загатоўка: Нагруднік Ахоўніка"

#. [UA] "Обладунки потрібно загартувати морозом."
#. [PL] "Ten element zbroi należy zahartować mrozem."
#. [RU] "Этот предмет брони нужно закалить морозом."
msgctxt "item_chest_heavy_gold_uncooked_description"
msgid "This armour needs to be hardened with frost."
msgstr "Гэтую браню трэба загартоўваць марозам."

#. [UA] "Латунна скриня Гільдір"
#. [PL] "Miedziana skrzynia Hildir"
#. [RU] "Медный сундук Хильдир"
msgctxt "item_chest_hildir1"
msgid "Hildir's Brass Chest"
msgstr "Масянжовы куфар Хільдыр"

#. [UA] "Срібна скриня Гільдір"
#. [PL] "Srebrna skrzynia Hildir"
#. [RU] "Серебряный сундук Хильдир"
msgctxt "item_chest_hildir2"
msgid "Hildir's Silver Chest"
msgstr "Сярэбраны куфар Хільдыр"

#. [UA] "Бронзова скриня Гільдір"
#. [PL] "Brązowa skrzynia Hildir"
#. [RU] "Бронзовый сундук Хильдир"
msgctxt "item_chest_hildir3"
msgid "Hildir's Bronze Chest"
msgstr "Бронзавы куфар Хільдыр"

#. [UA] "Власність Гільдір. Поверніть, якщо знайшли."
#. [PL] "Własność Hildir. Proszę zwrócić po znalezieniu."
#. [RU] "Собственность Хильдир, нашедшему просьба вернуть."
msgctxt "item_chest_hildir_description"
msgid "Property of Hildir, please return if found."
msgstr "Уласнасць Хільдыр. Калі ласка, вярніце, калі знайшлі."

#. [UA] "Залізний лускатий обладунок"
#. [PL] "Zbroja łuskowa"
#. [RU] "Чешуйчатый железный доспех"
msgctxt "item_chest_iron"
msgid "Iron Scale Mail"
msgstr "Жалезны лускаваты панцыр"

#. [UA] "Цей обладунок здатен витримати удари майже будь-якої сили."
#. [PL] "Zbroja z żelaznych łusek, która ulegnie jedynie najsilniejszym
#. ciosom."
#. [RU] "Чешуйчатый доспех из железа, способен выдержать удар любой силы."
msgctxt "item_chest_iron_description"
msgid "An iron scale mail, this will turn all but the strongest of blows."
msgstr "Лускаваты панцыр вытрымае нават наймацынейшы з удараў."

#. [UA] "Шкіряна туніка"
#. [PL] "Skórzana tunika"
#. [RU] "Кожаная туника"
msgctxt "item_chest_leather"
msgid "Leather Tunic"
msgstr "Скураная барва"

#. [UA] "Проста туніка зі звірячої шкури."
#. [PL] "Tunika uszyta ze skóry zwierzęcej."
#. [RU] "Туника из кожи зверей."
msgctxt "item_chest_leather_description"
msgid "A tunic made from animal hide."
msgstr "Барва з скуры жывёл."

#. [UA] "Куртка з бикоящурового хутра"
#. [PL] "Kurtka z futra loxa"
#. [RU] "Куртка из меха локса"
#, fuzzy
msgctxt "item_chest_lox"
msgid "Lox Fur Jacket"
msgstr "Куртка з быкаяшчаравай поўсці"

#. [UA] "Ви все ще відчуваєте сильний запах мускусу."
#. [PL] "Wciąż mocno czuć od niej piżmem."
#. [RU] "Всё ещё ощущается сильный мускусный запах."
#, fuzzy
msgctxt "item_chest_lox_description"
msgid "A heavy musk still clings to it."
msgstr "Да яе ўсё яшчэ ліпне цяжкі мускусны пах."

#. [UA] "Роба з ейтировим плетенням"
#. [PL] "Szata z Eitrosplotu"
#. [RU] "Сшитое из эйтра одеяние"
msgctxt "item_chest_mage"
msgid "Eitr-weave Robe"
msgstr "Убранне з эйтравалакна"

#. [UA] "Роба Ембли"
#. [PL] "Szaty Embli"
#. [RU] "Одежды Эмблы"
msgctxt "item_chest_mage_ashlands"
msgid "Robes of Embla"
msgstr "Эмбліна ўбранне"

#. [UA] "Це насичене могутністю першої чаклунки вбрання надасть чимало переваг
#. тим, хто прагне опанувати прадавнє мистецтво чарознавста."
#. [PL] "Przesiąknięte mocą pierwszej czarodziejki szaty są skarbem dla
#. każdego, kto chciałby zgłębić starożytną sztukę magii."
#. [RU] "Одежды наделены мощью первой колдуньи. Их магическая сила передается
#. каждому, кто желает освоить древние колдовские силы."
msgctxt "item_chest_mage_ashlands_description"
msgid "Imbued with the power of the first sorceress, these robes will grant a boon to any who seeks to wield the ancient art of magic."
msgstr "Прасякнутае сілай першай чараўніцы, гэтае ўбранне стане скарбам для кожнага, хто імкнецца авалодаць старажытным мастацтвам магіі."

#. [UA] "Роба заклиначів"
#. [PL] "Szaty przywoływacza"
#. [RU] "Одеяние призывателя"
#, fuzzy
#| msgctxt "item_fistweapon_bjorn"
#| msgid "Paws of the Bear"
msgctxt "item_chest_mage_deepnorth"
msgid "Robes of the Caller"
msgstr "Убранне Заклінальніка"

#. [UA] "Золотом вишиті вбрання пасують лише наймогутнішим з чаклунів."
#. [PL] "Szaty o złotym wykończeniu, odpowiednie wyłącznie dla
#. najpotężniejszych magów."
#. [RU] "Одеяние с золотой отделкой, достойное лишь самых могущественных
#. магов."
#, fuzzy
msgctxt "item_chest_mage_deepnorth_description"
msgid "Gold trimmed robes, fit for only the most powerful of mages."
msgstr "Убранне, аблямаванае золатам, вартае толькі наймагутнейшых магаў."

#. [UA] "Ці мистецько вишиті роби мають вшиті закляття й заговори в кожній
#. складці та виточці."
#. [PL] "Ta kunsztownie wykonana szata ma zaklęcia i amulety wszyte w każdy
#. szew i fałdę."
#. [RU] "В этих искусно многослойных одеяниях, в каждый шов и складку вшиты
#. заклинания и чары."
msgctxt "item_chest_mage_description"
msgid "These artfully layered robes have spells and charms sewn into every seam and fold."
msgstr "У кожнае шво і складку гэтага па-майстэрску скроенага ўбрання ўшытыя чары і загаворы."

#. [UA] "Заготовина: Роба заклиначів"
#. [PL] "Odlew: szaty przywoływacza"
#. [RU] "Заготовка: одеяние призывателя"
#, fuzzy
#| msgctxt "item_chest_berserker"
#| msgid "Patterns of the Bear"
msgctxt "item_chest_mage_gold_uncooked"
msgid "Cast: Robes of the Caller"
msgstr "Загатоўка: Убранне Заклінальніка"

#. [UA] "Обладунки потрібно загартувати морозом."
#. [PL] "Ten element zbroi należy zahartować mrozem."
#. [RU] "Этот предмет брони нужно закалить морозом."
msgctxt "item_chest_mage_gold_uncooked_description"
msgid "This armour needs to be hardened with frost."
msgstr "Гэтую браню трэба загартоўваць марозам."

#. [UA] "Нагрудник Аска"
#. [PL] "Napierśnik Aska"
#. [RU] "Кираса Аска"
msgctxt "item_chest_medium_ashlands"
msgid "Breastplate of Ask"
msgstr "Аскаў нагруднік"

#. [UA] "Перша людина в Мідґарді знала, як захистити свої найважливіші органи,
#. і використовувала подібний нагрудник."
#. [PL] "Pierwszy Midgardczyk wiedział, jak chronić swoje najważniejsze
#. organy. Zapewne służył mu do tego napierśnik w tym właśnie stylu."
#. [RU] "Первый человек в Мидгарде знал, как защитить жизненно важные органы.
#. Возможно, он пользовался именно такой кирасой."
msgctxt "item_chest_medium_ashlands_description"
msgid "The first man in Midgard knew how to guard his most vital organs, perhaps with a breastplate just like this one."
msgstr "Першы чалавек Мідгарда ведаў, як абараніць жыццёва важныя органы. Магчыма, ён карыстаўся падобным нагруднікам."

#. [UA] "Куртка авангарду"
#. [PL] "Napierśnik awangardy"
#. [RU] "Нагрудник авангарда"
msgctxt "item_chest_medium_deepnorth"
msgid "Chestpiece of the Vanguard"
msgstr "Нагруднік авангарда"

#. [UA] "Майстерно виготовлені шкіряні обладунки. Пропонують взірцевий захист,
#. але не обмежують рухливість воїтелів."
#. [PL] "Mistrzowsko wykonany skórzany pancerz oferujący doskonałą obronę bez
#. ograniczania ruchów wojownika."
#. [RU] "Искусно сделанная кожаная броня. Она хорошо защищает воина и не
#. сковывает его движений."
#, fuzzy
msgctxt "item_chest_medium_deepnorth_description"
msgid "Expertly crafted leather armour, offering excellent protection without limiting a warrior's movements."
msgstr "Майстэрску вырабленая скураная браня, якая дае выдатную абарону, не перашкаджаючы рухам ваяра."

#. [UA] "Заготовина: Куртка авангарду"
#. [PL] "Odlew: napierśnik awangardy"
#. [RU] "Заготовка: нагрудник авангарда"
#, fuzzy
msgctxt "item_chest_medium_gold_uncooked"
msgid "Cast: Chestpiece of the Vanguard"
msgstr "Загатоўка: Нагруднік Авангарда"

#. [UA] "Обладунки потрібно загартувати морозом."
#. [PL] "Ten element zbroi należy zahartować mrozem."
#. [RU] "Этот предмет брони нужно закалить морозом."
msgctxt "item_chest_medium_gold_uncooked_description"
msgid "This armour needs to be hardened with frost."
msgstr "Гэтую браню трэба загартоўваць марозам."

#. [UA] "Оббитий панцир"
#. [PL] "Wyściełany kirys"
#. [RU] "Обитая кираса"
msgctxt "item_chest_pcuirass"
msgid "Padded Cuirass"
msgstr "Падшываная кіраса"

#. [UA] "Чудово оброблений і достатньо міцний, щоби затупити об себе
#. найгостріші леза."
#. [PL] "Precyzyjnie wykonany i wystarczająco mocny, by odeprzeć nawet
#. najostrzejsze miecze."
#. [RU] "Изящно обработанная и достаточно прочная, чтобы отразить самые острые
#. клинки."
msgctxt "item_chest_pcuirass_description"
msgid "Finely wrought and strong enough to turn even the sharpest blades."
msgstr "Дасканала выраблены і досыць моцны, каб адбіць выцень нават найвастрэйшых клінкоў."

#. [UA] "Ряднинна туніка"
#. [PL] "Szmaciana tunika"
#. [RU] "Холщовая туника"
msgctxt "item_chest_rags"
msgid "Rag Tunic"
msgstr "Анучная барва"

#. [UA] "Краще так, ніж із голим торсом."
#. [PL] "Lepsze to niż nic."
#. [RU] "Лучше, чем ничего."
msgctxt "item_chest_rags_description"
msgid "Better than nothing."
msgstr "Лепш, чым нічога."

#. [UA] "Кореневий нагрудник"
#. [PL] "Korzeń mocujący"
#. [RU] "Корневой нагрудник"
msgctxt "item_chest_root"
msgid "Root Harnesk"
msgstr "Каранёвы нагруднік"

#. [UA] "Легкі обладунки, дивним чином сплетені з прадавніх коренів та кори."
#. [PL] "Lekka zbroja osobliwie zszyta ze starożytnej kory i korzeni."
#. [RU] "Легкая броня, причудливо сотканная из древних корней и коры."
msgctxt "item_chest_root_description"
msgid "A light armour oddly woven together by ancient roots and bark."
msgstr "Лёгкі панцыр, дзіўна сплецены з старадаўніх каранёў і кары."

#. [UA] "Туніка зі шкури троля"
#. [PL] "Tunika ze skóry trolla"
#. [RU] "Туника из кожи тролля"
msgctxt "item_chest_trollleather"
msgid "Troll Leather Tunic"
msgstr "Барва з скуры троля"

#. [UA] "З тролів складно здерти шкуру, зате вона міцна й тепла."
#. [PL] "Trolle trudno oskórować, lecz ich skóra jest gruba i ciepła."
#. [RU] "Свежевание тролля - задача не из простых, зато их шкура прочная и
#. теплая."
msgctxt "item_chest_trollleather_description"
msgid "Trolls are hard to skin but their leather is tough and warm."
msgstr "З троляў цяжка здзерці скуру, затое адзенне з яе трывалае і цёплае."

#. [UA] "Проста блакитна туніка"
#. [PL] "Prosta niebieska tunika"
#. [RU] "Простая синяя туника"
msgctxt "item_chest_tunic1"
msgid "Plain Blue Tunic"
msgstr "Простая сіняя барва"

#. [UA] "Проста туніка"
#. [PL] "Prosta naturalna tunika"
#. [RU] "Простая туника"
msgctxt "item_chest_tunic10"
msgid "Simple Undyed Tunic"
msgstr "Простая барва"

#. [UA] "Дуже проста туніка."
#. [PL] "Prosta tunika do codziennego noszenia."
#. [RU] "Обычная туника."
msgctxt "item_chest_tunic10_description"
msgid "A simple tunic for everyday wear."
msgstr "Простая барва, можна хоць штодзень насіць."

#. [UA] "Дуже проста блакитна туніка."
#. [PL] "Prosta niebieska tunika, jasno barwiona."
#. [RU] "Обычная синяя туника."
msgctxt "item_chest_tunic1_description"
msgid "A plain blue tunic, brightly dyed."
msgstr "Аднатонная блакітная барва яскравага колеру."

#. [UA] "Блакитна туніка з каптуром"
#. [PL] "Niebieska tunika z peleryną"
#. [RU] "Синяя туника с капюшоном"
msgctxt "item_chest_tunic2"
msgid "Blue Tunic with Cape"
msgstr "Блакітная барва з накідкай"

#. [UA] "Блакитна туніка з дошитим каптуром."
#. [PL] "Niebieska tunika, noszona ze stylową peleryną wykonaną z cienkiej
#. brązowej wełny."
#. [RU] "Синяя туника с капюшоном."
msgctxt "item_chest_tunic2_description"
msgid "A blue tunic, worn with a fashionable cape made from fine brown wool."
msgstr "Сіняя барва з моднай накідкай, зробленай з тонкай карычневай воўны."

#. [UA] "Блакитна туніка з намистинами"
#. [PL] "Niebieska tunika z Guzami"
#. [RU] "Синяя туника в бусинах"
msgctxt "item_chest_tunic3"
msgid "Blue Tunic with Beads"
msgstr "Блакітная барва з пацеркамі"

#. [UA] "Блакитна туніка, оздоблена намистинами та сріблом."
#. [PL] "Niebieska tunika z guzami i srebrną biżuterią. Na pewno przyciągnie
#. uwagę innych Wikingów."
#. [RU] "Синяя туника, расшитая бусинами и серебром."
msgctxt "item_chest_tunic3_description"
msgid "A blue tunic worn with beads and silver jewelry. Sure to attract attention from other vikings."
msgstr "Блакітная барва з пацеркамі і сярэбранымі аздобамі. Абавязкова прыцягне ўвагу іншых вікінгаў."

#. [UA] "Проста червона туніка"
#. [PL] "Prosta czerwona tunika"
#. [RU] "Простая красная туника"
msgctxt "item_chest_tunic4"
msgid "Plain Red Tunic"
msgstr "Простая чырвоная барва"

#. [UA] "Дуже проста червона туніка."
#. [PL] "Prosta czerwona tunika, jasno barwiona."
#. [RU] "Обычная красная туника."
msgctxt "item_chest_tunic4_description"
msgid "A plain red tunic, brightly dyed."
msgstr "Аднатонная чырвоная барва яскравага колеру."

#. [UA] "Червона туніка з каптуром"
#. [PL] "Czerwona tunika z peleryną"
#. [RU] "Красная туника с капюшоном"
msgctxt "item_chest_tunic5"
msgid "Red Tunic with Cape"
msgstr "Чырвоная барва з накідкай"

#. [UA] "Червона туніка з дошитим каптуром."
#. [PL] "Czerwona tunika, noszona ze stylową peleryną wykonaną z cienkiej
#. zielonej wełny."
#. [RU] "Красная туника с капюшоном."
msgctxt "item_chest_tunic5_description"
msgid "A red tunic, worn with a fashionable cape made from fine green wool."
msgstr "Чырвоная барва з моднай накідкай, зробленай з тонкай зялёнай воўны."

#. [UA] "Червона туніка з намистинами"
#. [PL] "Czerwona tunika z Guzami"
#. [RU] "Красная туника в бусинах"
msgctxt "item_chest_tunic6"
msgid "Red Tunic with Beads"
msgstr "Чырвоная барва з пацеркамі"

#. [UA] "Червона туніка, оздоблена намистинами та сріблом."
#. [PL] "Czerwona tunika z guzami i biżuterią z brązu. Na pewno przyciągnie
#. uwagę innych Wikingów."
#. [RU] "Красная туника, расшитая бусинами и бронзой."
msgctxt "item_chest_tunic6_description"
msgid "A red tunic worn with beads and bronze jewelry. Sure to attract attention from other vikings."
msgstr "Чырвоная барва з пацеркамі і бронзавымі аздобамі. Абавязкова прыцягне ўвагу іншых вікінгаў."

#. [UA] "Проста жовта туніка"
#. [PL] "Prosta żółta tunika"
#. [RU] "Простая желтая туника"
msgctxt "item_chest_tunic7"
msgid "Plain Yellow Tunic"
msgstr "Простая жоўтая барва"

#. [UA] "Дуже проста жовта туніка."
#. [PL] "Prosta żółta tunika, jasno barwiona."
#. [RU] "Обычная желтая туника."
msgctxt "item_chest_tunic7_description"
msgid "A plain yellow tunic, brightly dyed."
msgstr "Аднатонная жоўтая барва яскравага колеру."

#. [UA] "Жовта туніка з каптуром"
#. [PL] "Żółta tunika z peleryną"
#. [RU] "Желтая туника с капюшоном"
msgctxt "item_chest_tunic8"
msgid "Yellow Tunic with Cape"
msgstr "Жоўтая барва з накідкай"

#. [UA] "Жовта туніка з дошитим каптуром."
#. [PL] "Żółta tunika, noszona ze stylową peleryną wykonaną z cienkiej
#. fioletowej wełny."
#. [RU] "Желтая туника с капюшоном."
msgctxt "item_chest_tunic8_description"
msgid "A yellow tunic, worn with a fashionable cape made from fine purple wool."
msgstr "Жоўтая барва з моднай накідкай, зробленай з тонкай пурпуровай воўны."

#. [UA] "Жовта туніка з намистинами"
#. [PL] "Żółta tunika z Guzami"
#. [RU] "Желтая туника в бусинах"
msgctxt "item_chest_tunic9"
msgid "Yellow Tunic with Beads"
msgstr "Жоўтая барва з пацеркамі"

#. [UA] "Жовта туніка, оздоблена намистинами та сріблом."
#. [PL] "Żółta tunika z guzami i srebrną biżuterią. Na pewno przyciągnie uwagę
#. innych Wikingów."
#. [RU] "Желтая туника, расшитая бусинами и серебром."
msgctxt "item_chest_tunic9_description"
msgid "A yellow tunic worn with beads and silver jewelry. Sure to attract attention from other vikings."
msgstr "Жоўтая барва з пацеркамі і сярэбранымі аздобамі. Абавязкова прыцягне ўвагу іншых вікінгаў."

#. [UA] "Вовчий обладунок"
#. [PL] "Kamizelka z wilka"
#. [RU] "Волчий нагрудник"
msgctxt "item_chest_wolf"
msgid "Wolf Hide Chestpiece"
msgstr "Нагруднік з воўчай шкуры"

#. [UA] "Жилетка із вовчої шкури, тепла й дикувата на вигляд. Захищає від
#. холоду."
#. [PL] "Ciepła i prymitywnie wyglądająca kamizelka z wilczej skóry. Chroni
#. przed wychłodzeniem."
#. [RU] "Жилет из волчьей кожи, теплый и броский. Защищает от холода."
msgctxt "item_chest_wolf_description"
msgid "A wolfskin jerkin, warm and wild-looking. It protects against the cold."
msgstr "Куртка з ваўчынай скуры, цёплая і дзікаватая з выгляду. Ахоўвае ад холаду."

#. [UA] "Яйце"
#. [PL] "Jajko"
#. [RU] "Яйцо"
msgctxt "item_chicken_egg"
msgid "Egg"
msgstr "Яйка"

#. [UA] "(занадто холодно)"
#. [PL] "(Za zimno)"
#. [RU] "(очень холодно)"
msgctxt "item_chicken_egg_cold"
msgid "(Too cold)"
msgstr "(занадта холадна)"

#. [UA] "Тримайте в теплі, щоби побачити, хто вилупиться… але ж і справді — що
#. було першим?"
#. [PL] "Utrzymaj w cieple, by zobaczyć, co się wykluje.. ale co było
#. pierwsze, tak naprawdę?"
#. [RU] "Держите его в тепле, чтобы увидеть, что вылупится... и на самом деле,
#. что было первым?"
msgctxt "item_chicken_egg_description"
msgid "Keep it warm to see what comes out.. but what came first, really?"
msgstr "Трымайце яго ў цяпле, каб убачыць, што вылупіцца... І ці было яно насамрэч перш за курыцу?"

#. [UA] "(у кладці не виросте)"
#. [PL] "(Nie może rozwijać się w stosie)"
#. [RU] "(в стопке не будет расти)"
msgctxt "item_chicken_egg_stacked"
msgid "(Can not grow in stack)"
msgstr "(Не могуць расці ў стосе)"

#. [UA] "(тепло)"
#. [PL] "(Ciepło)"
#. [RU] "(тепло)"
msgctxt "item_chicken_egg_warm"
msgid "(Warm)"
msgstr "(цёпла)"

#. [UA] "М’ясо курчати"
#. [PL] "Mięso kurczaka"
#. [RU] "Курятина"
msgctxt "item_chicken_meat"
msgid "Chicken Meat"
msgstr "Кураціна"

#. [UA] "Смажене м’ясо курчат"
#. [PL] "Pieczone mięso kurczaka"
#. [RU] "Приготовленная курятина"
msgctxt "item_chicken_meat_cooked"
msgid "Cooked Chicken Meat"
msgstr "Печаная кураціна"

#. [UA] "На смак як курча."
#. [PL] "Smakuje jak kurczak."
#. [RU] "На вкус как курица."
msgctxt "item_chicken_meat_cooked_description"
msgid "It tastes like chicken."
msgstr "На смак як курыца."

#. [UA] "Усі курчата носять прокляття смачності."
#. [PL] "Wszystkie kurczaki noszą rodową klątwę bycia przepysznym."
#. [RU] "Все куры несут родовое проклятие быть вкусными."
msgctxt "item_chicken_meat_description"
msgid "All chickens bear the ancestral curse of being delicious."
msgstr "Усе куры нясуць на сабе родавы праклён — яны страшэнна смачныя."

#. [UA] "Хітин"
#. [PL] "Chityna"
#. [RU] "Хитин"
msgctxt "item_chitin"
msgid "Chitin"
msgstr "Хіцін"

#. [UA] "Уламок панцира ракоподібного."
#. [PL] "Odłamek skorupiaka."
#. [RU] "Осколок панциря ракообразного."
msgctxt "item_chitin_description"
msgid "A shard of crustacean shell."
msgstr "Аскепак панцыра ракападобнага."

#. [UA] "Морошка"
#. [PL] "Nordycka Malina"
#. [RU] "Морошка"
msgctxt "item_cloudberries"
msgid "Cloudberries"
msgstr "Марошка"

#. [UA] "Лісове золото."
#. [PL] "Leśne złoto."
#. [RU] "Золото леса"
msgctxt "item_cloudberries_description"
msgid "The gold of the forest."
msgstr "Золата лесу."

#. [UA] "Палиця"
#. [PL] "Maczuga"
#. [RU] "Дубина"
msgctxt "item_club"
msgid "Club"
msgstr "Дубіна"

#. [UA] "Груба, але корисна зброя."
#. [PL] "Prymitywna, lecz użyteczna broń."
#. [RU] "Примитивное, но эффективное оружие."
msgctxt "item_club_description"
msgid "A crude but useful weapon."
msgstr "Прымітыўная, але прыдатная зброя."

#. [UA] "Вугілля"
#. [PL] "Węgiel"
#. [RU] "Уголь"
msgctxt "item_coal"
msgid "Coal"
msgstr "Вугаль"

#. [UA] "Шмат вуглини."
#. [PL] "Kawałek węgla."
#. [RU] "Кусок угля."
msgctxt "item_coal_description"
msgid "A lump of coal."
msgstr "Кавалак вугалю."

#. [UA] "Монета"
#. [PL] "Moneta"
#. [RU] "Монета"
msgctxt "item_coin"
msgid "Coin"
msgstr "Манета"

#. [UA] "Золота монета."
#. [PL] "Złota moneta"
#. [RU] "Золотая монета."
msgctxt "item_coin_description"
msgid "A golden coin."
msgstr "Залатая манета."

#. [UA] "Монети"
#. [PL] "Monety"
#. [RU] "Монеты"
msgctxt "item_coins"
msgid "Coins"
msgstr "Манеты"

#. [UA] "<color=yellow>Цінні</color>"
#. [PL] "<color=yellow>Cenne</color>"
#. [RU] "<color=yellow>Ценные</color>"
msgctxt "item_coins_description"
msgid "<color=yellow>Valuable</color>"
msgstr "<color=yellow>Каштоўныя</color>"

#. [UA] "Мідь"
#. [PL] "Miedź"
#. [RU] "Медь"
msgctxt "item_copper"
msgid "Copper"
msgstr "Медзь"

#. [UA] "Зливок чистої міді чекає, коли його візьмуть у роботу."
#. [PL] "Sztabka czystej miedzi gotowej do obróbki."
#. [RU] "Слиток чистой меди, может быть весьма полезным."
msgctxt "item_copper_description"
msgid "A bar of pure copper ready to be worked."
msgstr "Злітак чыстай медзі, гатовы да абраблення."

#. [UA] "Мідна руда"
#. [PL] "Ruda miedzi"
#. [RU] "Медная руда"
msgctxt "item_copperore"
msgid "Copper Ore"
msgstr "Медзяная руда"

#. [UA] "Неочищена мідь. Потребує очищення в плавильні."
#. [PL] "Nierafinowana miedź do uszlachetnienia w odlewni."
#. [RU] "Неочищенная медь. Необходимо обработать в плавильне."
msgctxt "item_copperore_description"
msgid "Unrefined copper. Needs to be refined in a smelter."
msgstr "Неачышчаная медзь. Патрабуе абраблення ў плавільні."

#. [UA] "Брухт міді"
#. [PL] "Miedziany złom"
#. [RU] "Медный металлолом"
msgctxt "item_copperscrap"
msgid "Copper Scrap"
msgstr "Медзяны лом"

#. [UA] "Комусь може бути брухт, інший скаже — мій скарб."
#. [PL] "Śmieci jednego to skarb drugiego."
#. [RU] "Мусор для одних, сокровище для других."
msgctxt "item_copperscrap_description"
msgid "One person's scrap is another person's treasure."
msgstr "Што для аднаго ламачча — для іншага скарб."

#. [UA] "Виготовлено"
#. [PL] "Wytwórca:"
#. [RU] "Создано"
msgctxt "item_crafter"
msgid "Crafted by"
msgstr "Створана:"

#. [UA] "Арбаліста"
#. [PL] "Arbalet"
#. [RU] "Арбалет"
msgctxt "item_crossbow_arbalest"
msgid "Arbalest"
msgstr "Самастрэл"

#. [UA] "Повільна, але потужна зброя."
#. [PL] "Wolna, ale potężna broń."
#. [RU] "Медленное, но мощное оружие."
msgctxt "item_crossbow_arbalest_description"
msgid "A slow but powerful weapon."
msgstr "Павольная, але магутная зброя."

#. [UA] "Громокровний арбалет"
#. [PL] "Grzmotokrwista kusza"
#. [RU] "Арбалет громовой крови"
#, fuzzy
msgctxt "item_crossbow_bloodlightning_gold"
msgid "Thunderblood Crossbow"
msgstr "Самастрэл Громавай Крыві"

#. [UA] "Тятива натягнута з невимовною силою й бринить, наче повітря перед
#. блискавицею."
#. [PL] "Jest pełna skumulowanej energii, zupełnie jak powietrze tuż przed
#. uderzeniem pioruna."
#. [RU] "Тетива натянута до предела, словно воздух перед ударом молнии."
#, fuzzy
msgctxt "item_crossbow_bloodlightning_gold_description"
msgid "The bow is pulled taut with unreleased power, like the air before a lightning strike."
msgstr "Цеціва нацягнута нявызваленай сілай, нібы паветра перад ударам маланкі."

#. [UA] "Заготовина: Громокровний арбалет"
#. [PL] "Odlew: grzmotokrwista kusza"
#. [RU] "Заготовка: арбалет громовой крови"
#, fuzzy
msgctxt "item_crossbow_bloodlightning_gold_uncooked"
msgid "Cast: Thunderblood Crossbow"
msgstr "Загатоўка: Самастрэл Громавай Крыві"

#. [UA] "Та сама форма, але результат буде набагато видовищнішим… З часом
#. мороз усе викаже."
#. [PL] "Ta sama forma, lecz może wydać coś o wiele bardziej
#. spektakularnego... Z biegiem czasu mróz wszystko ukaże."
#. [RU] "Хоть форма и осталась прежней, истинный потенциал стал куда более
#. впечатляющим... Со временем мороз раскрывает все, что скрыто."
msgctxt "item_crossbow_bloodlightning_gold_uncooked_description"
msgid "The same mould, yet inclined to yield a more spectacular result... The frost shall reveal all, in time."
msgstr "Тая ж форма, але здольная прынесці значна ашаламляльнейшы плён ... Мароз расставіць усё па месцах, свайго часу."

#. [UA] "Вогнекрижний арбалет"
#. [PL] "Mroźnognista kusza"
#. [RU] "Арбалет льда и огня"
#, fuzzy
#| msgctxt "item_arrow_frost"
#| msgid "Frost Arrow"
msgctxt "item_crossbow_frostfire_gold"
msgid "Frostfire Crossbow"
msgstr "Самастрэл Зімняга Полымя"

#. [UA] "Якщо вороги не застигають, коли ви прицілюєтеся, то точно замерзнуть,
#. коли ви влучите."
#. [PL] "Jeśli twoi wrogowie nie zastygną w bezruchu, gdy będziesz w nich
#. celować, to z pewnością to zrobią, gdy już ich trafisz."
#. [RU] "Если враги не замерзли, пока вы целились, то уж после попадания —
#. непременно."
#, fuzzy
msgctxt "item_crossbow_frostfire_gold_description"
msgid "If your enemies don't freeze as you take aim, they are sure to do so once they are hit."
msgstr "Калі ворагі не замёрзнуць, пакуль ты мэцішся, дык напэўна замёрзнуць, калі будуць параненыя."

#. [UA] "Заготовина: Вогнекрижний арбалет"
#. [PL] "Odlew: mroźnognista kusza"
#. [RU] "Заготовка: арбалет льда и огня"
#, fuzzy
msgctxt "item_crossbow_frostfire_gold_uncooked"
msgid "Cast: Frostfire Crossbow"
msgstr "Загатоўка: Самастрэл Зімняга Полымя"

#. [UA] "Та сама форма, але результат буде набагато видовищнішим… З часом
#. мороз усе викаже."
#. [PL] "Ta sama forma, lecz może wydać coś o wiele bardziej
#. spektakularnego... Z biegiem czasu mróz wszystko ukaże."
#. [RU] "Хоть форма и осталась прежней, истинный потенциал стал куда более
#. впечатляющим... Со временем мороз раскрывает все, что скрыто."
msgctxt "item_crossbow_frostfire_gold_uncooked_description"
msgid "The same mould, yet inclined to yield a more spectacular result... The frost shall reveal all, in time."
msgstr "Тая ж форма, але здольная прынесці значна ашаламляльнейшы плён ... Мароз расставіць усё па месцах, свайго часу."

#. [UA] "Нордичний арбалет"
#. [PL] "Nordycka kusza"
#. [RU] "Нордский арбалет"
#, fuzzy
#| msgctxt "skill_crossbows"
#| msgid "Crossbows"
msgctxt "item_crossbow_gold"
msgid "Nord Crossbow"
msgstr "Нардычны самастрэл"

#. [UA] "Надзвичайна сила зачаїлася й чекає, доки її випустять."
#. [PL] "Niezmierna moc tej broni tylko czeka, aż ktoś ją wyzwoli."
#. [RU] "В этом оружии заключена невероятная сила, ждущая освобождения."
#, fuzzy
#| msgctxt "item_shieldcore_description"
#| msgid "A protective force within is ready to be unleashed."
msgctxt "item_crossbow_gold_description"
msgid "An incredible force is bound to this weapon, waiting to be unleashed."
msgstr "У гэтай зброі схаваная неверагодная сіла, якая чакае вызвалення."

#. [UA] "Заготовина: Нордичний арбалет"
#. [PL] "Odlew: nordycka kusza"
#. [RU] "Заготовка: нордский арбалет"
#, fuzzy
msgctxt "item_crossbow_gold_uncooked"
msgid "Cast: Nord Crossbow"
msgstr "Загатоўка: Нардычны самастрэл"

#. [UA] "Зброю потрібно загартувати морозом."
#. [PL] "Tę broń należy zahartować mrozem."
#. [RU] "Это оружие нужно закалить морозом."
msgctxt "item_crossbow_gold_uncooked_description"
msgid "This weapon needs to be hardened with frost."
msgstr "Гэтую зброю трэба загартоўваць марозам."

#. [UA] "Упокоювач"
#. [PL] "Rozpruwacz"
#. [RU] "Разрыватель"
msgctxt "item_crossbow_ripper"
msgid "Ripper"
msgstr "Ірвач"

#. [UA] "Кровоточивий Упокоювач"
#. [PL] "Raniący rozpruwacz"
#. [RU] "Ранящий разрыватель"
msgctxt "item_crossbow_ripper_blood"
msgid "Wound Ripper"
msgstr "Ранавы рвач"

#. [UA] "Готовий розірвати ваших ворогів на шматки."
#. [PL] "Gotowy rozszarpać wrogów na kawałki."
#. [RU] "Готов порвать врагов на части."
msgctxt "item_crossbow_ripper_blood_description"
msgid "Ready to rend your enemies to pieces."
msgstr "Гатовы разарваць ворагаў на часткі."

#. [UA] "Упокойте своїх ворогів навічно та й по тому."
#. [PL] "Rozpruwa wrogów, stąd nazwa."
#. [RU] "Разрывает врагов на части. Вот и вся наука."
msgctxt "item_crossbow_ripper_description"
msgid "Rips your foes apart, simple as that."
msgstr "Разрывае ворагаў на часткі, вось так папросту."

#. [UA] "Громовитий Жнець"
#. [PL] "Burzowy rozpruwacz"
#. [RU] "Штормовой разрыватель"
msgctxt "item_crossbow_ripper_lightning"
msgid "Storm Ripper"
msgstr "Навальнічны Рвач"

#. [UA] "Болти прориватимуться крізь ворогів, наче виняткова надпотужна буря."
#. [PL] "Bełty przeszyją wrogów niczym wyjątkowo porywisty szkwał."
#. [RU] "Болты будут рвать ваших врагов, словно свирепый ветер."
msgctxt "item_crossbow_ripper_lightning_description"
msgid "The bolts will tear through your enemies like a particularly nasty gale."
msgstr "Гэтыя белты будуць пранізваць вашых ворагаў нібы штармавы павеў."

#. [UA] "Первісний Упокоювач"
#. [PL] "Rozpruwacz korzenia"
#. [RU] "Корневой разрыватель"
msgctxt "item_crossbow_ripper_nature"
msgid "Root Ripper"
msgstr "Каранёвы Рвач"

#. [UA] "Якщо болт не зупинить вашого ворога там, де той стоїть, то коріння
#. з-під землі точно впораються."
#. [PL] "Jeśli nawet bełt nie zatrzyma wroga, z pewnością zrobi to wychodzący
#. z ziemi korzeń."
#. [RU] "Если болт не пригвоздит врага, его крепко обовьют вырывающиеся из
#. земли корни."
msgctxt "item_crossbow_ripper_nature_description"
msgid "If the bolt doesn't pin your foe in place, the roots surging up from the ground surely will."
msgstr "Калі белт не прыб'е ворага да месцы, то карані, што з зямлі ўзаўюцца, даробяць справу."

#. [UA] "Перлина корони"
#. [PL] "Klejnot koronny"
#. [RU] "Жемчужина короны"
#, fuzzy
msgctxt "item_crownjewel"
msgid "Crown Jewel"
msgstr "Каронны самацвет"

#. [UA] "З цього коштовного каменю лине невідома вам енергія."
#. [PL] "Klejnot emanuje przedziwną mocą, niepodobną do niczego innego."
#. [RU] "Внутри этого драгоценного камня чувствуется странная сила, непохожая
#. ни на что, что вы когда-либо ощущали."
#, fuzzy
msgctxt "item_crownjewel_description"
msgid "A strange power surges within this gem, unlike anything you've felt before."
msgstr "Унутры гэтага самацвета кіпіць дзіўная сіла, непадобная да ўсяго, што ты адчуваў раней."

#. [UA] "Болотяний ключ"
#. [PL] "Klucz na mokradła"
#. [RU] "Болотный ключ"
msgctxt "item_cryptkey"
msgid "Swamp Key"
msgstr "Балотны ключ"

#. [UA] "Частково вкритий затверділою грязюкою, смердить неймовірно."
#. [PL] "Częściowo pokryty zaschniętym błotem, cuchnie niemiłosiernie."
#. [RU] "Покрыт коркой грязи, воняет."
msgctxt "item_cryptkey_description"
msgid "Partly covered in caked mud, it smells foetid."
msgstr "Часткова пакрыты застылай граззю, неймаверна смярдзіць."

#. [UA] "Кристал"
#. [PL] "Kryształ"
#. [RU] "Кристалл"
msgctxt "item_crystal"
msgid "Crystal"
msgstr "Крышталь"

#. [UA] "Уламок кристала з надр землі."
#. [PL] "Odłamek kryształu z głębi ziemi."
#. [RU] "Осколок кристалла, найденный глубоко под землей."
msgctxt "item_crystal_description"
msgid "A shard of crystal from deep within the earth."
msgstr "Аскепак крышталя з нетраў зямлі."

#. [UA] "Розпушувач"
#. [PL] "Grabie"
#. [RU] "Пропашник"
msgctxt "item_cultivator"
msgid "Cultivator"
msgstr "Граблі"

#. [UA] "Фермерське знаряддя для розпушування ґрунту."
#. [PL] "Narzędzie rolnicze do uprawy gleby."
#. [RU] "Фермерский инструмент для вспашки почвы."
msgctxt "item_cultivator_description"
msgid "A farming tool for tilling soil."
msgstr "Земляробская прылада для арання глебы."

#. [UA] "Дістаньте із землі насіння, щоби посадити іншим разом."
#. [PL] "Odzyskaj nasiona z ziemi, by wysiać je innym razem."
#. [RU] "Выкопайте семена из земли, чтобы посадить их позже."
#, fuzzy
msgctxt "item_cultivator_remove_description"
msgid "Retrieve the seeds from the soil, to plant another time."
msgstr "Дастаньце насенне з глебы, каб пасадзіць яго ў іншы раз."

#. [UA] "Сухожилля білки"
#. [PL] "Sezonowane ścięgno wiewiórki"
#. [RU] "Дубленые беличьи сухожилия"
msgctxt "item_curedsquirrelhamstring"
msgid "Cured Squirrel Hamstring"
msgstr "Дубленыя паджылкі вавёркі"

#. [UA] "Еластичне й міцне. Певно, що ці жилки належали швидкій та спритній
#. тварині."
#. [PL] "Elastyczne i wytrzymałe. Musiało być pozyskane z szybkiego i zwinnego
#. zwierzęcia."
#. [RU] "Эластичные и крепкие. Эти сухожилия явно принадлежали быстрым и
#. ловким животным."
msgctxt "item_curedsquirrelhamstring_description"
msgid "Elastic and strong. This tendon must have come from a quick and agile animal."
msgstr "Эластычныя і моцныя. Відаць, належалі хуткай і спрытнай жывёле."

#. [UA] "Поточне"
#. [PL] "Aktualne"
#. [RU] "Сейчас"
msgctxt "item_current"
msgid "Current"
msgstr "Цяпер"

#. [UA] "Завдавана шкода збільшується відповідно до втраченої кількості
#. здоров’я"
#. [PL] "Obrażenia zwiększane proporcjonalnie do brakującego zdrowia"
#. [RU] "Чем меньше здоровья, тем больше урон"
msgctxt "item_damagemultiplierhp"
msgid "Damage increased per health missing"
msgstr "Чым менш здароўя, тым больш пашкоджанне"

#. [UA] "Збільшення шкоди відповідно до загальної кількості втраченого
#. здоров’я"
#. [PL] "Zwiększenie obrażeń zależne od brakującego zdrowia"
#. [RU] "Чем меньше остается здоровья, тем больше увеличивается урон"
msgctxt "item_damagemultipliertotal"
msgid "Damage increase based on total health missing"
msgstr "Чым менш застаецца здароўя, тым больш узмацняецца пашкоджанне"

#. [UA] "Кульбаба"
#. [PL] "Mniszek lekarski"
#. [RU] "Одуванчик"
msgctxt "item_dandelion"
msgid "Dandelion"
msgstr "Дзьмухавец"

#. [UA] "Кульбабка звичайна."
#. [PL] "Pospolity mniszek lekarski."
#. [RU] "Просто одуванчик."
msgctxt "item_dandelion_description"
msgid "Some call it a weed, but it's pretty nonetheless."
msgstr "Нехта заве яго пустазеллем, тым не менш, ён гожы."

#. [UA] "Оленяче м’ясо"
#. [PL] "Mięso jelenia"
#. [RU] "Оленина"
msgctxt "item_deer_meat"
msgid "Deer Meat"
msgstr "Аленіна"

#. [UA] "Смажене м’ясо оленя"
#. [PL] "Pieczone mięso jelenia"
#. [RU] "Приготовленная оленина"
msgctxt "item_deer_meat_cooked"
msgid "Cooked Deer Meat"
msgstr "Печаная аленіна"

#. [UA] "Вартує усієї тієї біганини."
#. [PL] "Całe to bieganie się opłaciło."
#. [RU] "Беготня не прошла даром."
msgctxt "item_deer_meat_cooked_description"
msgid "All that running paid off."
msgstr "Уся гэта беганіна была таго вартай."

#. [UA] "Оленяча шкура"
#. [PL] "Skóra jelenia"
#. [RU] "Шкура оленя"
msgctxt "item_deerhide"
msgid "Deer Hide"
msgstr "Аленевая шкура"

#. [UA] "Знята з оленя шкура."
#. [PL] "Oczyszczona skóra z jelenia."
#. [RU] "Очищенная шкура оленя."
msgctxt "item_deerhide_description"
msgid "A cleaned hide from a deer."
msgstr "Апратаная шкура аленя."

#. [UA] "Рагу з оленя"
#. [PL] "Gulasz z jelenia"
#. [RU] "Рагу из оленины"
msgctxt "item_deerstew"
msgid "Deer Stew"
msgstr "Тушаніна з аленя"

#. [UA] "Тане в роті."
#. [PL] "Tak miękki, że się rozpada."
#. [RU] "Нежнейшее мясо."
msgctxt "item_deerstew_description"
msgid "Fall-apart tender."
msgstr "Растае ў роце."

#. [UA] "Шкода за відбиття"
#. [PL] "Siła parowania"
#. [RU] "Сила парирования"
msgctxt "item_deflection"
msgid "Parry force"
msgstr "Сіла парыравання"

#. [UA] "Відбиття"
#. [PL] "Odbicie"
#. [RU] "Отражение"
msgctxt "item_deflection_OLD"
msgid "Deflection"
msgstr "Адбіццё"

#. [UA] "Світлячок"
#. [PL] "Światełko ognika"
#. [RU] "Свет светлячка"
msgctxt "item_demister"
msgid "Wisplight"
msgstr "Агеньчык"

#. [UA] "Закріпіть світляка, щоб освітити шлях крізь найгустішу імлу."
#. [PL] "Przechwycony ognik przeprowadzi cię przez najgęstsze mgły."
#. [RU] "Магический огонек, который проведет вас через самый густой туман."
msgctxt "item_demister_description"
msgid "A bound wisp to guide you through the thickest of mists."
msgstr "Прыязны святляк, які правядзе вас цераз найгусцейшы з туманаў."

#. [UA] "Мішечок слизу"
#. [PL] "Worek mazi"
#. [RU] "Мешок слизи"
msgctxt "item_destructible_gucksack"
msgid "Guck Sack"
msgstr "Мяшочак слізі"

