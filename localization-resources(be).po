#. [UA] "Підготує ґрунт для посівів."
#. [PL] "Przygotuj ziemię pod uprawę."
#. [RU] "Подготовьте почву для посадки."
msgctxt "piece_cultivate_description"
msgid "Make the soil ready for planting."
msgstr ""

#. [UA] "Арка з темної деревини"
#. [PL] "Łuk z ciemnego drewna"
#. [RU] "Арка из темного дерева"
msgctxt "piece_darkwoodarch"
msgid "Darkwood Arch"
msgstr "Арка з цёмнай драўніны"

