#. [UA] "Вам тепло"
#. [PL] "Czujesz ciepło"
#. [RU] "Вам тепло"
msgctxt "se_warm_start"
msgid "You feel warm."
msgstr "Вам цёпла."

#. [UA] "Вам тепло."
#. [PL] "Jest ci ciepło."
#. [RU] "Вам тепло."
msgctxt "se_warm_tooltip"
msgid "You are warm."
msgstr "Вам цёпла."

#. [UA] "Вогкість"
#. [PL] "Mokro"
#. [RU] "Сырость"
msgctxt "se_wet_name"
msgid "Wet"
msgstr "Волкасць"

#. [UA] "Ви мокрі"
#. [PL] "Jest ci mokro"
#. [RU] "Вы промокли"
msgctxt "se_wet_repeat"
msgid "You are wet"
msgstr "Вы прамоклі"

#. [UA] "Ви мокрі"
#. [PL] "Jest ci mokro"
#. [RU] "Вы промокли"
msgctxt "se_wet_start"
msgid "You are wet"
msgstr "Вы прамоклі"

#. [UA] "Ви підсохли"
#. [PL] "Jest ci znów sucho"
#. [RU] "Вы снова высохли"
msgctxt "se_wet_stop"
msgid "You are dry again"
msgstr "Вы высахлі"

#. [UA] "Знижується відновлення здоров’я й витривалості."
#. [PL] "Obniżenie poziomu regeneracji życia i kondycji."
#. [RU] "Уменьшает восстановление здоровья и выносливости."
msgctxt "se_wet_tooltip"
msgid "Lowers your health and stamina regeneration."
msgstr "Зніжае аднаўленне здароўя і вынослівасці."

#. [UA] "Біговій"
#. [PL] "Bieg z wiatrem"
#. [RU] "Ветрокрылый"
msgctxt "se_windrun_name"
msgid "Wind Run"
msgstr "Бег з вецярком"

#. [UA] "Біжіть швидше й довше, коли вітер дме в спину. Нехай веде вас до
#. перемоги!"
#. [PL] "Biegnąc z wiatrem, gnasz jeszcze szybciej. Niech wiatr poprowadzi cię
#. do zwycięstwa!"
#. [RU] "Увеличивает скорость бега и значительно снижает расход выносливости
#. при беге по ветру. Пусть несет он вас к победе!"
msgctxt "se_windrun_tooltip"
msgid "Increases run speed and greatly reduced stamina use when running with the wind. Let the wind guide you to victory!"
msgstr "Павялічвае хуткасць бегу і значна зніжае ўжыванне вынослівасці. Няхай вецер вядзе вас да перамогі!"

#. [UA] "Вилочка"
#. [PL] "Kostka życzeń"
#. [RU] "Дужка"
msgctxt "se_wishbone_name"
msgid "Wishbone"
msgstr "Вілка"

#. [UA] "Ви можете відчувати приховане"
#. [PL] "Wykrywasz ukryte przedmioty"
#. [RU] "Теперь вы можете чувствовать скрытые предметы"
msgctxt "se_wishbone_start"
