msgid "Once a creation is done, this barrel of water will bring the metal down to a manageable temperature."
msgstr ""

#. [UA] "Стійка для знаряддя"
#. [PL] "Wieszak na narzędzia"
#. [RU] "Стойка для инструментов"
msgctxt "piece_forge_ext6"
