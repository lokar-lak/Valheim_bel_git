msgid "A large anvil for working large items. Make sure it doesn't fall on your feet."
msgstr ""

#. [UA] "Діжка для охолодження"
#. [PL] "Chłodnica"
#. [RU] "Кузнечный охладитель"
msgctxt "piece_forge_ext5"
msgid "Forge Cooler"
msgstr "Астуджальная кадзь"

#. [UA] "По завершенню виготовлення ця діжа з водою охолодить метал до
#. прийнятної температури."
#. [PL] "Gdy skończysz tworzyć, ta beczka wody obniży temperaturę metalu do
#. znośnej."
