msgctxt "se_trinketironhealth_description"
msgid "Increased armour and a quick burst of health regeneration."
msgstr "Павялічвае абароненасць і выклікае рэзкі прыплыў здароўя."

#. [UA] "Браслет на ногу"
#. [PL] "Zwinna Obręcz"
#. [RU] "Ножной браслет"
