msgid "Iron Cooking Station"
msgstr "Жалезны пожаг"

#. [UA] "Міцне приладдя для запікання м’яса з великих істот."
#. [PL] "Jest wytrzymałe i ma dość mięsa, aby ugotować mięso z większych
#. stworzeń."
#. [RU] "Прочная конструкция, на которой можно готовить мясо даже крупных
#. существ."
msgctxt "piece_cookingstation_iron_description"
msgid "Sturdy, with room to cook meat from larger creatures."
msgstr ""

