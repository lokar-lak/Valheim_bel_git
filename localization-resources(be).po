msgstr "Чорнамармуровыя сходы ўправа"

#. [UA] "Можна використовувати як для ходи вгору, так і вниз. Дуже зручно!"
#. [PL] "Można wchodzić nimi na górę i schodzić w dół. Jakże wygodnie!"
#. [RU] "По ним можно подниматься и спускаться. Удобно!"
msgctxt "piece_blackmarble_stair_description"
msgid "Can be used for going both up and down. How convenient!"
msgstr ""

#. [UA] "Чорномармуровий стіл"
#. [PL] "Czarny marmurowy stół"
#. [RU] "Стол из черного мрамора"
msgctxt "piece_blackmarble_table"
msgid "Black Marble Table"
msgstr "Чорнамармуровы стол"

#. [UA] "Обідайте за цим столом, як тії дворфи!"
#. [PL] "Stołuj się niczym krasnolud!"
#. [RU] "Пируйте за этим столом, как настоящий дверг!"
msgctxt "piece_blackmarble_table_description"
msgid "Dine like a dwarf at this table!"
msgstr ""

#. [UA] "Чорномармуровий трон"
#. [PL] "Czarny marmurowy tron"
#. [RU] "Трон из черного мрамора"
msgctxt "piece_blackmarble_throne"
msgid "Black Marble Throne"
msgstr "Чорнамармуровы сталец"

#. [UA] "Трон виготовлено в автентичному дворфському стилі, однак він
#. достатньо великий, щоби людям було зручно сидіти."
#. [PL] "Tron wykuty w autentycznym stylu Dvergrów, lecz dość duży, aby mógł
#. na nim wygodnie zasiąść człowiek."
#. [RU] "Трон, вырезанный в аутентичном стиле двергов, но при этом достаточно
#. большой, чтобы человеку было удобно сидеть на нем."
msgctxt "piece_blackmarble_throne_description"
msgid "A throne carved in authentic dvergr style, yet large enough for a human to sit comfortably upon."
msgstr ""

#. [UA] "Чорномармурова підлогова панель, мала"
#. [PL] "Czarna marmurowa płyta podłogowa, mała"
#. [RU] "Малая напольная плитка из черного мрамора"
msgctxt "piece_blackmarble_tile_floor_1x1"
msgid "Black Marble Floor Tile Small"
msgstr "Малая чорнамармуровая падлогавая плітка"

#. [UA] "Чорномармурова підлогова панель, велика"
#. [PL] "Czarna marmurowa płyta podłogowa, duża"
#. [RU] "Большая напольная плитка из черного мрамора"
msgctxt "piece_blackmarble_tile_floor_2x2"
msgid "Black Marble Floor Tile Large"
msgstr "Вялікая чорнамармуровая падлогавая плітка"

#. [UA] "Чорномармурова стінова панель, мала"
#. [PL] "Czarna marmurowa płyta naścienna, mała"
#. [RU] "Малая настенная плитка из черного мрамора"
msgctxt "piece_blackmarble_tile_wall_1x1"
msgid "Black Marble Wall Tile Small"
msgstr "Малая чорнамармуровая насценная плітка"

#. [UA] "Чорномармурова стінова панель, велика"
#. [PL] "Czarna marmurowa płyta naścienna, duża"
#. [RU] "Большая настенная плитка из черного мрамора"
msgctxt "piece_blackmarble_tile_wall_2x2"
msgid "Black Marble Wall Tile Large"
msgstr "Вялікая чорнамармуровая насценная плітка"

#. [UA] "Чорномармурова стінова панель, висока"
#. [PL] "Czarna marmurowa płyta naścienna, wysoka"
#. [RU] "Высокая настенная плитка из черного мрамора"
msgctxt "piece_blackmarble_tile_wall_2x4"
msgid "Black Marble Wall Tile Tall"
msgstr "Высокая чорнамармуровая насценная плітка"

#. [UA] "Чорномармуровий четвертинний шпиль"
#. [PL] "Czarna marmurowa ćwierć iglica"
#. [RU] "Четверть шпиля из черного мрамора"
msgctxt "piece_blackmarble_tip"
msgid "Black Marble Quarter Spire"
msgstr "Чатырохгранны чорнамармуровы спічак"

#. [UA] "Шматок чорного мармуру, натхненний дворфською архітектурою. Вас
#. обмежує лише власна творча уява."
#. [PL] "Czarny marmur inspirowany krasnoludzką architekturą. Jedyną granicą
#. jest twoja własna kreatywność."
#. [RU] "Элемент из черного мрамора, вдохновленный архитектурой двергов.
#. Единственный предел — ваша фантазия."
msgctxt "piece_blackmarbleblock_description"
msgid "A black marble piece inspired by dwarven architecture. The only limit is your own creativity."
msgstr ""

#. [UA] "Стос чорного металу"
#. [PL] "Stos czarnego metalu"
#. [RU] "Стопка черного металла"
#| msgctxt "item_blackmetalscrap"
#| msgid "Black Metal Scrap"
msgctxt "piece_blackmetalbarstack"
msgid "Black Metal Stack"
msgstr ""

#. [UA] "Усі фулінґи беззаперечно заздритимуть!"
#. [PL] "Przedmiot zazdrości wszystkich Fulingów!"
#. [RU] "Любой фулинг обзавидуется!"
msgctxt "piece_blackmetalbarstack_description"
msgid "Sure to be the envy of all fulings!"
msgstr ""

#. [UA] "Лава з попелистої деревини"
#. [PL] "Ławka ze zgliszczaka"
#. [RU] "Скамья из пепельной древесины"
msgctxt "piece_blackwoodbench01"
msgid "Ashwood Bench"
msgstr "Лаўка з попельнай драўніны"

#. [UA] "Насолодіться довгими розмовами, опираючись на елегантний вигин цієї
#. лави."
#. [PL] "Elegancka krzywizna tej ławki ułatwia konwersację."
#. [RU] "Эта скамья изогнута так, чтобы собеседникам было удобно общаться."
msgctxt "piece_blackwoodbench01_description"
msgid "This bench has an elegant curve to it, to facilitate conversation."
msgstr ""

#. [UA] "Стос попелистої деревини"
#. [PL] "Sterta zgliszczaka"
#. [RU] "Стопка пепельной древесины"
msgctxt "piece_blackwoodstack"
msgid "Ashwood Stack"
msgstr "Штабель попельнай драўніны"

#. [UA] "Байдуже, що відбувається навколо, цей стос деревини завше
#. відчувається теплим."
#. [PL] "Ta sterta drewna w każdych okolicznościach wydaje się ciepła."
#. [RU] "Эта стопка древесины всегда кажется теплой."
msgctxt "piece_blackwoodstack_description"
msgid "No matter what, this stack of wood always feels warm."
msgstr ""

#. [UA] "Домна"
#. [PL] "Piec hutniczy"
#. [RU] "Доменная печь"
msgctxt "piece_blastfurnace"
msgid "Blast Furnace"
msgstr "Домна"

#. [UA] "Деяким металам для плавлення потрібна вища температура."
#. [PL] "Niektóre metale potrzebują wyższej temperatury, by się stopiły."
#. [RU] "Некоторые металлы плавятся при более высоких температурах."
msgctxt "piece_blastfurnace_description"
msgid "Some metals need higher temperatures to melt."
msgstr ""

#. [UA] "Стос кровозлота"
#. [PL] "Stos krwawego złota"
#. [RU] "Стопка кровавого золота"
#| msgctxt "piece_woodstack"
#| msgid "Wood Stack"
msgctxt "piece_bloodgoldbarstack"
msgid "Bloodgold Stack"
msgstr ""

#. [UA] "Від цього металу тхне чимось зловісним, не як від інших, чи не так?"
#. [PL] "Ten metal spowija bardziej złowróżbna atmosfera niż inne, czyż nie?"
#. [RU] "У этого металла особенно зловещая аура, правда?"
msgctxt "piece_bloodgoldbarstack_description"
msgid "This metal does have a more sinister air than others, doesn't it?"
msgstr ""

#. [UA] "Кістяний трон"
#. [PL] "Kościany tron"
#. [RU] "Костяной трон"
msgctxt "piece_bone_throne"
msgid "Bone Throne"
msgstr "Касцяны сталец"

#. [UA] "Цей трон безсумнівно викликатиме повагу від ворогів та друзів."
#. [PL] "Ten tron z pewnością wzbudzi szacunek zarówno przyjaciół, jak i
#. wrogów."
#. [RU] "Этот трон несомненно внушит уважение как друзьям, так и врагам."
msgctxt "piece_bone_throne_description"
msgid "This throne is sure to invoke respect in friends and foes alike."
msgstr ""

#. [UA] "Стос кісток"
#. [PL] "Sterta kości"
#. [RU] "Груда костей"
msgctxt "piece_bonestack"
msgid "Bone Stack"
msgstr "Стос костак"

#. [UA] "Ніколи не знаєш, коли це може стати в пригоді!"
#. [PL] "Nigdy nie wiesz, kiedy się przydadzą!"
#. [RU] "Никогда не знаешь, когда они могут пригодиться!"
msgctxt "piece_bonestack_description"
msgid "You never know when these might come in handy!"
msgstr ""

#. [UA] "Ватра"
#. [PL] "Wielkie Ognisko"
#. [RU] "Большой костер"
msgctxt "piece_bonfire"
msgid "Bonfire"
msgstr "Вогнішча"

#. [UA] "Коли звичайне багаття недостатньо ефектне!"
#. [PL] "Kiedy zwykłe ognisko jest za mało imponujące!"
#. [RU] "Когда обычный костер недостаточно впечатляет!"
msgctxt "piece_bonfire_description"
msgid "For when a regular campfire just isn't impressive enough!"
msgstr ""

#. [UA] "Підвісна жаровня"
#. [PL] "Wisząca pochodnia"
#. [RU] "Подвесной мангал"
msgctxt "piece_brazierceiling01"
msgid "Hanging Brazier"
msgstr "Падвесная жарніца"

#. [UA] "Якщо вогнище звисає зі стелі, то неможливо на нього випадково
#. наступити."
#. [PL] "Jeśli umieścisz ogień pod sufitem, to na pewno się o niego nie
#. potkniesz."
#. [RU] "Если огонь висит под потолком, на него невозможно случайно
#. наткнуться."
msgctxt "piece_brazierceiling01_description"
msgid "If your fire hangs from the ceiling, you can't accidentally stumble into it."
msgstr ""

#. [UA] "Жаровня-стійка"
#. [PL] "Koksownik"
#. [RU] "Жаровня"
msgctxt "piece_brazierfloor01"
msgid "Standing Brazier"
msgstr "Стаячая жарніца"

#. [UA] "Класичний спосіб освітлення приміщення."
#. [PL] "Klasyczny sposób na rozświetlenie pomieszczenia."
#. [RU] "Стильный способ осветить помещение."
msgctxt "piece_brazierfloor01_description"
msgid "A classy way to light up the room."
msgstr ""

#. [UA] "Блакитнополум’яна жаровня-стійка"
#. [PL] "Niebieski koksownik"
#. [RU] "Жаровня с синим пламенем"
msgctxt "piece_brazierfloor02"
msgid "Blue Standing Brazier"
msgstr "Блакітная стаячая жарніца"

#. [UA] "Складно визначити: це полум’я опікає неймовірним жаром чи холодом."
#. [PL] "Trudno powiedzieć, czy ten płomień wydziela niesamowite ciepło, czy
#. też niesamowite zimno."
#. [RU] "Трудно понять, это пламя горит невероятно горячо или невероятно
#. холодно."
msgctxt "piece_brazierfloor02_description"
msgid "It's hard to tell whether this flame burns incredibly hot or incredibly cold."
msgstr ""

#. [UA] "Стос бронзи"
#. [PL] "Stos brązu"
#. [RU] "Стопка бронзы"
#| msgctxt "piece_bonestack"
#| msgid "Bone Stack"
msgctxt "piece_bronzebarstack"
msgid "Bronze Stack"
msgstr ""

#. [UA] "Гарна, універсальна… а тепер ще й можна в стоси складати!"
#. [PL] "Przepiękny, uniwersalny... A teraz do tego w kształcie stosu!"
#. [RU] "Красивый и универсальный металл... И теперь складывается в стопки!"
msgctxt "piece_bronzebarstack_description"
msgid "Beautiful, versatile... Now also stackable!"
msgstr ""

#. [UA] "Свічка з живиці"
#. [PL] "Świeca żywiczna"
#. [RU] "Смоляная свеча"
msgctxt "piece_candle"
msgid "Resin Candle"
msgstr "Жывічная свечка"

#. [UA] "Маленьке, але дуже затишне джерело світла."
#. [PL] "Małe, lecz niezwykle przytulne źródło światła."
#. [RU] "Небольшой, но очень уютный источник света."
msgctxt "piece_candle_description"
msgid "A small but incredibly cosy lightsource."
msgstr ""

#. [UA] "Стіл мапознавця"
#. [PL] "Stół kartograficzny"
#. [RU] "Стол картографа"
msgctxt "piece_cartographytable"
msgid "Cartography Table"
msgstr "Стол картографа"

#. [UA] "Позначайте свої відкриття на мапі та розповідайте про них друзям."
#. [PL] "Zaznacz swoje odkrycia na tej mapie i podziel się nimi z
#. przyjaciółmi."
#. [RU] "Отмечайте свои открытия на этой карте и делитесь ими с друзьями."
msgctxt "piece_cartographytable_description"
msgid "Mark your discoveries on this map and share them with your friends."
msgstr ""

#. [UA] "Опустити опори"
#. [PL] "Opuść nogi"
#. [RU] "Опустить опоры"
msgctxt "piece_catapult_legsdown"
msgid "Lower legs"
msgstr "Апусціць ножкі"

#. [UA] "Підняти опори"
#. [PL] "Unieś nogi"
#. [RU] "Поднять опоры"
msgctxt "piece_catapult_legsup"
msgid "Raise legs"
msgstr "Узняць ножкі"

#. [UA] "Розмістити"
#. [PL] "Połóż przedmiot"
#. [RU] "Поместить предмет"
msgctxt "piece_catapult_placeitem"
msgid "Place item"
msgstr "Пакласці прадмет"

#. [UA] "Це не підійде для катапульти."
#. [PL] "To nie pasuje do katapulty"
#. [RU] "Не помещается в катапульту"
msgctxt "piece_catapult_wontfit"
msgid "That doesn't fit in the catapult"
msgstr "Гэта ў катапульту не змесціцца"

#. [UA] "Казан"
#. [PL] "Kociołek"
#. [RU] "Котел"
msgctxt "piece_cauldron"
msgid "Cauldron"
msgstr "Кацёл"

#. [UA] "Поєднуйте інгредієнти й готуйте смачні страви — це важливо для всіх
#. вікінгів!"
#. [PL] "Połącz składniki i przygotuj sobie pyszny posiłek. To ważne dla
#. każdego wikinga!"
#. [RU] "Смешайте ингредиенты и приготовьте вкусную еду — это важно для любого
#. викинга!"
msgctxt "piece_cauldron_description"
msgid "Combine ingredients and cook yourself a tasty meal, important for all vikings!"
msgstr ""

#. [UA] "Полиця для спецій"
#. [PL] "Wieszak do przypraw"
#. [RU] "Сушилка для трав"
msgctxt "piece_cauldron_ext1_spice"
msgid "Spice Rack"
msgstr "Сушылка для траў"

#. [UA] "Для різноманітної та смачної поживної дієти потрібно чимало
#. інгредієнтів."
#. [PL] "Potrzebujesz wielu składników, by zachować zróżnicowaną i smakowitą
#. dietę."
#. [RU] "Для разнообразного и вкусного рациона нужно много ингредиентов."
msgctxt "piece_cauldron_ext1_spice_description"
msgid "You need many ingredients for a varied and delicious diet."
msgstr ""

#. [UA] "Стіл м’ясаря"
#. [PL] "Stół rzeźnika"
#. [RU] "Мясницкий стол"
msgctxt "piece_cauldron_ext3_butchertable"
msgid "Butcher's Table"
msgstr "Стол мясніка"

#. [UA] "Найліпші страви потребують найліпших шматочків."
#. [PL] "Najlepsze dania wymagają najlepszych sztuk mięsa."
#. [RU] "Для идеальных блюд нужны самые лучшие куски мяса."
#| msgctxt "item_helmet_odin_description"
#| msgid "Odin's finest warriors deserve the finest cloth."
msgctxt "piece_cauldron_ext3_butchertable_description"
msgid "The finest dishes require the finest cuts."
msgstr ""

#. [UA] "Каструлі та пательні"
#. [PL] "Garnki i patelnie"
#. [RU] "Кухонная утварь"
msgctxt "piece_cauldron_ext4_pans"
msgid "Pots and Pans"
msgstr "Кухонны посуд"

#. [UA] "Іноді трапляється так, що казан просто не підходить."
#. [PL] "Czasami sam kociołek po prostu nie wystarcza."
#. [RU] "Иногда одного котла просто недостаточно."
msgctxt "piece_cauldron_ext4_pans_description"
msgid "Sometimes just a cauldron simply isn't enough."
msgstr ""

#. [UA] "Ступка й товкач"
#. [PL] "Moździerz"
#. [RU] "Ступка и пестик"
msgctxt "piece_cauldron_ext5_mortarandpestle"
msgid "Mortar and Pestle"
msgstr "Ступка і таўкач"

#. [UA] "Деякі інгредієнти потрібно перетерти на порошок, а вже потім
#. використовувати для кухарства."
#. [PL] "Niektóre składniki trzeba zmielić na drobny proszek, zanim będzie
#. można je wykorzystać do gotowania."
#. [RU] "Некоторые ингредиенты нужно измельчить в порошок перед готовкой."
msgctxt "piece_cauldron_ext5_mortarandpestle_description"
msgid "Some ingredients need to be ground into a fine powder before they can be used for cooking."
msgstr ""

#. [UA] "Скалки та дошки для нарізки"
#. [PL] "Wałki i deski do krojenia"
#. [RU] "Скалки и разделочные доски"
msgctxt "piece_cauldron_ext6_rollingpins"
msgid "Rolling Pins and Cutting Boards"
msgstr "Качалкі і апрацоўчыя дошкі"

#. [UA] "Завжди стане в пригоді, особливо для випікання."
#. [PL] "Zawsze się przydają, szczególnie podczas pieczenia."
#. [RU] "Им всегда можно найти применение, особенно для выпечки."
msgctxt "piece_cauldron_ext6_rollingpins_description"
msgid "These always come in handy, particularly for baking."
msgstr ""

#. [UA] "Коптильня"
#. [PL] "Wędzarka"
#. [RU] "Коптильня"
#| msgctxt "se_smoked_name"
#| msgid "Smoked"
msgctxt "piece_cauldron_ext7_smoker"
msgid "Smoker"
msgstr ""

#. [UA] "Копчена їжа довше зберігає свіжість і смак!"
#. [PL] "Wędzone jedzenie dłużej wytrzymuje i lepiej smakuje!"
#. [RU] "Копченая еда вкуснее и хранится дольше!"
msgctxt "piece_cauldron_ext7_smoker_description"
msgid "Smoked food will keep longer and taste better!"
msgstr ""

#. [UA] "Квіткова гірлянда"
#. [PL] "Kwiecista girlanda"
#. [RU] "Цветочная гирлянда"
msgctxt "piece_celebrationgarland"
msgid "Flower Garland"
msgstr "Кветачная гірлянда"

#. [UA] "Трішки квіточок для поліпшення настрою!"
#. [PL] "Kwiaty, które rozjaśnią ponury dzień!"
#. [RU] "Немного цветов, чтобы украсить ваш день!"
#| msgctxt "tutorial_weight_topic"
#| msgid "You need to lighten your load!"
msgctxt "piece_celebrationgarland_description"
msgid "Some flowers to brighten up your day!"
msgstr ""

#. [UA] "Стілець"
#. [PL] "Krzesło"
#. [RU] "Кресло"
msgctxt "piece_chair"
msgid "Wood Chair"
msgstr "Драўлянае крэсла"

#. [UA] "Розслабтеся й відпочиньте."
#. [PL] "Oprzyj się i zrelaksuj."
#. [RU] "Присядьте и расслабьтесь."
#| msgctxt "item_boarjerky_description"
#| msgid "Lean and salty."
msgctxt "piece_chair_description"
msgid "Lean back and relax."
msgstr ""

#. [UA] "Різьблений стілець"
#. [PL] "Rzeźbione krzesło"
#. [RU] "Резной стул"
#| msgctxt "piece_darkwoodchair"
#| msgid "Darkwood Chair"
msgctxt "piece_chair_runed"
msgid "Carved Chair"
msgstr ""

#. [UA] "Цей стілець може й простої форми, але оздоблення дуже непросте."
#. [PL] "Kształt tego krzesła może i jest prosty, lecz jego zdobienia wcale
#. takie nie są."
#. [RU] "Форма этого стула может и проста, но его украшения весьма искусны."
msgctxt "piece_chair_runed_description"
msgid "The shape of this chair might be simple, but its decorations are not."
msgstr ""

#. [UA] "Вуглевипалювальна піч"
#. [PL] "Mielerz"
#. [RU] "Углевыжигательная печь"
msgctxt "piece_charcoalkiln"
msgid "Charcoal Kiln"
msgstr "Вуглепальная печ"

#. [UA] "Використовується для перетворення будь-якої деревини на вугілля."
#. [PL] "Przydaje się do zamiany wszelkiego rodzaju drewna w węgiel."
#. [RU] "Позволяет превратить любую древесину в уголь."
