msgid "Useful for turning any kind of wood into coal."
msgstr ""

#. [UA] "Скуґґ"
#. [PL] "Skugg"
#. [RU] "Скугг"
msgctxt "piece_charredballista"
msgid "Skugg"
msgstr "Скуг"

#. [UA] "Обвуглена скриня"
#. [PL] "Zwęglona skrzynia"
#. [RU] "Обгорелый сундук"
msgctxt "piece_charredchest"
msgid "Charred Chest"
msgstr "Абвуглены куфар"

#. [UA] "Зміцнена скриня"
#. [PL] "Wzmocniona skrzynia"
#. [RU] "Армированный сундук"
msgctxt "piece_chest"
msgid "Reinforced Chest"
msgstr "Умацаваны куфар"

#. [UA] "Посилена скриня зі збільшеним об’ємом для всякої всячини."
#. [PL] "Bardziej wytrzymała skrzynia, w której jest więcej miejsca."
#. [RU] "Более прочный сундук с еще большим пространством для хранения."
msgctxt "piece_chest_description"
msgid "A sturdier chest, with room for more storage."
msgstr ""

#. [UA] "Діжка"
#. [PL] "Beczka"
#. [RU] "Бочка"
msgctxt "piece_chestbarrel"
msgid "Barrel"
msgstr "Бочка"

#. [UA] "Діжка непогано підійде для зберігання чого-небудь (включно з їжею та
#. напоями)."
#. [PL] "Beczka nadaje się do przechowywania wielu rzeczy, w tym jedzenia i
#. picia."
#. [RU] "Бочка отлично подходит для хранения множества вещей, включая еду и
#. напитки."
msgctxt "piece_chestbarrel_description"
msgid "A barrel is good for storing lots of things, including food and drink."
msgstr ""

#. [UA] "Чорнометалева скриня"
#. [PL] "Skrzynia z czarnego metalu"
#. [RU] "Сундук из черного металла"
msgctxt "piece_chestblackmetal"
msgid "Black Metal Chest"
msgstr "Куфар з чорнага металу"

#. [UA] "Міцні чорнометалеві смуги тримають скриню купи й дозволяють покласти
#. всередину майже що завгодно."
#. [PL] "Wytrzymały czarny metal spajający tę skrzynię umożliwi ci włożenie do
#. środka niemal wszystkiego."
#. [RU] "Прочный черный металл, из которого выполнен этот сундук, позволяет
#. хранить внутри почти все что угодно."
msgctxt "piece_chestblackmetal_description"
msgid "The sturdy black metal that holds this chest together lets you put almost anything inside."
msgstr ""

#. [UA] "Сірокам’яна скриня"
#. [PL] "Skrzynia z graustenu"
#. [RU] "Сундук из граустена"
#| msgctxt "piece_graustenpile"
#| msgid "Grausten Pile"
msgctxt "piece_chestgrausten"
msgid "Grausten Chest"
msgstr ""

#. [UA] "Камінь та метал безумовно збережуть ваші речі. Обвуглені черепи теж
#. допоможуть в цьому."
#. [PL] "Kamień i metal zapewnią bezpieczeństwo twojemu dobytkowi. Zwęglone
#. czaszki na pewno też w tym pomogą."
#. [RU] "Камень и металл надежно сохранят ваши вещи. Обугленные черепа тоже
#. пригодятся."
msgctxt "piece_chestgrausten_description"
msgid "Stone and metal are sure to keep your belongings safe. The charred skulls help too."
msgstr ""

#. [UA] "Особиста скриня"
#. [PL] "Osobista skrzynia"
#. [RU] "Личный сундук"
msgctxt "piece_chestprivate"
msgid "Personal Chest"
msgstr "Асабісты куфар"

#. [UA] "Дещо завжди ліпше замкнути на всі замки й зберегти для себе."
#. [PL] "Niektóre rzeczy lepiej schować i zatrzymać dla siebie."
#. [RU] "Некоторые вещи лучше хранить под замком, чтобы они никому не
#. достались."
msgctxt "piece_chestprivate_description"
msgid "Some things you would rather lock away and keep for yourself."
msgstr ""

#. [UA] "Скарбниця"
#. [PL] "Skrzynia skarbów"
#. [RU] "Сундук с сокровищами"
msgctxt "piece_chesttreasure"
msgid "Treasure Chest"
msgstr "Куфар з скарбам"

#. [UA] "Чи є ліпший спосіб показати свої статки, аніж скриня, з якої
#. сиплеться золото й коштовності?"
#. [PL] "Jak lepiej pochwalić się swoim bogactwem niż dzięki skrzyni skarbów,
#. z której wysypuje się złoto i klejnoty?"
#. [RU] "Что может лучше продемонстрировать ваше богатство, чем сундук, до
#. верха набитый золотом и драгоценностями?"
msgctxt "piece_chesttreasure_description"
msgid "What better way to display your wealth than a treasure chest spilling over with gold and jewels?"
msgstr ""

#. [UA] "Гардероб"
#. [PL] "Garderoba"
#. [RU] "Шкаф"
#| msgctxt "piece_guardstone"
#| msgid "Ward"
msgctxt "piece_chestwarderobe"
msgid "Wardrobe"
msgstr ""

#. [UA] "Елегантний простір для зберігання."
#. [PL] "Eleganckie miejsce do przechowywania."
#. [RU] "Элегантное место для хранения."
msgctxt "piece_chestwarderobe_description"
msgid "An elegant place for storage."
msgstr ""

#. [UA] "Скриня"
#. [PL] "Skrzynia"
#. [RU] "Сундук"
msgctxt "piece_chestwood"
msgid "Chest"
msgstr "Куфар"

#. [UA] "Прекрасне місце для зберігання будь-чого, що не потрібно тягати з
#. собою."
#. [PL] "Dobre miejsce do przechowywania wszelkich przedmiotów, których nie
#. musisz nosić przy sobie."
#. [RU] "Отличное место для хранения вещей, которые не нужно носить с собой."
msgctxt "piece_chestwood_description"
msgid "A good place to store any items you don't need to carry with you."
msgstr ""

#. [UA] "Червона джутова фіранка"
#. [PL] "Zasłona z czerwonej juty"
#. [RU] "Штора из красного джута"
msgctxt "piece_clothdoor"
msgid "Red Jute Curtain"
msgstr "Заслона з чырвонага джуту"

#. [UA] "Важкі завіси з червоного джуту, ідеально закривають все."
#. [PL] "Ciężkie zasłony z czerwonej juty. Idealne do drapowania."
#. [RU] "Портьера из красного джута. Отличный элемент декора."
msgctxt "piece_clothdoor_description"
msgid "Heavy curtains of red jute, excellent for draping."
msgstr ""

#. [UA] "Груда вугілля"
#. [PL] "Stos węgla"
#. [RU] "Груда угля"
msgctxt "piece_coalpile"
msgid "Coal Pile"
msgstr "Груда вугалю"

#. [UA] "Мати вдосталь палива ніколи не буде зайвим."
#. [PL] "Dobrze jest mieć pod ręką sporo paliwa."
#. [RU] "Запас топлива никогда не помешает."
msgctxt "piece_coalpile_description"
msgid "It never hurts to have a lot of fuel on hand."
msgstr ""

#. [UA] "порожньо"
#. [PL] "PUSTY"
#. [RU] "ПУСТО"
